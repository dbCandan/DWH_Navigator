# .env olarak kopyalayın (repoya girmez). docker compose bu dosyayı okur.
# Yönetim ekranı (/admin) parolası: uzun ve rastgele olsun.
VSA_ADMIN_PASSWORD=
# Uygulama klasörü (varsayılan ./data). Geliştirme makinesinde yerel data/ ile karışmasın diye
# ayrı bir klasör verilebilir, ör. VSA_DATA_DIR=./docker-data
# VSA_DATA_DIR=./data
