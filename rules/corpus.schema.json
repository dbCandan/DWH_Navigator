{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "corpus.schema.json",
  "title": "Ajan kuralı ön bilgi alanları",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "scope",
    "priority",
    "trigger",
    "applies_to",
    "gate"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9]{2}-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 8,
      "maxLength": 120,
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "scope": {
      "type": "string",
      "enum": [
        "governance",
        "process",
        "backend",
        "frontend",
        "schema",
        "deployment",
        "quality",
        "desktop"
      ]
    },
    "authority": {
      "type": "string",
      "enum": ["mandatory", "recommended", "project-owned"],
      "default": "recommended"
    },
    "priority": {
      "type": "integer",
      "minimum": 0,
      "maximum": 999
    },
    "trigger": {
      "type": "string",
      "enum": ["always", "path-match", "on-demand"]
    },
    "applies_to": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
      },
      "uniqueItems": true
    },
    "gate": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[A-Za-z0-9_./* -]+$"
    },
    "application_modes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "enum": ["separated-web", "desktop"]}
    }
  }
}
