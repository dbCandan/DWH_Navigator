ARG FRONTEND_NODE_BASE_IMAGE=node:22.23.2-alpine3.23@sha256:46825fbbd4e996a78b7a2cdc08d75e38a5a505bdab95dcda55605359bf124bc6

# Compose always supplies the `npm_cache` named context. Connected mode ignores its content;
# offline mode points it at the verified bundle cache.

FROM ${FRONTEND_NODE_BASE_IMAGE}
ARG DEPENDENCY_MODE=connected
ENV NPM_CONFIG_AUDIT=false \
    NPM_CONFIG_FUND=false \
    NPM_CONFIG_UPDATE_NOTIFIER=false
WORKDIR /app
RUN chown node:node /app
USER node
COPY --chown=node:node package.json package-lock.json ./
RUN --mount=type=bind,from=npm_cache,source=/,target=/opt/npm-cache \
    --mount=type=secret,id=npmrc,target=/tmp/npmrc,mode=0444,required=false \
    set -eu; \
    case "${DEPENDENCY_MODE}" in \
        connected) NPM_CONFIG_USERCONFIG=/tmp/npmrc npm ci --ignore-scripts ;; \
        offline) NPM_CONFIG_USERCONFIG=/dev/null npm ci --offline --ignore-scripts \
            --cache /opt/npm-cache --logs-dir=/tmp/npm-logs ;; \
        *) echo "DEPENDENCY_MODE must be connected or offline" >&2; exit 64 ;; \
    esac
COPY --chown=node:node . .
EXPOSE 3000
CMD ["npm", "run", "dev", "--", "--port", "3000"]
