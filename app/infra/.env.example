# scripts/stack.sh supplies JWT_PRIVATE_KEY, POSTGRES_PASSWORD and REDIS_PASSWORD from the disposable
# secrets that scripts/dev-secrets.sh keeps in the Git-ignored .data/ directory. Set one here only
# to replace the generated value; PostgreSQL applies its password when the data volume is created.
# A second checkout of this project on the same machine sets its own Compose project name and free
# ports here; see README.md. The name defaults to the product short name.
# COMPOSE_PROJECT_NAME=dwhnavigator-2
APP_HTTP_PORT=8080
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-local-secret
DEPENDENCY_MODE=connected
# Connected mode uses bank-managed mirrors. Offline mode points these contexts at the verified bundle.
PYTHON_WHEELHOUSE_CONTEXT=../frontend
NPM_CACHE_CONTEXT=../frontend
# Every image/base may be replaced by the same digest promoted to the internal registry.
PYTHON_BASE_IMAGE=python:3.14-alpine3.23@sha256:218761489de417a6eb0808e264cbdd7043ec6659fe5a61898815e9848536541d
FRONTEND_NODE_BASE_IMAGE=node:22.23.2-alpine3.23@sha256:46825fbbd4e996a78b7a2cdc08d75e38a5a505bdab95dcda55605359bf124bc6
POSTGRES_IMAGE=postgres:17.10@sha256:7958605b474b3d264a969cb3a123d6aa00ad1e1fe9da8a69984dabb704d93317
REDIS_IMAGE=redis:7-alpine@sha256:e7723ff73d963f5cc6d9c4643ea3d989527a402a319239054e9472a7fb9219a2
NGINX_IMAGE=nginx:1.31.6-alpine-slim@sha256:f761b94f2cb9e8e05e2943d5f773609596113ef69b54e2433a996d109a8f78b7
OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.158.0@sha256:c5918f78992ee73b0d6f0e599423ac5ec52dd5d9726733114d6eca53d5a32ed5
TEMPO_IMAGE=grafana/tempo:2.9.4@sha256:3ecdaa1af90b3068e77e4fb4b11d9f26201c3a57d5740d34965a323173a4f1aa
PROMETHEUS_IMAGE=prom/prometheus:v3.13.2@sha256:508729e0e2d18e11fd742a5a5ca70e557b940a93948c3c95fd0123a6fd538b69
LOKI_IMAGE=grafana/loki:3.7.6@sha256:efd47c67f9bac88ca29bcf8cb997d9ab29d1848bd0aff579282295542a745952
GRAFANA_IMAGE=grafana/grafana:13.1.2@sha256:d177053ab62253815f130d81504f77063baf5fd4ca93299d6048453bd31e047a
