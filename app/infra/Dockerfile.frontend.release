ARG FRONTEND_NODE_BASE_IMAGE=registry.internal.invalid/platform/node:22.23.2-alpine3.23@sha256:46825fbbd4e996a78b7a2cdc08d75e38a5a505bdab95dcda55605359bf124bc6
ARG NGINX_BASE_IMAGE=registry.internal.invalid/platform/nginx:1.31.6-alpine-slim@sha256:f761b94f2cb9e8e05e2943d5f773609596113ef69b54e2433a996d109a8f78b7
FROM scratch AS npm_cache
FROM scratch AS alpine_packages
FROM ${FRONTEND_NODE_BASE_IMAGE} AS build
ARG DEPENDENCY_MODE=offline
ENV NPM_CONFIG_AUDIT=false \
    NPM_CONFIG_FUND=false \
    NPM_CONFIG_UPDATE_NOTIFIER=false
WORKDIR /src
RUN chown node:node /src
USER node
COPY --chown=node:node app/frontend/package.json app/frontend/package-lock.json ./
RUN --mount=type=bind,from=npm_cache,source=/,target=/opt/npm-cache \
    --mount=type=secret,id=npmrc,target=/tmp/npmrc,mode=0444,required=false \
    set -eu; \
    case "${DEPENDENCY_MODE}" in \
        connected) NPM_CONFIG_USERCONFIG=/tmp/npmrc npm ci --ignore-scripts ;; \
        offline) NPM_CONFIG_USERCONFIG=/dev/null npm ci --offline --ignore-scripts \
            --cache /opt/npm-cache --logs-dir=/tmp/npm-logs ;; \
        *) echo "DEPENDENCY_MODE must be connected or offline" >&2; exit 64 ;; \
    esac
COPY --chown=node:node app/frontend/ ./
RUN npm run build

FROM ${NGINX_BASE_IMAGE}
ARG DEPENDENCY_MODE=offline
ARG ALPINE_PACKAGE_SOURCE=https://dl-cdn.alpinelinux.org/alpine/v3.24/main
ARG TARGETARCH
# Install the locked Alpine security fixes that the pinned nginx base does not carry yet. Each
# package is an exact version with a reviewed SHA-256; apk verifies its signature and never
# consults a repository, so the build cannot pick up an unreviewed package.
RUN --mount=type=bind,source=app/infra/locks/nginx-alpine-packages.lock,target=/tmp/nginx-alpine-packages.lock \
    --mount=type=bind,from=alpine_packages,source=/,target=/opt/alpine-packages \
    set -eu; \
    set --; \
    while read -r docker_arch alpine_arch package_spec expected_sha256; do \
        case "$docker_arch" in ""|\#*) continue ;; esac; \
        [ "$docker_arch" = "$TARGETARCH" ] || continue; \
        [ "$alpine_arch" = "$(apk --print-arch)" ]; \
        package_file="${package_spec%%=*}-${package_spec#*=}.apk"; \
        case "${DEPENDENCY_MODE}" in \
            connected) wget -q "${ALPINE_PACKAGE_SOURCE}/${alpine_arch}/${package_file}" \
                -O "/tmp/${package_file}" ;; \
            offline) cp "/opt/alpine-packages/${alpine_arch}/${package_file}" \
                "/tmp/${package_file}" ;; \
            *) echo "DEPENDENCY_MODE must be connected or offline" >&2; exit 64 ;; \
        esac; \
        echo "${expected_sha256}  /tmp/${package_file}" | sha256sum -c -; \
        set -- "$@" "/tmp/${package_file}"; \
    done < /tmp/nginx-alpine-packages.lock; \
    [ "$#" -gt 0 ]; \
    apk add --no-cache --no-network --repositories-file /dev/null "$@"; \
    rm -f "$@"
COPY app/frontend/nginx.release.conf /etc/nginx/conf.d/default.conf
COPY app/frontend/nginx.security-headers.conf /etc/nginx/conf.d/security-headers.conf
COPY --from=build /src/dist /usr/share/nginx/html
USER 101:101
EXPOSE 8080
ENTRYPOINT []
CMD ["nginx", "-g", "daemon off;"]
