ARG PYTHON_BASE_IMAGE=registry.internal.invalid/platform/python:3.14-alpine3.23@sha256:218761489de417a6eb0808e264cbdd7043ec6659fe5a61898815e9848536541d
FROM scratch AS python_wheelhouse
FROM ${PYTHON_BASE_IMAGE}

ARG APP_GID=10001
ARG APP_UID=10001
ARG DEPENDENCY_MODE=offline

ENV HOME=/tmp \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/workspace/app/backend \
    PYTHONUNBUFFERED=1 \
    PYTHONUTF8=1

RUN addgroup -g "${APP_GID}" app \
    && adduser -D -H -u "${APP_UID}" -G app app

# Organization root CA of the internal model server (data-dictionary/PRDs/003-llm-connection,
# Dağıtım etkisi): added to the system trust store; nonprod also names this file in
# DWHNAVIGATOR_LLM_CA_BUNDLE (helm/dwhnavigator/values-project.yaml).
COPY app/backend/certs/corporate-inference-root.crt /usr/local/share/ca-certificates/corporate-inference-root.crt
RUN chmod 0644 /usr/local/share/ca-certificates/corporate-inference-root.crt \
    && update-ca-certificates >/dev/null 2>&1

WORKDIR /workspace/app/backend
COPY app/backend/requirements.txt /tmp/dependencies/requirements.txt
RUN --mount=type=bind,from=python_wheelhouse,source=/,target=/opt/wheelhouse \
    --mount=type=secret,id=pip_conf,target=/etc/pip.conf,required=false \
    set -eu; \
    case "${DEPENDENCY_MODE}" in \
        connected) python -m pip install --no-cache-dir -r /tmp/dependencies/requirements.txt ;; \
        offline) PIP_CONFIG_FILE=/dev/null PIP_NO_INDEX=1 python -m pip install \
            --no-cache-dir --no-index --find-links=/opt/wheelhouse \
            -r /tmp/dependencies/requirements.txt ;; \
        *) echo "DEPENDENCY_MODE must be connected or offline" >&2; exit 64 ;; \
    esac; \
    rm -rf /tmp/dependencies

COPY --chown=${APP_UID}:${APP_GID} app/backend/app ./app
COPY --chown=${APP_UID}:${APP_GID} app/backend/alembic.ini ./alembic.ini
COPY --chown=${APP_UID}:${APP_GID} schema /workspace/schema

USER ${APP_UID}:${APP_GID}
EXPOSE 8000
# --timeout-graceful-shutdown: on SIGTERM uvicorn waits for open responses before the application's
# own shutdown runs; an open analysis event stream would hold it until the pod is killed. After 3 s
# the streams are cancelled and the application ends its jobs and lists as interrupted
# (data-dictionary/PRDs/004-question-analysis Requirement 12) within the 30 s pod grace.
ENTRYPOINT ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--no-server-header", "--no-access-log", "--timeout-graceful-shutdown", "3"]
