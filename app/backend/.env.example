# dwhnavigator backend development settings. Copy to .env; never commit .env.
# "development" is the local environment; every other value behaves as nonprod.
DWHNAVIGATOR_ENVIRONMENT=development
DWHNAVIGATOR_DEBUG=true
DWHNAVIGATOR_LOG_LEVEL=INFO
DWHNAVIGATOR_PROJECT_NAME=dwhnavigator

DWHNAVIGATOR_API_PREFIX=/api/dwhnavigator/v1
DWHNAVIGATOR_TENANT_HEADER=x-tenant-id
DWHNAVIGATOR_CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:8080
# Exact browser origin of the application; a state-changing request from any other Origin is
# refused, and session refresh and logout require this Origin.
DWHNAVIGATOR_PUBLIC_ORIGIN=http://localhost:8080
# Ingress controller addresses or networks whose X-Forwarded-For header is trusted for the
# failed-login limits; empty trusts no proxy header.
DWHNAVIGATOR_TRUSTED_PROXY_CIDRS=

# Required. Point it at a PostgreSQL you can reach from this machine and replace the placeholder
# password; this file is Git-ignored once copied to .env.
DWHNAVIGATOR_DATABASE_URL=postgresql+asyncpg://app:replace-with-a-local-password@localhost:5432/dwhnavigator_db

# DWHNAVIGATOR_JWT_PRIVATE_KEY holds the PEM signing key and never enters this file. For a host run,
# export the disposable local key from the project root:
#   export DWHNAVIGATOR_JWT_PRIVATE_KEY="$(sh scripts/dev-secrets.sh jwt-private-key)"
# Deployed environments receive their own key only through backend.existingSecret, which the
# project's helm deploy hook prepares in the cluster.
DWHNAVIGATOR_JWT_ALGORITHM=ES256
DWHNAVIGATOR_JWT_ISSUER=dwhnavigator
DWHNAVIGATOR_JWT_AUDIENCE=dwhnavigator-api
DWHNAVIGATOR_ACCESS_TOKEN_EXPIRE_MINUTES=15
DWHNAVIGATOR_REFRESH_SESSION_IDLE_MINUTES=60
DWHNAVIGATOR_REFRESH_SESSION_ABSOLUTE_HOURS=8
# Hours the one-time password of a newly opened or reset account stays valid (1-168).
DWHNAVIGATOR_ONE_TIME_PASSWORD_TTL_HOURS=72

# DWHNAVIGATOR_SETTINGS_ENCRYPTION_KEY is a secret: standard base64 of 32 random bytes that encrypts
# the settings the application stores in PostgreSQL. Locally the factory's local secret generation
# provides it; until then write it once into the Git-ignored app/infra/.env. In nonprod the
# deployment hook generates it once into the runtime Secret. Never write it into this file.

# OpenTelemetry traces and metrics over OTLP/gRPC. Empty disables export; the observability Compose
# overlay sets the collector address for the Compose backend. Outside the development environment
# the address must be https. OTEL_* process variables stop startup.
DWHNAVIGATOR_OTEL_EXPORTER_OTLP_ENDPOINT=
DWHNAVIGATOR_OTEL_SERVICE_NAME=dwhnavigator-backend
DWHNAVIGATOR_OTEL_TRACES_SAMPLE_RATIO=1.0
DWHNAVIGATOR_OTEL_METRIC_EXPORT_INTERVAL_SECONDS=60

# Super admin (application-foundation/PRDs/001-user-accounts Requirement 17 and 18). The command
# python -m app.scripts.create_super_admin creates or resets it and reads the password only from
# its prompt or --password-stdin. DWHNAVIGATOR_BOOTSTRAP_SUPER_ADMIN_PASSWORD is the start-up
# password: when the backend process receives it (in nonprod through the runtime Secret), the start
# creates the account once and never changes an existing one. Either password works once; the
# account sets its own password at its first login. Never add a password to this file or version
# control.
DWHNAVIGATOR_BOOTSTRAP_SUPER_ADMIN_EMAIL=admin@example.invalid
DWHNAVIGATOR_BOOTSTRAP_SUPER_ADMIN_USERNAME=super-admin
