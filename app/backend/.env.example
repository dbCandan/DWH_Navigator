# dwhnavigator backend development settings. Copy to .env; never commit .env.
DWHNAVIGATOR_ENVIRONMENT=development
DWHNAVIGATOR_DEBUG=true
DWHNAVIGATOR_LOG_LEVEL=INFO
DWHNAVIGATOR_PROJECT_NAME=dwhnavigator

DWHNAVIGATOR_API_PREFIX=/api/dwhnavigator/v1
DWHNAVIGATOR_TENANT_HEADER=x-tenant-id
DWHNAVIGATOR_CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:8080

# Required. Point it at a PostgreSQL you can reach from this machine and replace the placeholder
# password; this file is Git-ignored once copied to .env.
DWHNAVIGATOR_DATABASE_URL=postgresql+asyncpg://app:replace-with-a-local-password@localhost:5432/dwhnavigator_db

# DWHNAVIGATOR_JWT_PRIVATE_KEY holds the PEM signing key and never enters this file. For a host run,
# export the disposable local key from the project root:
#   export DWHNAVIGATOR_JWT_PRIVATE_KEY="$(sh scripts/dev-secrets.sh jwt-private-key)"
# Deployed environments receive their own key only through backend.existingSecret, which the
# project's helm deploy hook prepares in the cluster.
DWHNAVIGATOR_JWT_ALGORITHM=ES256
DWHNAVIGATOR_JWT_ISSUER=dwhnavigator
DWHNAVIGATOR_JWT_AUDIENCE=dwhnavigator-api
DWHNAVIGATOR_ACCESS_TOKEN_EXPIRE_MINUTES=60

DWHNAVIGATOR_BOOTSTRAP_SUPER_ADMIN_EMAIL=admin@example.invalid
DWHNAVIGATOR_BOOTSTRAP_SUPER_ADMIN_USERNAME=super-admin
# Supply DWHNAVIGATOR_BOOTSTRAP_SUPER_ADMIN_PASSWORD only in the command process environment.
# Do not add the password to this file or version control.
