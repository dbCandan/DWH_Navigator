{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kt:agent-platform:agent-contract:1.0",
  "title": "Satıcıdan Bağımsız Ajan Sözleşmesi",
  "description": "Taşınabilir ajan niyeti. Yetki, harici politika ve kabul ile çözümlenir.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "metadata",
    "mission",
    "invocation",
    "interfaces",
    "requirements",
    "permissions",
    "delegation",
    "runtime",
    "data",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "kind": {
      "const": "AgentContract"
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "mission": {
      "$ref": "#/$defs/mission"
    },
    "invocation": {
      "$ref": "#/$defs/invocation"
    },
    "interfaces": {
      "$ref": "#/$defs/interfaces"
    },
    "requirements": {
      "$ref": "#/$defs/requirements"
    },
    "permissions": {
      "$ref": "#/$defs/permissions"
    },
    "delegation": {
      "$ref": "#/$defs/delegation"
    },
    "runtime": {
      "$ref": "#/$defs/runtime"
    },
    "data": {
      "$ref": "#/$defs/data"
    },
    "evidence": {
      "$ref": "#/$defs/evidence"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "runtime": {
            "properties": {
              "workspace_access": {
                "const": "read-only"
              }
            },
            "required": [
              "workspace_access"
            ]
          }
        },
        "required": [
          "runtime"
        ]
      },
      "then": {
        "properties": {
          "requirements": {
            "properties": {
              "tools": {
                "not": {
                  "contains": {
                    "properties": {
                      "access": {
                        "enum": [
                          "write",
                          "destructive"
                        ]
                      }
                    },
                    "required": [
                      "access"
                    ]
                  }
                }
              },
              "mcp": {
                "not": {
                  "contains": {
                    "properties": {
                      "tools": {
                        "contains": {
                          "properties": {
                            "access": {
                              "enum": [
                                "write",
                                "destructive"
                              ]
                            }
                          },
                          "required": [
                            "access"
                          ]
                        }
                      }
                    },
                    "required": [
                      "tools"
                    ]
                  }
                }
              }
            }
          },
          "permissions": {
            "properties": {
              "workspace": {
                "properties": {
                  "write": {
                    "maxItems": 0
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "requirements": {
            "anyOf": [
              {
                "properties": {
                  "tools": {
                    "contains": {
                      "properties": {
                        "access": {
                          "enum": [
                            "write",
                            "destructive",
                            "external-side-effect"
                          ]
                        }
                      },
                      "required": [
                        "access"
                      ]
                    }
                  }
                }
              },
              {
                "properties": {
                  "mcp": {
                    "contains": {
                      "properties": {
                        "tools": {
                          "contains": {
                            "properties": {
                              "access": {
                                "enum": [
                                  "write",
                                  "destructive",
                                  "external-side-effect"
                                ]
                              }
                            },
                            "required": [
                              "access"
                            ]
                          }
                        }
                      },
                      "required": [
                        "tools"
                      ]
                    }
                  }
                }
              }
            ]
          }
        },
        "required": [
          "requirements"
        ]
      },
      "then": {
        "properties": {
          "evidence": {
            "properties": {
              "approval_policy": {
                "properties": {
                  "minimum_approvers": {
                    "minimum": 1
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "permissions": {
            "properties": {
              "external_side_effects": {
                "const": "prohibited"
              }
            },
            "required": [
              "external_side_effects"
            ]
          }
        },
        "required": [
          "permissions"
        ]
      },
      "then": {
        "properties": {
          "requirements": {
            "properties": {
              "tools": {
                "not": {
                  "contains": {
                    "properties": {
                      "access": {
                        "const": "external-side-effect"
                      }
                    },
                    "required": [
                      "access"
                    ]
                  }
                }
              },
              "mcp": {
                "not": {
                  "contains": {
                    "properties": {
                      "tools": {
                        "contains": {
                          "properties": {
                            "access": {
                              "const": "external-side-effect"
                            }
                          },
                          "required": [
                            "access"
                          ]
                        }
                      }
                    },
                    "required": [
                      "tools"
                    ]
                  }
                }
              }
            }
          },
          "runtime": {
            "properties": {
              "budgets": {
                "properties": {
                  "max_external_side_effects": {
                    "const": 0
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "metadata": {
            "properties": {
              "risk_tier": {
                "const": "R0"
              }
            },
            "required": [
              "risk_tier"
            ]
          }
        },
        "required": [
          "metadata"
        ]
      },
      "then": {
        "properties": {
          "requirements": {
            "properties": {
              "tools": {
                "not": {
                  "contains": {
                    "properties": {
                      "access": {
                        "enum": [
                          "write",
                          "destructive",
                          "external-side-effect"
                        ]
                      }
                    },
                    "required": [
                      "access"
                    ]
                  }
                }
              },
              "mcp": {
                "not": {
                  "contains": {
                    "properties": {
                      "tools": {
                        "contains": {
                          "properties": {
                            "access": {
                              "enum": [
                                "write",
                                "destructive",
                                "external-side-effect"
                              ]
                            }
                          },
                          "required": [
                            "access"
                          ]
                        }
                      }
                    },
                    "required": [
                      "tools"
                    ]
                  }
                }
              }
            }
          },
          "permissions": {
            "properties": {
              "workspace": {
                "properties": {
                  "write": {
                    "maxItems": 0
                  }
                }
              },
              "network": {
                "properties": {
                  "mode": {
                    "const": "denied"
                  }
                }
              },
              "secrets": {
                "properties": {
                  "mode": {
                    "const": "none"
                  }
                }
              },
              "external_side_effects": {
                "const": "prohibited"
              }
            }
          },
          "delegation": {
            "properties": {
              "allowed": {
                "const": false
              }
            }
          },
          "runtime": {
            "properties": {
              "workspace_access": {
                "const": "read-only"
              }
            }
          },
          "data": {
            "properties": {
              "max_classification": {
                "const": "public"
              }
            }
          },
          "evidence": {
            "properties": {
              "approval_policy": {
                "properties": {
                  "minimum_approvers": {
                    "const": 0
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "metadata": {
            "properties": {
              "risk_tier": {
                "const": "R2"
              }
            },
            "required": [
              "risk_tier"
            ]
          }
        },
        "required": [
          "metadata"
        ]
      },
      "then": {
        "properties": {
          "evidence": {
            "properties": {
              "approval_policy": {
                "properties": {
                  "minimum_approvers": {
                    "minimum": 1
                  }
                }
              },
              "minimum_tier": {
                "enum": [
                  "L2",
                  "L3"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "metadata": {
            "properties": {
              "risk_tier": {
                "const": "R3"
              }
            },
            "required": [
              "risk_tier"
            ]
          }
        },
        "required": [
          "metadata"
        ]
      },
      "then": {
        "properties": {
          "evidence": {
            "properties": {
              "approval_policy": {
                "properties": {
                  "minimum_approvers": {
                    "minimum": 2
                  },
                  "separation_of_duties": {
                    "const": true
                  }
                }
              },
              "minimum_tier": {
                "const": "L3"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "evidence": {
            "properties": {
              "human_approval_for": {
                "minItems": 1
              }
            },
            "required": [
              "human_approval_for"
            ]
          }
        },
        "required": [
          "evidence"
        ]
      },
      "then": {
        "properties": {
          "evidence": {
            "properties": {
              "approval_policy": {
                "properties": {
                  "minimum_approvers": {
                    "minimum": 1
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "agentId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    },
    "singleLine": {
      "type": "string",
      "minLength": 3,
      "maxLength": 500,
      "pattern": "^(?!.*[\\r\\n]).*\\S.*$"
    },
    "relativeDocument": {
      "type": "string",
      "minLength": 3,
      "maxLength": 256,
      "pattern": "^(?![A-Za-z]:/)(?!/)(?!\\./)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*//)(?!\\s)(?=.*\\S$)[a-zA-Z0-9._/-]+\\.md$"
    },
    "relativeGlob": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?![A-Za-z]:/)(?!/)(?!\\./)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*//)(?!\\s)(?=.*\\S$).+$"
    },
    "ownerRef": {
      "type": "string",
      "pattern": "^(?:team|person):[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "ruleRef": {
      "type": "string",
      "pattern": "^rule:[0-9]{2}-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "policyRef": {
      "type": "string",
      "pattern": "^policy:[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "skillRef": {
      "type": "string",
      "pattern": "^skill:[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "commandRef": {
      "type": "string",
      "pattern": "^command:[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "toolRef": {
      "type": "string",
      "pattern": "^tool:[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "mcpRef": {
      "type": "string",
      "pattern": "^mcp:[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "agentRef": {
      "type": "string",
      "pattern": "^agent:[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "inferenceProfileRef": {
      "type": "string",
      "pattern": "^inference-profile:[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "evalRef": {
      "type": "string",
      "pattern": "^eval:[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "egressRef": {
      "type": "string",
      "pattern": "^egress:[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "secretRef": {
      "type": "string",
      "pattern": "^secret:[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "schemaRef": {
      "type": "string",
      "pattern": "^schema:[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "approvalPolicyRef": {
      "type": "string",
      "pattern": "^approval-policy:[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "display_name",
        "description",
        "owner",
        "lifecycle",
        "risk_tier"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/agentId"
        },
        "version": {
          "$ref": "#/$defs/semver"
        },
        "display_name": {
          "type": "string",
          "minLength": 3,
          "maxLength": 80,
          "pattern": "^(?!.*[\\r\\n]).*\\S.*$"
        },
        "description": {
          "type": "string",
          "minLength": 20,
          "maxLength": 500,
          "pattern": "^(?!.*[\\r\\n]).*\\S.*$"
        },
        "owner": {
          "$ref": "#/$defs/ownerRef"
        },
        "lifecycle": {
          "enum": [
            "draft",
            "active",
            "deprecated",
            "retired"
          ]
        },
        "risk_tier": {
          "enum": [
            "R0",
            "R1",
            "R2",
            "R3"
          ]
        }
      }
    },
    "mission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instructions_ref",
        "objective",
        "responsibilities",
        "non_responsibilities"
      ],
      "properties": {
        "instructions_ref": {
          "$ref": "#/$defs/relativeDocument"
        },
        "objective": {
          "type": "string",
          "minLength": 20,
          "maxLength": 1000,
          "pattern": "^(?!\\s)(?=[\\s\\S]*\\S$)[\\s\\S]+$"
        },
        "responsibilities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/singleLine"
          }
        },
        "non_responsibilities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/singleLine"
          }
        }
      }
    },
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modes"
      ],
      "properties": {
        "modes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "explicit",
              "implicit",
              "delegated"
            ]
          }
        }
      }
    },
    "interface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description",
        "required",
        "classification",
        "contract"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/agentId"
        },
        "description": {
          "$ref": "#/$defs/singleLine"
        },
        "required": {
          "type": "boolean"
        },
        "classification": {
          "enum": [
            "public",
            "internal",
            "confidential",
            "restricted"
          ]
        },
        "contract": {
          "$ref": "#/$defs/schemaRef"
        }
      }
    },
    "interfaces": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputs",
        "outputs"
      ],
      "properties": {
        "inputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/interface"
          }
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/interface"
          }
        }
      }
    },
    "ruleRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "required"
      ],
      "properties": {
        "ref": {
          "$ref": "#/$defs/ruleRef"
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "policyRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "required"
      ],
      "properties": {
        "ref": {
          "$ref": "#/$defs/policyRef"
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "skillRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "required"
      ],
      "properties": {
        "ref": {
          "$ref": "#/$defs/skillRef"
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "commandRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "required"
      ],
      "properties": {
        "ref": {
          "$ref": "#/$defs/commandRef"
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "toolRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability",
        "required",
        "access",
        "approval"
      ],
      "properties": {
        "capability": {
          "$ref": "#/$defs/toolRef"
        },
        "required": {
          "type": "boolean"
        },
        "access": {
          "enum": [
            "read",
            "write",
            "destructive",
            "external-side-effect"
          ]
        },
        "approval": {
          "enum": [
            "never",
            "on-write",
            "on-external-side-effect",
            "always"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "access": {
                "const": "read"
              }
            },
            "required": [
              "access"
            ]
          },
          "then": {
            "properties": {
              "approval": {
                "enum": [
                  "never",
                  "always"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "access": {
                "const": "write"
              }
            },
            "required": [
              "access"
            ]
          },
          "then": {
            "properties": {
              "approval": {
                "enum": [
                  "on-write",
                  "always"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "access": {
                "const": "destructive"
              }
            },
            "required": [
              "access"
            ]
          },
          "then": {
            "properties": {
              "approval": {
                "const": "always"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "access": {
                "const": "external-side-effect"
              }
            },
            "required": [
              "access"
            ]
          },
          "then": {
            "properties": {
              "approval": {
                "enum": [
                  "on-external-side-effect",
                  "always"
                ]
              }
            }
          }
        }
      ]
    },
    "mcpRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registry_ref",
        "required",
        "tools"
      ],
      "properties": {
        "registry_ref": {
          "$ref": "#/$defs/mcpRef"
        },
        "required": {
          "type": "boolean"
        },
        "tools": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/toolRequirement"
          }
        }
      }
    },
    "hookIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "required"
      ],
      "properties": {
        "id": {
          "enum": [
            "before-tool-policy",
            "after-tool-audit",
            "before-external-side-effect",
            "after-completion-evidence"
          ]
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inference_profile_ref",
        "policies",
        "rules",
        "skills",
        "commands",
        "model_capabilities",
        "tools",
        "mcp",
        "hook_intents"
      ],
      "properties": {
        "inference_profile_ref": {
          "$ref": "#/$defs/inferenceProfileRef"
        },
        "policies": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/policyRequirement"
          }
        },
        "rules": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/ruleRequirement"
          }
        },
        "skills": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/skillRequirement"
          }
        },
        "commands": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/commandRequirement"
          }
        },
        "model_capabilities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "enum": [
              "reasoning",
              "tool-calling",
              "structured-output",
              "vision",
              "long-context",
              "code-execution"
            ]
          }
        },
        "tools": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/toolRequirement"
          }
        },
        "mcp": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/mcpRequirement"
          }
        },
        "hook_intents": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/hookIntent"
          }
        }
      }
    },
    "workspaceScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "read",
        "write",
        "deny"
      ],
      "properties": {
        "read": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/relativeGlob"
          }
        },
        "write": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/relativeGlob"
          }
        },
        "deny": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/relativeGlob"
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "registry_refs"
      ],
      "properties": {
        "mode": {
          "enum": [
            "denied",
            "allowlisted"
          ]
        },
        "registry_refs": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/egressRef"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "denied"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "properties": {
              "registry_refs": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "registry_refs": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "secretPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "registry_refs"
      ],
      "properties": {
        "mode": {
          "enum": [
            "none",
            "task-scoped"
          ]
        },
        "registry_refs": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/secretRef"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "none"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "properties": {
              "registry_refs": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "registry_refs": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspace",
        "network",
        "secrets",
        "external_side_effects"
      ],
      "properties": {
        "workspace": {
          "$ref": "#/$defs/workspaceScope"
        },
        "network": {
          "$ref": "#/$defs/networkPolicy"
        },
        "secrets": {
          "$ref": "#/$defs/secretPolicy"
        },
        "external_side_effects": {
          "enum": [
            "prohibited",
            "approval-required"
          ]
        }
      }
    },
    "delegation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed",
        "max_depth",
        "max_parallel",
        "allowed_agents",
        "context_sharing"
      ],
      "properties": {
        "allowed": {
          "type": "boolean"
        },
        "max_depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "max_parallel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "allowed_agents": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/agentRef"
          }
        },
        "context_sharing": {
          "enum": [
            "minimal",
            "selected"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "allowed": {
                "const": false
              }
            },
            "required": [
              "allowed"
            ]
          },
          "then": {
            "properties": {
              "max_depth": {
                "const": 0
              },
              "max_parallel": {
                "const": 1
              },
              "allowed_agents": {
                "maxItems": 0
              },
              "context_sharing": {
                "const": "minimal"
              }
            }
          },
          "else": {
            "properties": {
              "max_depth": {
                "minimum": 1
              },
              "allowed_agents": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_duration_seconds",
        "max_tool_calls",
        "max_external_side_effects"
      ],
      "properties": {
        "max_duration_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "max_tool_calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "max_external_side_effects": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sandbox_required",
        "workspace_access",
        "identity",
        "budgets"
      ],
      "properties": {
        "sandbox_required": {
          "const": true
        },
        "workspace_access": {
          "enum": [
            "read-only",
            "workspace-write"
          ]
        },
        "identity": {
          "const": "task-scoped"
        },
        "budgets": {
          "$ref": "#/$defs/budgets"
        }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_classification",
        "memory",
        "retention",
        "logging"
      ],
      "properties": {
        "max_classification": {
          "enum": [
            "public",
            "internal",
            "confidential",
            "restricted"
          ]
        },
        "memory": {
          "enum": [
            "forbidden",
            "session-only",
            "approved-service"
          ]
        },
        "retention": {
          "enum": [
            "none",
            "session",
            "time-bound"
          ]
        },
        "logging": {
          "enum": [
            "metadata-only",
            "redacted",
            "full-approved"
          ]
        }
      }
    },
    "approvalPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registry_ref",
        "minimum_approvers",
        "separation_of_duties"
      ],
      "properties": {
        "registry_ref": {
          "$ref": "#/$defs/approvalPolicyRef"
        },
        "minimum_approvers": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "separation_of_duties": {
          "type": "boolean"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eval_suites",
        "minimum_tier",
        "tool_log_required",
        "claims",
        "approval_policy",
        "human_approval_for"
      ],
      "properties": {
        "eval_suites": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/evalRef"
          }
        },
        "minimum_tier": {
          "enum": [
            "L0",
            "L1",
            "L2",
            "L3"
          ]
        },
        "tool_log_required": {
          "type": "boolean"
        },
        "claims": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": [
              "instruction-discovery",
              "policy-compliance",
              "tool-use",
              "side-effect-control",
              "result-quality"
            ]
          }
        },
        "approval_policy": {
          "$ref": "#/$defs/approvalPolicy"
        },
        "human_approval_for": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
            "privileged-write",
            "isolated-code-execution",
            "external-side-effect",
              "destructive-action",
              "regulated-decision"
            ]
          }
        }
      }
    }
  }
}
