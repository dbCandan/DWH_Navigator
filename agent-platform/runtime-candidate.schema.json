{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kt:agent-platform:runtime-candidate:1.0",
  "title": "Ajan Çalışma Zamanı Aday Envanteri",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "captured_at",
    "host",
    "clients"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "kind": {"const": "AgentRuntimeCandidateInventory"},
    "captured_at": {"type": "string", "format": "date-time"},
    "host": {"$ref": "#/$defs/host"},
    "clients": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"$ref": "#/$defs/client"}
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "version", "build", "architecture"],
      "properties": {
        "os": {"const": "macOS"},
        "version": {"type": "string", "minLength": 1},
        "build": {"type": "string", "minLength": 1},
        "architecture": {"const": "arm64"}
      }
    },
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact", "sha256"],
      "properties": {
        "artifact": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "signing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verified", "team_id", "cdhash"],
      "properties": {
        "verified": {"const": true},
        "team_id": {"type": "string", "pattern": "^[A-Z0-9]{10}$"},
        "cdhash": {"type": "string", "pattern": "^[a-f0-9]{40}$"}
      }
    },
    "client": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "release_channel",
        "candidate_state",
        "artifact_locator",
        "digests",
        "conformance",
        "admission",
        "unresolved_runtime_bindings"
      ],
      "properties": {
        "id": {
          "enum": [
            "codex",
            "claude-code",
            "github-copilot-vscode",
            "cursor"
          ]
        },
        "version": {"type": "string", "minLength": 1},
        "release_channel": {"type": "string", "minLength": 1},
        "candidate_state": {
          "enum": ["r0-candidate", "r1-candidate", "inventory-only"]
        },
        "artifact_locator": {
          "type": "string",
          "minLength": 1,
          "not": {"pattern": "^/|^~|Users/|\\\\"}
        },
        "digests": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/digest"}
        },
        "package_integrity": {"type": "string", "minLength": 1},
        "signing": {"$ref": "#/$defs/signing"},
        "related_exploratory_artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "version", "sha256", "reason_not_candidate"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "version": {"type": "string", "minLength": 1},
              "sha256": {"$ref": "#/$defs/sha256"},
              "reason_not_candidate": {"type": "string", "minLength": 1}
            }
          }
        },
        "conformance": {"const": "not_run"},
        "admission": {"const": "research"},
        "unresolved_runtime_bindings": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
