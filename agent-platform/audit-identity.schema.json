{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kt:agent-platform:vibecoder-identity:1.0",
  "title": "Yerel Vibecoder Denetim Kimliği",
  "description": "Yerel istemcinin gözlediği, yalnız denetim korelasyonu için kullanılan en iyi çaba kimliğidir; kimlik doğrulama veya yetkilendirme yetkisi taşımaz.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "client_id",
    "display_name",
    "email",
    "account_id",
    "source"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "kind": {"const": "VibecoderIdentity"},
    "client_id": {"$ref": "#/$defs/clientId"},
    "display_name": {
      "anyOf": [
        {"$ref": "#/$defs/displayName"},
        {"type": "null"}
      ]
    },
    "email": {
      "anyOf": [
        {"$ref": "#/$defs/email"},
        {"type": "null"}
      ]
    },
    "account_id": {
      "anyOf": [
        {"$ref": "#/$defs/accountId"},
        {"type": "null"}
      ]
    },
    "source": {
      "enum": ["client-visible", "os-fallback", "git-fallback", "unavailable"]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"source": {"const": "client-visible"}}},
      "then": {
        "anyOf": [
          {"properties": {"display_name": {"$ref": "#/$defs/displayName"}}},
          {"properties": {"email": {"$ref": "#/$defs/email"}}},
          {"properties": {"account_id": {"$ref": "#/$defs/accountId"}}}
        ]
      }
    },
    {
      "if": {"properties": {"source": {"const": "os-fallback"}}},
      "then": {
        "properties": {
          "display_name": {"$ref": "#/$defs/displayName"},
          "account_id": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"source": {"const": "git-fallback"}}},
      "then": {
        "properties": {
          "display_name": {"type": "null"},
          "email": {"$ref": "#/$defs/email"},
          "account_id": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"source": {"const": "unavailable"}}},
      "then": {
        "properties": {
          "display_name": {"type": "null"},
          "email": {"type": "null"},
          "account_id": {"type": "null"}
        }
      }
    }
  ],
  "$defs": {
    "safeText": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:[^\\u0000-\\u001F\\u007F-\\u009F\\u2028\\u2029\\uD800-\\uDFFF]*\\S)?$"
    },
    "clientId": {
      "allOf": [
        {"$ref": "#/$defs/safeText"},
        {"maxLength": 80}
      ]
    },
    "displayName": {
      "allOf": [
        {"$ref": "#/$defs/safeText"},
        {"maxLength": 200}
      ]
    },
    "email": {
      "type": "string",
      "minLength": 3,
      "maxLength": 320,
      "pattern": "^[^\\s@\\u0000-\\u001F\\u007F-\\u009F\\u2028\\u2029\\uD800-\\uDFFF]+@[^\\s@\\u0000-\\u001F\\u007F-\\u009F\\u2028\\u2029\\uD800-\\uDFFF]+$"
    },
    "accountId": {
      "allOf": [
        {"$ref": "#/$defs/safeText"},
        {"maxLength": 200}
      ]
    }
  }
}
