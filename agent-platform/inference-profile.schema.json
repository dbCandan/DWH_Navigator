{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kt.internal/schemas/inference-profile.schema.json",
  "title": "Inference Profile Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "profiles"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "kind": {"const": "InferenceProfileCatalog"},
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/profile"}
    }
  },
  "$defs": {
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_class",
        "model",
        "model_disposition",
        "effort",
        "effort_disposition",
        "limitation"
      ],
      "properties": {
        "model_class": {"enum": ["smallest-capable", "inherited"]},
        "model": {"type": ["string", "null"], "minLength": 1},
        "model_disposition": {"enum": ["native", "external-control"]},
        "effort": {"enum": ["low", null]},
        "effort_disposition": {"enum": ["native", "external-control"]},
        "limitation": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "purpose", "bindings"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^inference-profile:[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "purpose": {"enum": ["governed-review-specialist", "automated-fix"]},
        "bindings": {
          "type": "object",
          "additionalProperties": false,
          "required": ["claude-code", "codex", "cursor", "github-copilot-vscode"],
          "properties": {
            "claude-code": {"$ref": "#/$defs/binding"},
            "codex": {"$ref": "#/$defs/binding"},
            "cursor": {"$ref": "#/$defs/binding"},
            "github-copilot-vscode": {"$ref": "#/$defs/binding"}
          }
        }
      }
    }
  }
}
