{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kt:agent-platform:conformance-snapshot:1.0",
  "title": "Ajan Platformu Çalışma Zamanı Uygunluk Anlık Görüntüsü",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "captured_at",
    "host",
    "compiler",
    "claim_boundary",
    "dataset",
    "runs"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "kind": {"const": "AgentConformanceSnapshot"},
    "captured_at": {"type": "string", "format": "date-time"},
    "host": {"$ref": "#/$defs/host"},
    "compiler": {"$ref": "#/$defs/compiler"},
    "claim_boundary": {"$ref": "#/$defs/claimBoundary"},
    "dataset": {"$ref": "#/$defs/dataset"},
    "runs": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/run"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "version", "build", "architecture"],
      "properties": {
        "os": {"const": "macOS"},
        "version": {"type": "string", "minLength": 1},
        "build": {"type": "string", "minLength": 1},
        "architecture": {"const": "arm64"}
      }
    },
    "compiler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "lock_sha256"],
      "properties": {
        "id": {"const": "kt-scaffold-agent-projection"},
        "version": {"enum": ["1.0.1", "1.1.0", "1.2.0"]},
        "lock_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "claimBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_tier", "full_suite_status", "runtime_admission", "note"],
      "properties": {
        "evidence_tier": {"const": "L2-smoke"},
        "full_suite_status": {"const": "not_run"},
        "runtime_admission": {"const": "research"},
        "note": {"type": "string", "minLength": 40, "maxLength": 600}
      }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "sha256", "classification"],
      "properties": {
        "id": {"const": "read-only-scope-smoke"},
        "version": {"const": "1.0.0"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "classification": {"const": "synthetic-public"}
      }
    },
    "runtimeArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "sha256", "candidate_scope"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "candidate_scope": {"enum": ["primary", "exploratory"]}
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "id"],
      "properties": {
        "provider": {"type": ["string", "null"], "minLength": 1},
        "id": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "permissionContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sandbox",
        "approval_mode",
        "exposed_tools",
        "mcp_servers",
        "environment_allowlisted"
      ],
      "properties": {
        "sandbox": {"type": "string", "minLength": 1},
        "approval_mode": {"type": "string", "minLength": 1},
        "exposed_tools": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "mcp_servers": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "environment_allowlisted": {"type": "boolean"}
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "observed"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "status": {"enum": ["pass", "fail", "blocked", "not_run"]},
        "observed": {"type": "string", "minLength": 10, "maxLength": 600}
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "workspace_unchanged", "checks"],
      "properties": {
        "status": {"enum": ["partial_pass", "failed", "blocked", "not_run"]},
        "workspace_unchanged": {"type": ["boolean", "null"]},
        "checks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/check"}
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor", "date", "disposition"],
      "properties": {
        "actor": {"const": "automation:local-conformance-harness"},
        "date": {"type": "string", "format": "date"},
        "disposition": {"const": "no-runtime-admission"}
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "client_id",
        "surface",
        "runtime_artifact",
        "adapter_version",
        "agent_id",
        "projection_sha256",
        "model",
        "authentication",
        "command_profile",
        "permission_context",
        "result",
        "skipped_checks",
        "residual_risks",
        "review"
      ],
      "properties": {
        "client_id": {
          "enum": [
            "codex",
            "claude-code",
            "github-copilot-vscode",
            "cursor"
          ]
        },
        "surface": {"type": "string", "minLength": 1},
        "runtime_artifact": {"$ref": "#/$defs/runtimeArtifact"},
        "adapter_version": {"pattern": "^1\\.(?:0\\.[1-9][0-9]*|1\\.0|2\\.0)$"},
        "agent_id": {"const": "requirements-scope"},
        "projection_sha256": {"$ref": "#/$defs/sha256"},
        "model": {"$ref": "#/$defs/model"},
        "authentication": {
          "enum": ["authenticated", "not-authenticated", "not-configured", "not-assessed"]
        },
        "command_profile": {"$ref": "#/$defs/id"},
        "permission_context": {"$ref": "#/$defs/permissionContext"},
        "result": {"$ref": "#/$defs/result"},
        "skipped_checks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 5}
        },
        "residual_risks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 10}
        },
        "review": {"$ref": "#/$defs/review"}
      }
    }
  }
}
