{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "governed-review-reuse-decision.schema.json",
  "title": "GovernedReviewReuseDecision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "action",
    "reason_codes",
    "evaluated_at",
    "current_identity_sha256",
    "baseline_sha256",
    "periodic_full_review_due",
    "native_invocation_occurred"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "kind": {"const": "GovernedReviewReuseDecision"},
    "action": {"enum": ["reuse", "full-review-required", "blocked"]},
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "enum": [
          "REVIEW_REUSE_EXACT_COMPLETE_BASELINE",
          "REVIEW_REUSE_NO_BASELINE",
          "REVIEW_REUSE_BASELINE_INCOMPLETE",
          "REVIEW_REUSE_PERIODIC_FULL_REVIEW_DUE",
          "REVIEW_REUSE_PROJECT_ID_MISMATCH",
          "REVIEW_REUSE_AUTHORITY_UNPINNED",
          "REVIEW_REUSE_AUTHORITY_EXPIRED",
          "REVIEW_REUSE_AUTHORITY_REVOKED",
          "REVIEW_REUSE_AUTHORITY_REFRESH_REQUIRED",
          "REVIEW_REUSE_AUTHORITY_ROLLBACK_DETECTED",
          "REVIEW_REUSE_AUTHORITY_EQUIVOCATION_DETECTED",
          "REVIEW_REUSE_AUTHORITY_UPDATE_REQUIRED",
          "REVIEW_REUSE_LOCAL_MANAGED_DRIFT",
          "REVIEW_REUSE_AUTHORITY_RECEIPT_MISMATCH",
          "REVIEW_REUSE_AUTHORITY_COMPONENT_CHANGED",
          "REVIEW_REUSE_INPUT_SNAPSHOT_CHANGED",
          "REVIEW_REUSE_AGENT_COMPONENT_CHANGED",
          "REVIEW_REUSE_CLIENT_COMPONENT_CHANGED",
          "REVIEW_REUSE_MODEL_COMPONENT_CHANGED",
          "REVIEW_REUSE_DECISION_COMPONENT_CHANGED"
        ]
      }
    },
    "evaluated_at": {"type": "string", "format": "date-time"},
    "current_identity_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "baseline_sha256": {
      "oneOf": [
        {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        {"type": "null"}
      ]
    },
    "periodic_full_review_due": {"type": "boolean"},
    "native_invocation_occurred": {"const": false}
  },
  "allOf": [
    {
      "if": {"properties": {"action": {"const": "reuse"}}},
      "then": {
        "properties": {
          "reason_codes": {
            "const": ["REVIEW_REUSE_EXACT_COMPLETE_BASELINE"]
          },
          "periodic_full_review_due": {"const": false}
        }
      }
    },
    {
      "if": {"properties": {"periodic_full_review_due": {"const": true}}},
      "then": {"properties": {"action": {"const": "full-review-required"}}}
    }
  ]
}
