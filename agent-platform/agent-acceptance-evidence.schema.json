{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kt:agent-platform:agent-corporate-acceptance-evidence:1.1",
  "title": "Ajan Kurumsal Kabul Kanıtı",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "local_discovery_state",
    "acceptance_status",
    "admission_decision",
    "evidence_scope",
    "corporate_acceptance_proof",
    "production_runtime_proof",
    "native_client_execution_enforced",
    "activation_performed",
    "execution_performed",
    "external_policy_intersection_required",
    "client_id",
    "accepted_agent_ids",
    "agent_identities",
    "registry_lock_sha256",
    "native_discovery_tree_sha256",
    "conformance_run_id",
    "conformance_evidence_sha256",
    "conformance_valid_until",
    "admission_id",
    "admission_record_sha256",
    "admission_receipt_sha256",
    "pinset_sha256",
    "signature_key_id",
    "revocation_status_sha256",
    "accepted_at",
    "expires_at"
  ],
  "properties": {
    "schema_version": {"const": "1.1"},
    "kind": {"const": "AgentCorporateAcceptanceEvidence"},
    "local_discovery_state": {"const": "available-unadmitted"},
    "acceptance_status": {"const": "accepted"},
    "admission_decision": {"const": "admitted"},
    "evidence_scope": {"const": "governance-evidence-and-decision-acceptance"},
    "corporate_acceptance_proof": {"const": true},
    "production_runtime_proof": {"const": false},
    "native_client_execution_enforced": {"const": false},
    "activation_performed": {"const": false},
    "execution_performed": {"const": false},
    "external_policy_intersection_required": {"const": true},
    "client_id": {"$ref": "#/$defs/clientId"},
    "accepted_agent_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 14,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/agentId"}
    },
    "agent_identities": {
      "type": "array",
      "minItems": 14,
      "maxItems": 14,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identityBinding"}
    },
    "registry_lock_sha256": {"$ref": "#/$defs/sha256"},
    "native_discovery_tree_sha256": {"$ref": "#/$defs/sha256"},
    "conformance_run_id": {
      "type": "string",
      "pattern": "^conformance:[a-z0-9]+(?:[-.:][a-z0-9]+)*$"
    },
    "conformance_evidence_sha256": {"$ref": "#/$defs/sha256"},
    "conformance_valid_until": {"type": "string", "format": "date-time"},
    "admission_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "admission_record_sha256": {"$ref": "#/$defs/sha256"},
    "admission_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "pinset_sha256": {"$ref": "#/$defs/sha256"},
    "signature_key_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "revocation_status_sha256": {"$ref": "#/$defs/sha256"},
    "accepted_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "clientId": {
      "enum": ["codex", "claude-code", "github-copilot-vscode", "cursor"]
    },
    "agentId": {
      "enum": [
        "acik-kaynak-lisansi",
        "bilgi-guvenligi",
        "devops",
        "dokumantasyon",
        "gereksinim-kapsami",
        "gizlilik-kvkk",
        "gozlemlenebilirlik",
        "kod-inceleme",
        "kod-kalitesi",
        "kurumsal-mimari",
        "otomatik-duzeltme",
        "test-otomasyonu",
        "uygulama-guvenligi",
        "yuk-testi"
      ]
    },
    "identityDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "agent_id",
        "agent_version",
        "client_id",
        "contract_ref",
        "contract_sha256",
        "policy_ref",
        "policy_sha256",
        "projection_ref",
        "projection_sha256",
        "registry_lock_sha256"
      ],
      "properties": {
        "schema_version": {"const": "1.0"},
        "kind": {"const": "AgentIdentityDescriptor"},
        "agent_id": {"$ref": "#/$defs/agentId"},
        "agent_version": {"$ref": "#/$defs/semver"},
        "client_id": {"$ref": "#/$defs/clientId"},
        "contract_ref": {
          "type": "string",
          "pattern": "^agents/[a-z][a-z0-9]*(?:-[a-z0-9]+)*/agent\\.yml$"
        },
        "contract_sha256": {"$ref": "#/$defs/sha256"},
        "policy_ref": {
          "type": "string",
          "pattern": "^agents/[a-z][a-z0-9]*(?:-[a-z0-9]+)*/policy\\.yml$"
        },
        "policy_sha256": {"$ref": "#/$defs/sha256"},
        "projection_ref": {
          "type": "string",
          "pattern": "^\\.(?:claude|codex|cursor|github)/agents/[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?:\\.agent)?\\.(?:md|toml)$"
        },
        "projection_sha256": {"$ref": "#/$defs/sha256"},
        "registry_lock_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "identityBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "agent_identity_sha256"],
      "properties": {
        "identity": {"$ref": "#/$defs/identityDescriptor"},
        "agent_identity_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
