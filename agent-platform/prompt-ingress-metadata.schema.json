{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "prompt-ingress-metadata.schema.json",
  "title": "PromptIngressMetadata",
  "description": "Ortak yönetişim kökündeki kullanıcı istemi kaydının içeriksiz projeksiyonu; gövde içermez. Kaynak bütünlüğü ve session/turn bağı kayıttan yeniden hesaplanır.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "source_receipt_path", "source_receipt_sha256", "prompt_capture_sha256", "project_id", "client_id", "event", "event_id", "occurred_at", "prompt_session_id", "prompt_session_id_source", "prompt_turn_id", "prompt_turn_id_source", "decision", "outcome", "model"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "kind": {"const": "PromptIngressMetadata"},
    "source_receipt_path": {"type": "string", "pattern": "^record:v1:project-(?!0{32}:)[0-9a-f]{32}:prompt-ingress:(?!0{32}$)[0-9a-f]{32}$"},
    "source_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "prompt_capture_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "project_id": {"type": "string", "pattern": "^project-(?!0{32}$)[0-9a-f]{32}$"},
    "client_id": {"enum": ["claude-code", "codex", "cursor", "github-copilot-vscode"]},
    "event": {"enum": ["UserPromptSubmit", "beforeSubmitPrompt"]},
    "event_id": {"type": "string", "pattern": "^event:(?!0{32}$)[0-9a-f]{32}$"},
    "occurred_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "prompt_session_id": {"type": "string", "pattern": "^session:(client\\.[0-9a-f]{64}|local\\.(?!0{32}$)[0-9a-f]{32})$"},
    "prompt_turn_id": {"type": "string", "pattern": "^turn:(client\\.[0-9a-f]{64}|local\\.(?!0{32}$)[0-9a-f]{32})$"},
    "prompt_session_id_source": {"enum": ["client-envelope", "local-generated-client-unavailable"]},
    "prompt_turn_id_source": {"enum": ["client-envelope", "local-generated-client-unavailable"]},
    "decision": {"enum": ["allow", "block"]},
    "outcome": {"enum": ["clean", "matched", "input-invalid", "guard-error"]},
    "model": {"$ref": "#/$defs/observedModel"}
  },
  "allOf": [
    {
      "if": {"properties": {"decision": {"const": "allow"}}},
      "then": {"properties": {"outcome": {"const": "clean"}, "prompt_capture_sha256": {"type": "string"}}},
      "else": {"properties": {"outcome": {"enum": ["matched", "input-invalid", "guard-error"]}}}
    },
    {
      "if": {"properties": {"client_id": {"const": "cursor"}}},
      "then": {"properties": {"event": {"const": "beforeSubmitPrompt"}}},
      "else": {"properties": {"event": {"const": "UserPromptSubmit"}}}
    }
  ],
  "$defs": {
    "observedModel": {
      "type": "object",
      "additionalProperties": false,
      "description": "İstemcinin bu olay için bildirdiği etkin model ve effort. Codex ve Cursor modeli kanca olayında, Claude Code oturum logunda bildirir; VS Code/Copilot bildirmez. Gözlenemeyen değer uydurulmaz.",
      "required": ["source", "id", "effort"],
      "properties": {
        "source": {"enum": ["native-event-observed", "client-log-observed", "unavailable"]},
        "id": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]{0,159}$"},
        "effort": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,39}$"}
      },
      "allOf": [
        {
          "if": {"properties": {"source": {"const": "unavailable"}}, "required": ["source"]},
          "then": {"properties": {"id": {"const": null}, "effort": {"const": null}}},
          "else": {"properties": {"id": {"type": "string"}}}
        }
      ]
    }
  }
}
