{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kt:agent-platform:agent-policy:1.4",
  "title": "Kanonik Yetkin Ajan Politika Paketi",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "metadata", "lineage", "failure_mode", "controls"],
  "properties": {
    "schema_version": {"enum": ["1.3", "1.4"]},
    "kind": {"const": "AgentPolicyPack"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "owner", "lifecycle"],
      "properties": {
        "id": {"$ref": "#/$defs/policyRef"},
        "version": {"$ref": "#/$defs/semver"},
        "owner": {"$ref": "#/$defs/ownerRef"},
        "lifecycle": {"const": "draft"}
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_role",
        "source_artifacts",
        "source_authority",
        "implementation_status",
        "projection_status",
        "runtime_admission",
        "crosswalk_ref"
      ],
      "properties": {
        "source_role": {"$ref": "#/$defs/sourceRoleRef"},
        "source_artifacts": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/sourceArtifact"}
        },
        "source_authority": {"const": "governance-authoritative"},
        "implementation_status": {
          "enum": ["implemented", "partially-implemented", "implementation-pending"]
        },
        "projection_status": {"enum": ["projected", "not-projectable", "blocked"]},
        "runtime_admission": {"const": "not-admitted"},
        "crosswalk_ref": {"const": "governance-crosswalk:desktop-agents-v1"},
        "supplemental_crosswalk_refs": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/crosswalkRef"}
        }
      }
    },
    "failure_mode": {"enum": ["finding", "manual-review"]},
    "controls": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/control"}
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "lineage": {
            "properties": {
              "source_artifacts": {
                "contains": {
                  "properties": {"id": {"pattern": ":detector-pack$"}},
                  "required": ["id"]
                }
              }
            },
            "required": ["source_artifacts"]
          }
        },
        "required": ["lineage"]
      },
      "then": {"properties": {"schema_version": {"const": "1.4"}}},
      "else": {"properties": {"schema_version": {"const": "1.3"}}}
    }
  ],
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "ownerRef": {
      "type": "string",
      "pattern": "^(?:team|person):[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "policyRef": {
      "type": "string",
      "pattern": "^policy:[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "sourceRoleRef": {
      "type": "string",
      "pattern": "^governance-source:desktop-agents/[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "sourceArtifactId": {
      "type": "string",
      "pattern": "^governance-source:[a-z][a-z0-9]*(?:-[a-z0-9]+)*:(?:instructions|policy|aggregation-policy|allowlist|detector-pack)$"
    },
    "sourceArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sha256"],
      "properties": {
        "id": {"$ref": "#/$defs/sourceArtifactId"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "sourceItemRef": {
      "type": "string",
      "pattern": "^governance-source:desktop-agents/[a-z][a-z0-9]*(?:-[a-z0-9]+)*/(?:agent\\.md|policy\\.yaml|aggregation_policy\\.yaml|allowlist\\.yaml|detectors\\.yaml)#[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "crosswalkRef": {
      "type": "string",
      "pattern": "^governance-crosswalk:[a-z0-9][a-z0-9.-]*(?::[a-z0-9][a-z0-9.-]*)*$"
    },
    "detectorRef": {
      "type": "string",
      "pattern": "^detector:[a-z][a-z0-9]*(?:[./-][a-z0-9]+)*$"
    },
    "standardRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["standard_id", "control_id", "version", "mapping_status"],
      "properties": {
        "standard_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9._/-]{1,63}$"},
        "control_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,95}$"},
        "version": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/semver"}
          ]
        },
        "mapping_status": {
          "enum": ["source-stated-unverified", "institutional-policy-binding"]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"mapping_status": {"const": "source-stated-unverified"}},
            "required": ["mapping_status"]
          },
          "then": {"properties": {"version": {"type": "null"}}},
          "else": {
            "properties": {
              "standard_id": {"const": "KT-AGENT-POLICY"},
              "version": {"$ref": "#/$defs/semver"}
            }
          }
        }
      ]
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "statement",
        "enforcement",
        "on_failure",
        "source_refs",
        "detector_refs",
        "standard_refs",
        "source_conflict_refs",
        "implementation_status",
        "projection_status",
        "runtime_admission"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*-[0-9]{3}$"},
        "statement": {
          "type": "string",
          "minLength": 20,
          "maxLength": 500,
          "pattern": "^(?!.*[\\r\\n]).*\\S.*$"
        },
        "enforcement": {
          "enum": [
            "instruction",
            "schema",
            "deterministic-check",
            "deterministic-policy",
            "isolated-runner",
            "human-gate",
            "proposal-only",
            "external-control"
          ]
        },
        "on_failure": {"enum": ["finding", "manual-review"]},
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/sourceItemRef"}
        },
        "detector_refs": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/detectorRef"}
        },
        "standard_refs": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/standardRef"}
        },
        "source_conflict_refs": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^source-conflict:[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          }
        },
        "implementation_status": {
          "enum": [
            "implemented",
            "implementation-pending",
            "calibration-pending",
            "externally-enforced"
          ]
        },
        "projection_status": {"enum": ["projected", "not-projectable", "blocked"]},
        "runtime_admission": {"const": "not-admitted"}
      }
    }
  }
}
