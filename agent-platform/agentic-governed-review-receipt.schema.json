{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kt:agent-platform:agentic-governed-review-receipt:1.0",
  "title": "Faz 1 Agentic Governed Review Makbuzu",
  "description": "Tam Git indeks adayına bağlı, sürümlü karar kanıtı taşıyan, değiştirilebilir ve kanonik karar yetkisi olmayan Faz 1 Agentic inceleme kaydı. `receipt_sha256` kendi alanı hariç sıralı, küçültülmüş UTF-8 ve tek LF sonlu yük üzerinden hesaplanır.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "evidence_profile",
    "receipt_id",
    "project_id",
    "run_id",
    "trace_id",
    "authority",
    "snapshot",
    "orchestration",
    "aggregation_policy",
    "agentic_evaluator",
    "mandatory_governed_execution",
    "execution",
    "agent_results",
    "acceptance_criteria",
    "reuse_identity_canonicalization",
    "reuse_identity_sha256",
    "decision_evidence",
    "decision",
    "reason_codes",
    "weighted_risk_score_basis_points",
    "compliance_score_basis_points",
    "report_directory",
    "decision_path",
    "decision_sha256",
    "audit_path",
    "audit_event_count",
    "receipt_canonicalization",
    "receipt_sha256",
    "same_snapshot_retry_only",
    "native_surface",
    "claim_boundary",
    "data_handling",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "kind": {"const": "AgenticGovernedReviewReceipt"},
    "evidence_profile": {"const": "phase1-agentic-advisory"},
    "receipt_id": {"$ref": "#/$defs/correlationId"},
    "project_id": {"$ref": "#/$defs/projectId"},
    "run_id": {"$ref": "#/$defs/runId"},
    "trace_id": {"$ref": "#/$defs/traceId"},
    "authority": {"$ref": "#/$defs/authorityBinding"},
    "snapshot": {"$ref": "#/$defs/snapshot"},
    "orchestration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "version", "sha256", "required_agents", "separate_invocations_observed"],
      "properties": {
        "ref": {"const": "orchestration:governed-review"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "required_agents": {"$ref": "#/$defs/requiredAgents"},
        "separate_invocations_observed": {"const": true}
      }
    },
    "aggregation_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "version",
        "sha256",
        "instructions_ref",
        "instructions_sha256",
        "weights",
        "thresholds",
        "calibration_status",
        "runtime_admission"
      ],
      "properties": {
        "ref": {"const": "policy:governed-review-aggregation"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "instructions_ref": {
          "const": "policies/aggregation/governed-review-instructions.md"
        },
        "instructions_sha256": {"$ref": "#/$defs/sha256"},
        "weights": {"$ref": "#/$defs/weights"},
        "thresholds": {"$ref": "#/$defs/thresholds"},
        "calibration_status": {"const": "uncalibrated"},
        "runtime_admission": {"const": "not-admitted"}
      }
    },
    "agentic_evaluator": {"$ref": "#/$defs/agenticEvaluatorBinding"},
    "mandatory_governed_execution": {
      "$ref": "#/$defs/mandatoryGovernedExecutionBinding"
    },
    "execution": {"$ref": "#/$defs/executionBinding"},
    "agent_results": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {"$ref": "#/$defs/agentResult"},
      "allOf": [
        {"contains": {"properties": {"agent_id": {"const": "agent:gereksinim-kapsami"}}, "required": ["agent_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"agent_id": {"const": "agent:kurumsal-mimari"}}, "required": ["agent_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"agent_id": {"const": "agent:kod-kalitesi"}}, "required": ["agent_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"agent_id": {"const": "agent:kod-inceleme"}}, "required": ["agent_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"agent_id": {"const": "agent:bilgi-guvenligi"}}, "required": ["agent_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"agent_id": {"const": "agent:uygulama-guvenligi"}}, "required": ["agent_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"agent_id": {"const": "agent:acik-kaynak-lisansi"}}, "required": ["agent_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"agent_id": {"const": "agent:gizlilik-kvkk"}}, "required": ["agent_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"agent_id": {"const": "agent:test-otomasyonu"}}, "required": ["agent_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"agent_id": {"const": "agent:dokumantasyon"}}, "required": ["agent_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"agent_id": {"const": "agent:devops"}}, "required": ["agent_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"agent_id": {"const": "agent:gozlemlenebilirlik"}}, "required": ["agent_id"]}, "minContains": 1, "maxContains": 1}
      ]
    },
    "acceptance_criteria": {"$ref": "#/$defs/acceptanceCriteria"},
    "reuse_identity_canonicalization": {"const": "kt-agentic-review-reuse-json-v3"},
    "reuse_identity_sha256": {"$ref": "#/$defs/sha256"},
    "decision_evidence": {
      "$ref": "urn:kt:agent-platform:agentic-governed-review-decision-evidence:1.1"
    },
    "decision": {"enum": ["PASS", "FAIL", "HARD-FAIL", "BLOCKED_INCOMPLETE"]},
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"}
    },
    "weighted_risk_score_basis_points": {"type": "integer", "minimum": 0, "maximum": 10000},
    "compliance_score_basis_points": {"type": "integer", "minimum": 0, "maximum": 10000},
    "report_directory": {"$ref": "#/$defs/reportDirectory"},
    "decision_path": {"$ref": "#/$defs/decisionPath"},
    "decision_sha256": {"$ref": "#/$defs/sha256"},
    "audit_path": {"$ref": "#/$defs/auditPath"},
    "audit_event_count": {"const": 14},
    "receipt_canonicalization": {"const": "kt-agentic-governed-review-receipt-json-v1"},
    "receipt_sha256": {"$ref": "#/$defs/sha256"},
    "same_snapshot_retry_only": {"const": true},
    "native_surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "client_id",
        "adapter_mode",
        "hook_error_behavior",
        "timeout_behavior",
        "enforcement_claim",
        "native_result_recorded",
        "commit_retry_recorded"
      ],
      "properties": {
        "client_id": {"enum": ["claude-code", "codex", "cursor", "github-copilot-vscode"]},
        "adapter_mode": {"enum": ["native-command-receipt-guard", "native-agent-pilot", "native-prompt-pilot", "manual-advisory"]},
        "hook_error_behavior": {"enum": ["fail-open", "fail-closed", "unknown"]},
        "timeout_behavior": {"enum": ["fail-open", "fail-closed", "unknown"]},
        "enforcement_claim": {"enum": ["conditional-native-guard", "advisory-only", "unsupported"]},
        "native_result_recorded": {"const": false},
        "commit_retry_recorded": {"const": false}
      }
    },
    "claim_boundary": {"$ref": "#/$defs/claimBoundary"},
    "data_handling": {"$ref": "#/$defs/dataHandling"},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"decision": {"const": "PASS"}}, "required": ["decision"]},
      "then": {
        "properties": {
          "agent_results": {
            "items": {"properties": {"status": {"const": "ok"}}, "required": ["status"]}
          },
          "execution": {
            "properties": {
              "client": {
                "properties": {
                  "source": {"enum": ["native-event-observed", "agent-self-observed"]}
                },
                "required": ["source"]
              }
            },
            "required": ["client"]
          },
          "decision_evidence": {
            "properties": {
              "audit_replay": {
                "properties": {
                  "status": {"const": "verified"},
                  "second_pass_validator": {
                    "properties": {
                      "result": {"const": "verified"},
                      "matches_primary_evaluation": {"const": true}
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {"enum": ["FAIL", "HARD-FAIL"]}
        },
        "required": ["decision"]
      },
      "then": {
        "properties": {
          "decision_evidence": {
            "properties": {
              "audit_replay": {
                "properties": {
                  "status": {"const": "verified"},
                  "second_pass_validator": {
                    "properties": {
                      "result": {"const": "verified"},
                      "matches_primary_evaluation": {"const": true}
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision_evidence": {
            "properties": {
              "audit_replay": {
                "properties": {"status": {"enum": ["mismatch", "unavailable"]}},
                "required": ["status"]
              }
            },
            "required": ["audit_replay"]
          }
        },
        "required": ["decision_evidence"]
      },
      "then": {"properties": {"decision": {"const": "BLOCKED_INCOMPLETE"}}}
    },
    {
      "if": {
        "properties": {
          "native_surface": {
            "properties": {"client_id": {"const": "claude-code"}},
            "required": ["client_id"]
          }
        },
        "required": ["native_surface"]
      },
      "then": {
        "properties": {
          "native_surface": {
            "properties": {
              "adapter_mode": {"const": "native-command-receipt-guard"},
              "hook_error_behavior": {"const": "fail-open"},
              "timeout_behavior": {"const": "fail-open"},
              "enforcement_claim": {"const": "conditional-native-guard"}
            }
          },
          "execution": {
            "properties": {
              "client": {
                "oneOf": [
                  {
                    "properties": {"source": {"const": "unavailable"}, "id": {"const": null}},
                    "required": ["source", "id"]
                  },
                  {
                    "properties": {
                      "source": {"const": "agent-self-observed"},
                      "id": {"const": "claude-code"}
                    },
                    "required": ["source", "id"]
                  }
                ]
              }
            }
          },
          "mandatory_governed_execution": {
            "properties": {
              "skill": {
                "properties": {
                  "ref": {"const": ".claude/skills/governed-review/SKILL.md"}
                }
              }
            }
          },
          "agent_results": {
            "items": {
              "properties": {
                "component_binding": {
                  "properties": {
                    "projection": {
                      "properties": {"client_id": {"const": "claude-code"}}
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "native_surface": {
            "properties": {"client_id": {"const": "cursor"}},
            "required": ["client_id"]
          }
        },
        "required": ["native_surface"]
      },
      "then": {
        "properties": {
          "native_surface": {
            "properties": {
              "adapter_mode": {"const": "native-command-receipt-guard"},
              "hook_error_behavior": {"const": "fail-closed"},
              "timeout_behavior": {"const": "fail-closed"},
              "enforcement_claim": {"const": "conditional-native-guard"}
            }
          },
          "execution": {
            "properties": {
              "client": {
                "oneOf": [
                  {
                    "properties": {"source": {"const": "unavailable"}, "id": {"const": null}},
                    "required": ["source", "id"]
                  },
                  {
                    "properties": {
                      "source": {"const": "native-event-observed"},
                      "id": {"const": "cursor"}
                    },
                    "required": ["source", "id"]
                  }
                ]
              }
            }
          },
          "mandatory_governed_execution": {
            "properties": {
              "skill": {
                "properties": {
                  "ref": {"const": ".cursor/skills/governed-review/SKILL.md"}
                }
              }
            }
          },
          "agent_results": {
            "items": {
              "properties": {
                "component_binding": {
                  "properties": {
                    "projection": {"properties": {"client_id": {"const": "cursor"}}}
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "native_surface": {
            "properties": {"client_id": {"const": "codex"}},
            "required": ["client_id"]
          }
        },
        "required": ["native_surface"]
      },
      "then": {
        "properties": {
          "native_surface": {
            "properties": {
              "adapter_mode": {"const": "native-command-receipt-guard"},
              "hook_error_behavior": {"const": "unknown"},
              "timeout_behavior": {"const": "unknown"},
              "enforcement_claim": {"const": "conditional-native-guard"}
            }
          },
          "execution": {
            "properties": {
              "client": {
                "oneOf": [
                  {
                    "properties": {"source": {"const": "unavailable"}, "id": {"const": null}},
                    "required": ["source", "id"]
                  },
                  {
                    "properties": {
                      "source": {"const": "agent-self-observed"},
                      "id": {"const": "codex"}
                    },
                    "required": ["source", "id"]
                  }
                ]
              }
            }
          },
          "mandatory_governed_execution": {
            "properties": {
              "skill": {
                "properties": {
                  "ref": {"const": ".agents/skills/governed-review/SKILL.md"}
                }
              }
            }
          },
          "agent_results": {
            "items": {
              "properties": {
                "component_binding": {
                  "properties": {
                    "projection": {"properties": {"client_id": {"const": "codex"}}}
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "native_surface": {
            "properties": {"client_id": {"const": "github-copilot-vscode"}},
            "required": ["client_id"]
          }
        },
        "required": ["native_surface"]
      },
      "then": {
        "properties": {
          "native_surface": {
            "properties": {
              "adapter_mode": {"const": "native-command-receipt-guard"},
              "hook_error_behavior": {"const": "fail-open"},
              "timeout_behavior": {"const": "unknown"},
              "enforcement_claim": {"const": "conditional-native-guard"}
            }
          },
          "execution": {
            "properties": {
              "client": {
                "oneOf": [
                  {
                    "properties": {"source": {"const": "unavailable"}, "id": {"const": null}},
                    "required": ["source", "id"]
                  },
                  {
                    "properties": {
                      "source": {"const": "agent-self-observed"},
                      "id": {"const": "github-copilot-vscode"}
                    },
                    "required": ["source", "id"]
                  }
                ]
              }
            }
          },
          "mandatory_governed_execution": {
            "properties": {
              "skill": {
                "properties": {
                  "ref": {"const": ".github/skills/governed-review/SKILL.md"}
                }
              }
            }
          },
          "agent_results": {
            "items": {
              "properties": {
                "component_binding": {
                  "properties": {
                    "projection": {
                      "properties": {"client_id": {"const": "github-copilot-vscode"}}
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitObjectId": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
    "traceId": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "spanId": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "correlationId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "runId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 124,
      "pattern": "^run-[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "projectId": {"type": "string", "pattern": "^project-[0-9a-f]{32}$"},
    "repositoryRelativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "pattern": "^(?!/)(?![A-Za-z]:/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)[^/]+(?:/[^/]+)*$"
    },
    "acceptanceCriteria": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criteria_id",
        "criteria_version",
        "path",
        "sha256",
        "lifecycle",
        "derived_from_application_code"
      ],
      "properties": {
        "criteria_id": {
          "type": "string",
          "pattern": "^criteria:[a-z][a-z0-9]*(?:[-.:][a-z0-9]+)*$"
        },
        "criteria_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "path": {"$ref": "#/$defs/repositoryRelativePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "lifecycle": {
          "description": "PRD'nin staged index'teki ilk `Status:` satırı: `Accepted` için `accepted-frozen`, `Draft` için `draft`. Taslak kriter incelemeyi ve commit'i engellemez; kanonik GovernanceAssessmentReport yalnız `accepted-frozen` kabul eder.",
          "enum": ["accepted-frozen", "draft"]
        },
        "derived_from_application_code": {"const": false}
      }
    },
    "reportDirectory": {
      "type": "string",
      "pattern": "^governed-review/run-[A-Za-z0-9][A-Za-z0-9._-]{3,119}/reports$"
    },
    "decisionPath": {
      "type": "string",
      "pattern": "^governed-review/run-[A-Za-z0-9][A-Za-z0-9._-]{3,119}/decision\\.json$"
    },
    "auditPath": {
      "type": "string",
      "pattern": "^governed-review/run-[A-Za-z0-9][A-Za-z0-9._-]{3,119}/audit\\.json$"
    },
    "authorityBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority_generation", "version", "sha256", "manifest_sha256"],
      "properties": {
        "authority_generation": {"type": "integer", "minimum": 1},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "agenticEvaluatorBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_ref",
        "evaluator_id",
        "version",
        "sha256",
        "mode",
        "authority",
        "runtime_admission",
        "deterministic",
        "production_authority"
      ],
      "properties": {
        "policy_ref": {"const": "policy:governed-review-agentic-evaluation"},
        "evaluator_id": {"const": "evaluator:governed-review-agentic-phase1"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "mode": {"const": "code-policy-application"},
        "authority": {"const": "agentic-advisory"},
        "runtime_admission": {"const": false},
        "deterministic": {"const": false},
        "production_authority": {"const": false}
      }
    },
    "versionedArtifactBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "version_source", "version", "sha256"],
      "properties": {
        "ref": {"$ref": "#/$defs/repositoryRelativePath"},
        "version_source": {"const": "project-manifest.blueprint_version"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "mandatoryGovernedExecutionBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_id",
        "version",
        "canonicalization",
        "sha256",
        "mandatory",
        "rule",
        "skill",
        "stage_order",
        "missing_or_stale_result"
      ],
      "properties": {
        "protocol_id": {"const": "protocol:mandatory-governed-execution-phase1"},
        "version": {"const": "1.3.0"},
        "canonicalization": {"const": "kt-mandatory-governed-execution-json-v1"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "mandatory": {"const": true},
        "rule": {
          "allOf": [
            {"$ref": "#/$defs/versionedArtifactBinding"},
            {"properties": {"ref": {"const": "rules/13-tamamlanma-tanimi.md"}}}
          ]
        },
        "skill": {"$ref": "#/$defs/versionedArtifactBinding"},
        "stage_order": {
          "const": [
            "exact-snapshot",
            "twelve-agent-observations",
            "agentic-policy-evaluation",
            "decision-evidence-assembly",
            "independent-second-pass-validation",
            "decision",
            "snapshot-bound-receipt",
            "review-audit",
            "current-receipt-publication",
            "same-snapshot-action-retry"
          ]
        },
        "missing_or_stale_result": {"const": "BLOCKED_INCOMPLETE"}
      }
    },
    "observedModel": {
      "type": "object",
      "additionalProperties": false,
      "description": "İstemcinin bu olay için bildirdiği etkin model ve effort. Codex ve Cursor modeli kanca olayında, Claude Code oturum logunda bildirir; VS Code/Copilot bildirmez. Gözlenemeyen değer uydurulmaz.",
      "required": ["source", "id", "effort"],
      "properties": {
        "source": {"enum": ["native-event-observed", "client-log-observed", "unavailable"]},
        "id": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]{0,159}$"},
        "effort": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,39}$"}
      },
      "allOf": [
        {
          "if": {"properties": {"source": {"const": "unavailable"}}, "required": ["source"]},
          "then": {"properties": {"id": {"const": null}, "effort": {"const": null}}},
          "else": {"properties": {"id": {"type": "string"}}}
        }
      ]
    },
    "runtimeComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "id", "version", "sha256"],
      "properties": {
        "source": {
          "enum": [
            "client-supplied",
            "native-event-observed",
            "agent-self-observed",
            "unavailable"
          ]
        },
        "id": {"type": ["string", "null"], "minLength": 1, "maxLength": 160},
        "version": {"type": ["string", "null"], "minLength": 1, "maxLength": 160},
        "sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
      },
      "allOf": [
        {
          "if": {"properties": {"source": {"const": "unavailable"}}, "required": ["source"]},
          "then": {
            "properties": {
              "id": {"const": null},
              "version": {"const": null},
              "sha256": {"const": null}
            }
          },
          "else": {
            "properties": {
              "id": {"type": "string"},
              "version": {"type": "string"},
              "sha256": {"$ref": "#/$defs/sha256"}
            }
          }
        }
      ]
    },
    "executionBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_id", "client", "model"],
      "properties": {
        "session_id": {"$ref": "#/$defs/correlationId"},
        "client": {"$ref": "#/$defs/runtimeComponent"},
        "model": {"$ref": "#/$defs/observedModel"}
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonicalization", "git_object_format", "index_tree", "head", "merge_heads", "snapshot_sha256"],
      "properties": {
        "canonicalization": {"const": "kt-git-index-snapshot-json-v1"},
        "git_object_format": {"enum": ["sha1", "sha256"]},
        "index_tree": {"$ref": "#/$defs/gitObjectId"},
        "head": {"oneOf": [{"$ref": "#/$defs/gitObjectId"}, {"type": "null"}]},
        "merge_heads": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/gitObjectId"}
        },
        "snapshot_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "requiredAgents": {
      "type": "array",
      "const": [
        "agent:gereksinim-kapsami",
        "agent:kurumsal-mimari",
        "agent:kod-kalitesi",
        "agent:kod-inceleme",
        "agent:bilgi-guvenligi",
        "agent:uygulama-guvenligi",
        "agent:acik-kaynak-lisansi",
        "agent:gizlilik-kvkk",
        "agent:test-otomasyonu",
        "agent:dokumantasyon",
        "agent:devops",
        "agent:gozlemlenebilirlik"
      ]
    },
    "weights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent:gereksinim-kapsami",
        "agent:kurumsal-mimari",
        "agent:kod-kalitesi",
        "agent:kod-inceleme",
        "agent:bilgi-guvenligi",
        "agent:uygulama-guvenligi",
        "agent:acik-kaynak-lisansi",
        "agent:gizlilik-kvkk",
        "agent:test-otomasyonu",
        "agent:dokumantasyon",
        "agent:devops",
        "agent:gozlemlenebilirlik"
      ],
      "properties": {
        "agent:gereksinim-kapsami": {"type": "number", "minimum": 0},
        "agent:kurumsal-mimari": {"type": "number", "minimum": 0},
        "agent:kod-kalitesi": {"type": "number", "minimum": 0},
        "agent:kod-inceleme": {"type": "number", "minimum": 0},
        "agent:bilgi-guvenligi": {"type": "number", "minimum": 0},
        "agent:uygulama-guvenligi": {"type": "number", "minimum": 0},
        "agent:acik-kaynak-lisansi": {"type": "number", "minimum": 0},
        "agent:gizlilik-kvkk": {"type": "number", "minimum": 0},
        "agent:test-otomasyonu": {"type": "number", "minimum": 0},
        "agent:dokumantasyon": {"type": "number", "minimum": 0},
        "agent:devops": {"type": "number", "minimum": 0},
        "agent:gozlemlenebilirlik": {"type": "number", "minimum": 0}
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fail_score", "warning_score", "confidence_floor", "compliance_baseline"],
      "properties": {
        "fail_score": {"type": "number", "minimum": 0},
        "warning_score": {"type": "number", "minimum": 0},
        "confidence_floor": {"type": "number", "minimum": 0, "maximum": 1},
        "compliance_baseline": {"type": "number", "minimum": 0}
      }
    },
    "versionOrUnavailable": {
      "oneOf": [
        {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        {"const": "unavailable"}
      ]
    },
    "versionedDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "sha256"],
      "properties": {
        "version": {"$ref": "#/$defs/versionOrUnavailable"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "projectionBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["client_id", "path", "version", "sha256"],
      "properties": {
        "client_id": {
          "enum": ["claude-code", "codex", "cursor", "github-copilot-vscode"]
        },
        "path": {"$ref": "#/$defs/repositoryRelativePath"},
        "version": {"$ref": "#/$defs/versionOrUnavailable"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "componentBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent", "policy", "detectors", "instructions", "projection"],
      "properties": {
        "agent": {"$ref": "#/$defs/versionedDigest"},
        "policy": {"$ref": "#/$defs/versionedDigest"},
        "detectors": {"$ref": "#/$defs/versionedDigest"},
        "instructions": {"$ref": "#/$defs/versionedDigest"},
        "projection": {"$ref": "#/$defs/projectionBinding"}
      }
    },
    "agentResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_id",
        "invocation_id",
        "span_id",
        "status",
        "component_binding",
        "report_path",
        "report_sha256",
        "finding_count",
        "max_risk_score_basis_points"
      ],
      "properties": {
        "agent_id": {"type": "string", "pattern": "^agent:[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
        "invocation_id": {"$ref": "#/$defs/correlationId"},
        "span_id": {"$ref": "#/$defs/spanId"},
        "status": {"enum": ["ok", "failed", "timeout", "invalid"]},
        "component_binding": {"$ref": "#/$defs/componentBinding"},
        "report_path": {
          "type": "string",
          "pattern": "^governed-review/run-[A-Za-z0-9][A-Za-z0-9._-]{3,119}/reports/[a-z][a-z0-9]*(?:-[a-z0-9]+)*\\.json$"
        },
        "report_sha256": {"$ref": "#/$defs/sha256"},
        "finding_count": {"type": "integer", "minimum": 0, "maximum": 128},
        "max_risk_score_basis_points": {"type": "integer", "minimum": 0, "maximum": 10000}
      },
      "allOf": [
        {
          "oneOf": [
            {"$ref": "#/$defs/gereksinimKapsamiResult"},
            {"$ref": "#/$defs/kurumsalMimariResult"},
            {"$ref": "#/$defs/kodKalitesiResult"},
            {"$ref": "#/$defs/kodIncelemeResult"},
            {"$ref": "#/$defs/bilgiGuvenligiResult"},
            {"$ref": "#/$defs/uygulamaGuvenligiResult"},
            {"$ref": "#/$defs/acikKaynakLisansResult"},
            {"$ref": "#/$defs/gizlilikKvkkResult"},
            {"$ref": "#/$defs/testOtomasyonuResult"},
            {"$ref": "#/$defs/dokumantasyonResult"},
            {"$ref": "#/$defs/devopsResult"},
            {"$ref": "#/$defs/gozlemlenebilirlikResult"}
          ]
        }
      ]
    },
