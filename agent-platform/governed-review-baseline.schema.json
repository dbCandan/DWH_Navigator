{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "governed-review-baseline.schema.json",
  "title": "GovernedReviewBaseline",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "identity",
    "created_at",
    "full_review_completed_at",
    "full_review_required_after",
    "evidence_status",
    "agent_evidence",
    "run_id",
    "decision",
    "decision_sha256",
    "native_invocation_proven",
    "raw_content_recorded",
    "baseline_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "kind": {"const": "GovernedReviewBaseline"},
    "identity": {"$ref": "#/$defs/reuse_identity"},
    "created_at": {"type": "string", "format": "date-time"},
    "full_review_completed_at": {"type": "string", "format": "date-time"},
    "full_review_required_after": {
      "oneOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]
    },
    "evidence_status": {"enum": ["complete", "incomplete", "failed", "timeout", "invalid"]},
    "agent_evidence": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "prefixItems": [
        {"allOf": [{"$ref": "#/$defs/agent_evidence"}, {"properties": {"agent_id": {"const": "agent:gereksinim-kapsami"}}}]},
        {"allOf": [{"$ref": "#/$defs/agent_evidence"}, {"properties": {"agent_id": {"const": "agent:kurumsal-mimari"}}}]},
        {"allOf": [{"$ref": "#/$defs/agent_evidence"}, {"properties": {"agent_id": {"const": "agent:kod-kalitesi"}}}]},
        {"allOf": [{"$ref": "#/$defs/agent_evidence"}, {"properties": {"agent_id": {"const": "agent:kod-inceleme"}}}]},
        {"allOf": [{"$ref": "#/$defs/agent_evidence"}, {"properties": {"agent_id": {"const": "agent:bilgi-guvenligi"}}}]},
        {"allOf": [{"$ref": "#/$defs/agent_evidence"}, {"properties": {"agent_id": {"const": "agent:uygulama-guvenligi"}}}]},
        {"allOf": [{"$ref": "#/$defs/agent_evidence"}, {"properties": {"agent_id": {"const": "agent:acik-kaynak-lisansi"}}}]},
        {"allOf": [{"$ref": "#/$defs/agent_evidence"}, {"properties": {"agent_id": {"const": "agent:gizlilik-kvkk"}}}]},
        {"allOf": [{"$ref": "#/$defs/agent_evidence"}, {"properties": {"agent_id": {"const": "agent:test-otomasyonu"}}}]},
        {"allOf": [{"$ref": "#/$defs/agent_evidence"}, {"properties": {"agent_id": {"const": "agent:dokumantasyon"}}}]},
        {"allOf": [{"$ref": "#/$defs/agent_evidence"}, {"properties": {"agent_id": {"const": "agent:devops"}}}]},
        {"allOf": [{"$ref": "#/$defs/agent_evidence"}, {"properties": {"agent_id": {"const": "agent:gozlemlenebilirlik"}}}]}
      ],
      "items": false
    },
    "run_id": {"type": "string", "pattern": "^run:[a-z0-9]+(?:[-.:][a-z0-9]+)*$"},
    "decision": {"enum": ["PASS", "HARD-FAIL", "FAIL", "BLOCKED_INCOMPLETE"]},
    "decision_sha256": {"$ref": "#/$defs/sha256"},
    "native_invocation_proven": {"const": false},
    "raw_content_recorded": {"const": false},
    "baseline_sha256": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {"properties": {"evidence_status": {"const": "complete"}}},
      "then": {
        "properties": {
          "agent_evidence": {
            "not": {
              "contains": {
                "required": ["status"],
                "properties": {"status": {"not": {"const": "ok"}}}
              }
            }
          },
          "decision": {"not": {"const": "BLOCKED_INCOMPLETE"}}
        }
      }
    },
    {
      "if": {"properties": {"decision": {"const": "BLOCKED_INCOMPLETE"}}},
      "then": {"properties": {"evidence_status": {"not": {"const": "complete"}}}}
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "semver": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "manifest_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority_generation", "version", "sha256"],
      "properties": {
        "authority_generation": {"type": "integer", "minimum": 1},
        "version": {"$ref": "#/$defs/semver"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "file_fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path_sha256", "content_sha256", "size_bytes"],
      "properties": {
        "path_sha256": {"$ref": "#/$defs/sha256"},
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0, "maximum": 16777216}
      }
    },
    "input_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot_sha256", "tree_sha256", "files", "file_count", "total_bytes"],
      "properties": {
        "snapshot_sha256": {"$ref": "#/$defs/sha256"},
        "tree_sha256": {"$ref": "#/$defs/sha256"},
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": {"$ref": "#/$defs/file_fingerprint"}
        },
        "file_count": {"type": "integer", "minimum": 1, "maximum": 4096},
        "total_bytes": {"type": "integer", "minimum": 0, "maximum": 67108864}
      }
    },
    "agent_component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_id",
        "agent_version",
        "agent_sha256",
        "policy_version",
        "policy_sha256",
        "detector_version",
        "detector_sha256",
        "execution_composition_sha256"
      ],
      "properties": {
        "agent_id": {"type": "string", "pattern": "^agent:[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
        "agent_version": {"$ref": "#/$defs/semver"},
        "agent_sha256": {"$ref": "#/$defs/sha256"},
        "policy_version": {"$ref": "#/$defs/semver"},
        "policy_sha256": {"$ref": "#/$defs/sha256"},
        "detector_version": {"$ref": "#/$defs/semver"},
        "detector_sha256": {"$ref": "#/$defs/sha256"},
        "execution_composition_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "model_component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "provider", "model_id", "model_version", "model_sha256"],
      "properties": {
        "source": {"enum": ["client-supplied", "unavailable"]},
        "provider": {"type": ["string", "null"], "maxLength": 80},
        "model_id": {"type": ["string", "null"], "maxLength": 160},
        "model_version": {"type": ["string", "null"], "maxLength": 160},
        "model_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
      }
    },
    "decision_components": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "orchestration_version",
        "orchestration_sha256",
        "decision_policy_version",
        "decision_policy_sha256"
      ],
      "properties": {
        "orchestration_version": {"$ref": "#/$defs/semver"},
        "orchestration_sha256": {"$ref": "#/$defs/sha256"},
        "decision_policy_version": {"$ref": "#/$defs/semver"},
        "decision_policy_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "execution_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agents", "client_id", "client_version", "model", "decision_components"],
      "properties": {
        "agents": {
          "type": "array",
          "minItems": 12,
          "maxItems": 12,
          "prefixItems": [
            {"allOf": [{"$ref": "#/$defs/agent_component"}, {"properties": {"agent_id": {"const": "agent:gereksinim-kapsami"}}}]},
            {"allOf": [{"$ref": "#/$defs/agent_component"}, {"properties": {"agent_id": {"const": "agent:kurumsal-mimari"}}}]},
            {"allOf": [{"$ref": "#/$defs/agent_component"}, {"properties": {"agent_id": {"const": "agent:kod-kalitesi"}}}]},
            {"allOf": [{"$ref": "#/$defs/agent_component"}, {"properties": {"agent_id": {"const": "agent:kod-inceleme"}}}]},
            {"allOf": [{"$ref": "#/$defs/agent_component"}, {"properties": {"agent_id": {"const": "agent:bilgi-guvenligi"}}}]},
            {"allOf": [{"$ref": "#/$defs/agent_component"}, {"properties": {"agent_id": {"const": "agent:uygulama-guvenligi"}}}]},
            {"allOf": [{"$ref": "#/$defs/agent_component"}, {"properties": {"agent_id": {"const": "agent:acik-kaynak-lisansi"}}}]},
            {"allOf": [{"$ref": "#/$defs/agent_component"}, {"properties": {"agent_id": {"const": "agent:gizlilik-kvkk"}}}]},
            {"allOf": [{"$ref": "#/$defs/agent_component"}, {"properties": {"agent_id": {"const": "agent:test-otomasyonu"}}}]},
            {"allOf": [{"$ref": "#/$defs/agent_component"}, {"properties": {"agent_id": {"const": "agent:dokumantasyon"}}}]},
            {"allOf": [{"$ref": "#/$defs/agent_component"}, {"properties": {"agent_id": {"const": "agent:devops"}}}]},
            {"allOf": [{"$ref": "#/$defs/agent_component"}, {"properties": {"agent_id": {"const": "agent:gozlemlenebilirlik"}}}]}
          ],
          "items": false
        },
        "client_id": {
          "enum": ["claude-code", "codex", "cursor", "github-copilot-vscode"]
        },
        "client_version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:+/-]{0,159}$"
        },
        "model": {"$ref": "#/$defs/model_component"},
        "decision_components": {"$ref": "#/$defs/decision_components"}
      }
    },
    "reuse_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "project_id",
        "input",
        "authority",
        "execution",
        "identity_sha256"
      ],
      "properties": {
        "schema_version": {"const": "1.0"},
        "kind": {"const": "ReviewReuseIdentity"},
        "project_id": {"type": "string", "pattern": "^project-[0-9a-f]{32}$"},
        "input": {"$ref": "#/$defs/input_identity"},
        "authority": {"$ref": "#/$defs/manifest_identity"},
        "execution": {"$ref": "#/$defs/execution_identity"},
        "identity_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "agent_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_id", "status", "report_sha256", "evidence_sha256"],
      "properties": {
        "agent_id": {"type": "string", "pattern": "^agent:[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
        "status": {"enum": ["ok", "missing", "failed", "timeout", "invalid"]},
        "report_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "evidence_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
      }
    }
  }
}
