{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kt:agent-platform:detector-pack:1.5",
  "title": "Kanonik Algılayıcı Belirtim Paketi",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "metadata",
    "agent_ref",
    "policy_ref",
    "source_lineage",
    "execution_boundary",
    "detectors",
    "decision_metadata",
    "runtime_profile"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "1.1",
        "1.2",
        "1.3",
        "1.4",
        "1.5"
      ]
    },
    "kind": {
      "const": "DeterministicDetectorPack"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "owner",
        "lifecycle"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^detector-pack:[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "version": {
          "$ref": "#/$defs/semver"
        },
        "owner": {
          "$ref": "#/$defs/ownerRef"
        },
        "lifecycle": {
          "const": "draft"
        }
      }
    },
    "agent_ref": {
      "$ref": "#/$defs/agentRef"
    },
    "policy_ref": {
      "$ref": "#/$defs/policyRef"
    },
    "source_lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_role",
        "source_authority",
        "implementation_status",
        "projection_status",
        "runtime_admission",
        "crosswalk_ref"
      ],
      "properties": {
        "source_role": {
          "$ref": "#/$defs/sourceRoleRef"
        },
        "source_authority": {
          "const": "governance-authoritative"
        },
        "implementation_status": {
          "enum": [
            "implemented",
            "partially-implemented",
            "implementation-pending"
          ]
        },
        "projection_status": {
          "enum": [
            "projected",
            "not-projectable",
            "blocked"
          ]
        },
        "runtime_admission": {
          "const": "not-admitted"
        },
        "crosswalk_ref": {
          "const": "governance-crosswalk:desktop-agents-v1"
        },
        "supplemental_crosswalk_refs": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/crosswalkRef"
          }
        }
      }
    },
    "execution_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "executor_ref",
        "implementation_status",
        "projection_status",
        "runtime_admission",
        "calibration_status"
      ],
      "properties": {
        "mode": {
          "const": "specification-only"
        },
        "executor_ref": {
          "type": "null"
        },
        "implementation_status": {
          "enum": [
            "implemented",
            "partially-implemented",
            "implementation-pending"
          ]
        },
        "projection_status": {
          "const": "not-projectable"
        },
        "runtime_admission": {
          "const": "not-admitted"
        },
        "calibration_status": {
          "enum": [
            "uncalibrated",
            "not-applicable"
          ]
        }
      }
    },
    "detectors": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/detector"
      }
    },
    "decision_metadata": {
      "$ref": "#/$defs/decisionMetadata"
    },
    "runtime_profile": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/runtimeProfile"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "runtime_profile": {
            "type": "object",
            "properties": {
              "id": {
                "not": {
                  "const": "runtime-profile:test-otomasyonu-yalitilmis"
                }
              }
            },
            "required": [
              "id"
            ]
          }
        },
        "required": [
          "runtime_profile"
        ]
      },
      "then": {
        "properties": {
          "schema_version": {
            "const": "1.5"
          }
        }
      },
      "else": {
        "if": {
          "properties": {
            "detectors": {
              "contains": {
                "properties": {
                  "implementation": {
                    "properties": {
                      "resolution_ref": {
                        "const": "resolution:sec009-loopback-exemption"
                      }
                    },
                    "required": [
                      "resolution_ref"
                    ]
                  }
                },
                "required": [
                  "implementation"
                ]
              }
            }
          }
        },
        "then": {
          "properties": {
            "schema_version": {
              "const": "1.4"
            }
          }
        },
        "else": {
          "if": {
            "properties": {
              "detectors": {
                "contains": {
                  "properties": {
                    "implementation": {
                      "properties": {
                        "kind": {
                          "const": "rsa-key-size-minimum"
                        }
                      },
                      "required": [
                        "kind"
                      ]
                    }
                  },
                  "required": [
                    "implementation"
                  ]
                }
              }
            }
          },
          "then": {
            "properties": {
              "schema_version": {
                "const": "1.3"
              }
            }
          },
          "else": {
            "if": {
              "properties": {
                "detectors": {
                  "contains": {
                    "properties": {
                      "implementation": {
                        "properties": {
                          "kind": {
                            "const": "python-profile-compatibility"
                          }
                        },
                        "required": [
                          "kind"
                        ]
                      }
                    },
                    "required": [
                      "implementation"
                    ]
                  }
                }
              }
            },
            "then": {
              "properties": {
                "schema_version": {
                  "const": "1.2"
                }
              }
            },
            "else": {
              "properties": {
                "schema_version": {
                  "const": "1.1"
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "ownerRef": {
      "type": "string",
      "pattern": "^(?:team|person):[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "crosswalkRef": {
      "type": "string",
      "pattern": "^governance-crosswalk:[a-z0-9][a-z0-9.-]*(?::[a-z0-9][a-z0-9.-]*)*$"
    },
    "agentRef": {
      "type": "string",
      "pattern": "^agent:[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "policyRef": {
      "type": "string",
      "pattern": "^policy:[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "sourceRoleRef": {
      "type": "string",
      "pattern": "^governance-source:desktop-agents/[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "sourceItemRef": {
      "type": "string",
      "pattern": "^governance-source:desktop-agents/[a-z][a-z0-9]*(?:-[a-z0-9]+)*/(?:agent\\.md|policy\\.yaml|aggregation_policy\\.yaml|allowlist\\.yaml|detectors\\.yaml)#[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "controlRef": {
      "type": "string",
      "pattern": "^control:[A-Z][A-Z0-9]*-[0-9]{3}$"
    },
    "detectorRef": {
      "type": "string",
      "pattern": "^detector:[a-z][a-z0-9]*(?:[./-][a-z0-9]+)*$"
    },
    "standardRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "standard_id",
        "control_id",
        "version",
        "mapping_status"
      ],
      "properties": {
        "standard_id": {
          "type": "string",
          "pattern": "^[A-Z0-9][A-Z0-9._/-]{1,63}$"
        },
        "control_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,95}$"
        },
        "version": {
          "type": "null"
        },
        "mapping_status": {
          "const": "source-stated-unverified"
        }
      }
    },
    "regexImplementation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "engine",
        "pattern",
        "flags"
      ],
      "properties": {
        "kind": {
          "const": "regex"
        },
        "engine": {
          "const": "python-re"
        },
        "pattern": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "^(?!.*[\\r\\n]).*\\S.*$"
        },
        "flags": {
          "type": "array",
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "IGNORECASE",
              "MULTILINE",
              "DOTALL"
            ]
          }
        }
      }
    },
    "pythonProfileImplementation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "resolution_ref",
        "profile_refs",
        "declaration_fields",
        "comparison",
        "missing_or_invalid_input"
      ],
      "properties": {
        "kind": {
          "const": "python-profile-compatibility"
        },
        "resolution_ref": {
          "const": "resolution:python-runtime-profile"
        },
        "profile_refs": {
          "const": [
            "technology-profile.yml#backend.language",
            "technology-profile.yml#backend.minimum_language_version"
          ]
        },
        "declaration_fields": {
          "const": [
            "pyproject.toml#project.requires-python",
            "setup.cfg#options.python_requires",
            "setup.py#python_requires"
          ]
        },
        "comparison": {
          "const": "declared-range-at-or-above-profile-minimum"
        },
        "missing_or_invalid_input": {
          "const": "BLOCKED_INCOMPLETE"
        }
      }
    },
    "lineMetricImplementation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "metric",
        "operator",
        "threshold"
      ],
      "properties": {
        "kind": {
          "const": "line-metric"
        },
        "metric": {
          "enum": [
            "function-lines",
            "commented-code-block-lines",
            "docstring-coverage-ratio"
          ]
        },
        "operator": {
          "enum": [
            "greater-than",
            "greater-than-or-equal",
            "less-than"
          ]
        },
        "threshold": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000
        }
      }
    },
    "eventImplementation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "event"
      ],
      "properties": {
        "kind": {
          "const": "event"
        },
        "event": {
          "enum": [
            "test-generation-failed",
            "test-execution-timeout",
            "test-execution-failed"
          ]
        }
      }
    },
    "detector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_refs",
        "control_refs",
        "severity",
        "evidence_kind",
        "standard_refs",
        "implementation",
        "limitations",
        "implementation_status",
        "projection_status",
        "runtime_admission",
        "lifecycle"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/detectorRef"
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sourceItemRef"
          }
        },
        "control_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/controlRef"
          }
        },
        "severity": {
          "enum": [
            "info",
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "evidence_kind": {
          "enum": [
            "deterministic-check",
            "test-result"
          ]
        },
        "standard_refs": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/standardRef"
          }
        },
        "implementation": {
          "oneOf": [
            {
              "$ref": "#/$defs/regexImplementation"
            },
            {
              "$ref": "#/$defs/pythonProfileImplementation"
            },
            {
              "$ref": "#/$defs/lineMetricImplementation"
            },
            {
              "$ref": "#/$defs/eventImplementation"
            },
            {
              "$ref": "#/$defs/rsaMinimumImplementation"
            },
            {
              "$ref": "#/$defs/sec009LoopbackRegexImplementation"
            }
          ]
        },
        "limitations": {
          "type": "string",
          "minLength": 20,
          "maxLength": 500,
          "pattern": "^(?!.*[\\r\\n]).*\\S.*$"
        },
        "implementation_status": {
          "enum": [
            "implemented",
            "calibration-pending"
          ]
        },
        "projection_status": {
          "const": "not-projectable"
        },
        "runtime_admission": {
          "const": "not-admitted"
        },
        "lifecycle": {
          "const": "draft"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "id": {
                "const": "detector:uygulama-guvenligi/appsec-012"
              }
            },
            "required": [
              "id"
            ]
          },
          "then": {
            "properties": {
              "implementation": {
                "$ref": "#/$defs/rsaMinimumImplementation"
              }
            }
          },
          "else": {
            "properties": {
              "implementation": {
                "not": {
                  "properties": {
                    "kind": {
                      "const": "rsa-key-size-minimum"
                    }
                  },
                  "required": [
                    "kind"
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "const": "detector:bilgi-guvenligi/sec-009"
              }
            },
            "required": [
              "id"
            ]
          },
          "then": {
            "properties": {
              "implementation": {
                "$ref": "#/$defs/sec009LoopbackRegexImplementation"
              }
            }
          },
          "else": {
            "properties": {
              "implementation": {
                "not": {
                  "properties": {
                    "resolution_ref": {
                      "const": "resolution:sec009-loopback-exemption"
                    }
                  },
                  "required": [
                    "resolution_ref"
                  ]
                }
              }
            }
          }
        }
      ]
    },
    "decisionMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authoritative_hard_fail_detectors",
        "authoritative_non_hard_fail_detectors",
        "hard_fail_not_declared_detectors",
        "unresolved_hard_fail_detectors",
        "unresolved_decision_conflicts"
      ],
      "properties": {
        "authoritative_hard_fail_detectors": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/detectorRef"
          }
        },
        "authoritative_non_hard_fail_detectors": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/detectorRef"
          }
        },
        "hard_fail_not_declared_detectors": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/detectorRef"
          }
        },
        "unresolved_hard_fail_detectors": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/detectorRef"
          }
        },
        "unresolved_decision_conflicts": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/detectorConflict"
          }
        }
      }
    },
    "detectorConflict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "detector_id",
        "source_conflict_refs"
      ],
      "properties": {
        "detector_id": {
          "$ref": "#/$defs/detectorRef"
        },
        "source_conflict_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^source-conflict:[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          }
        }
      }
    },
    "runtimeProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_refs",
        "max_generation_retries",
        "test_timeout_seconds",
        "result_timeout_seconds",
        "network",
        "inherited_secrets",
        "project_workspace_write",
        "source_authority",
        "implementation_status",
        "projection_status",
        "runtime_admission"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^runtime-profile:[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "source_refs": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sourceItemRef"
          }
        },
        "max_generation_retries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "test_timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1800
        },
        "result_timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        },
        "network": {
          "const": "denied"
        },
        "inherited_secrets": {
          "const": false
        },
        "project_workspace_write": {
          "const": false
        },
        "source_authority": {
          "const": "governance-authoritative"
        },
        "implementation_status": {
          "const": "implementation-pending"
        },
        "projection_status": {
          "const": "not-projectable"
        },
        "runtime_admission": {
          "const": "not-admitted"
        }
      }
    },
    "rsaMinimumImplementation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "resolution_ref",
        "profile_ref",
        "minimum_bits",
        "comparison",
        "input",
        "missing_or_invalid_input"
      ],
      "properties": {
        "kind": {
          "const": "rsa-key-size-minimum"
        },
        "resolution_ref": {
          "const": "resolution:rsa-minimum-2048"
        },
        "profile_ref": {
          "const": "technology-profile.yml#security.rsa_minimum_bits"
        },
        "minimum_bits": {
          "const": 2048
        },
        "comparison": {
          "const": "less-than-minimum"
        },
        "input": {
          "const": "verified-integer-key-size-bits"
        },
        "missing_or_invalid_input": {
          "const": "BLOCKED_INCOMPLETE"
        }
      }
    },
    "sec009LoopbackRegexImplementation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "engine",
        "pattern",
        "flags",
        "resolution_ref",
        "profile_ref",
        "exempt_addresses",
        "missing_or_invalid_input"
      ],
      "properties": {
        "kind": {
          "const": "regex"
        },
        "engine": {
          "const": "python-re"
        },
        "pattern": {
          "const": "\\b(?!0\\.0\\.0\\.0\\b)(?!127\\.)(?:(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\.){3}(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\b"
        },
        "flags": {
          "const": []
        },
        "resolution_ref": {
          "const": "resolution:sec009-loopback-exemption"
        },
        "profile_ref": {
          "const": "technology-profile.yml#security.loopback_is_network_exposure"
        },
        "exempt_addresses": {
          "const": [
            "127.0.0.0/8",
            "::1",
            "localhost"
          ]
        },
        "missing_or_invalid_input": {
          "const": "BLOCKED_INCOMPLETE"
        }
      }
    }
  }
}
