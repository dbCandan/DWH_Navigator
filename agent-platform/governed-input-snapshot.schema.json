{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kt:agent-platform:governed-input-snapshot:1.0",
  "title": "GovernedInputSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "scope",
    "files",
    "file_count",
    "total_bytes",
    "tree_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "kind": {"const": "GovernedInputSnapshot"},
    "scope": {"const": "explicit-repository-file-set"},
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "size_bytes"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "pattern": "^(?!/)(?![A-Za-z]:/)(?!\\.git(?:/|$))(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)[^/]+(?:/[^/]+)*$"
          },
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size_bytes": {"type": "integer", "minimum": 0, "maximum": 16777216}
        }
      }
    },
    "file_count": {"type": "integer", "minimum": 1, "maximum": 4096},
    "total_bytes": {"type": "integer", "minimum": 0, "maximum": 67108864},
    "tree_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
