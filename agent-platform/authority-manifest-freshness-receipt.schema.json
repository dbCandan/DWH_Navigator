{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "authority-manifest-freshness-receipt.schema.json",
  "title": "AuthorityManifestFreshnessReceipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "project_id",
    "authority",
    "last_accepted",
    "installed",
    "transport",
    "checked_at",
    "evaluated_at",
    "valid_until",
    "revocation_epoch",
    "revoked_generations",
    "forced_refresh",
    "status",
    "authority_not_rechecked",
    "local_drift_verified",
    "application_compliance_proven",
    "production_admission"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "kind": {"const": "AuthorityManifestFreshnessReceipt"},
    "project_id": {"type": "string", "pattern": "^project-[0-9a-f]{32}$"},
    "authority": {
      "oneOf": [
        {"$ref": "#/$defs/manifest_identity"},
        {"type": "null"}
      ]
    },
    "last_accepted": {
      "oneOf": [
        {"$ref": "#/$defs/manifest_identity"},
        {"type": "null"}
      ]
    },
    "installed": {"$ref": "#/$defs/manifest_identity"},
    "transport": {"enum": ["live-mcp", "accepted-offline-pin", "none"]},
    "checked_at": {"oneOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]},
    "evaluated_at": {"type": "string", "format": "date-time"},
    "valid_until": {"oneOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]},
    "revocation_epoch": {
      "oneOf": [{"type": "integer", "minimum": 1}, {"type": "null"}]
    },
    "revoked_generations": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1}
    },
    "forced_refresh": {"type": "boolean"},
    "status": {
      "enum": [
        "current",
        "offline-pinned",
        "update-required",
        "local-drift",
        "expired",
        "revoked",
        "refresh-required",
        "rollback-detected",
        "equivocation-detected",
        "unpinned"
      ]
    },
    "authority_not_rechecked": {"type": "boolean"},
    "local_drift_verified": {"type": "boolean"},
    "application_compliance_proven": {"const": false},
    "production_admission": {"const": false}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"not": {"const": "unpinned"}}}},
      "then": {
        "properties": {
          "authority": {"$ref": "#/$defs/manifest_identity"},
          "last_accepted": {"$ref": "#/$defs/manifest_identity"},
          "transport": {"enum": ["live-mcp", "accepted-offline-pin"]},
          "checked_at": {"type": "string", "format": "date-time"}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "unpinned"}}},
      "then": {
        "properties": {
          "authority": {"type": "null"},
          "last_accepted": {"type": "null"},
          "transport": {"const": "none"},
          "checked_at": {"type": "null"},
          "valid_until": {"type": "null"},
          "revocation_epoch": {"type": "null"},
          "revoked_generations": {"maxItems": 0},
          "forced_refresh": {"const": false},
          "authority_not_rechecked": {"const": false}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "current"}}},
      "then": {
        "properties": {
          "authority": {"$ref": "#/$defs/manifest_identity"},
          "last_accepted": {"$ref": "#/$defs/manifest_identity"},
          "transport": {"const": "live-mcp"},
          "authority_not_rechecked": {"const": false},
          "local_drift_verified": {"const": true}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "offline-pinned"}}},
      "then": {
        "properties": {
          "authority": {"$ref": "#/$defs/manifest_identity"},
          "last_accepted": {"$ref": "#/$defs/manifest_identity"},
          "transport": {"const": "accepted-offline-pin"},
          "authority_not_rechecked": {"const": true},
          "local_drift_verified": {"const": true}
        }
      }
    },
    {
      "if": {"properties": {"transport": {"const": "accepted-offline-pin"}}},
      "then": {"properties": {"authority_not_rechecked": {"const": true}}}
    },
    {
      "if": {"properties": {"transport": {"const": "live-mcp"}}},
      "then": {"properties": {"authority_not_rechecked": {"const": false}}}
    },
    {
      "if": {"properties": {"transport": {"const": "none"}}},
      "then": {"properties": {"status": {"const": "unpinned"}}}
    },
    {
      "if": {"properties": {"revoked_generations": {"minItems": 1}}},
      "then": {"properties": {"revocation_epoch": {"type": "integer", "minimum": 1}}}
    }
  ],
  "$defs": {
    "manifest_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority_generation", "version", "sha256"],
      "properties": {
        "authority_generation": {"type": "integer", "minimum": 1},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
