{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kt:agent-platform:untrusted-content-envelope:1.0",
  "title": "Güvenilmeyen Harici İçerik Zarfı",
  "description": "KT Scaffold ve yönetilen uyarlayıcı sınırında harici içeriği talimat ve yetki taşımayan veri olarak ayıran katı üst veri sözleşmesidir; yerel istemcinin bütün bağlamını yakaladığı veya çalışma zamanı kabulü sağladığı anlamına gelmez.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "source_kind",
    "source_ref",
    "provenance",
    "content_sha256",
    "content_length",
    "classification",
    "trust",
    "instruction_authority",
    "authority",
    "raw_payload_retained",
    "raw_payload_retention"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "kind": {"const": "UntrustedContentEnvelope"},
    "source_kind": {"$ref": "#/$defs/sourceKind"},
    "source_ref": {"$ref": "#/$defs/sourceRef"},
    "provenance": {"$ref": "#/$defs/provenance"},
    "content_sha256": {"$ref": "#/$defs/sha256"},
    "content_length": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8388608
    },
    "classification": {
      "enum": ["public", "internal", "confidential", "restricted", "unknown"]
    },
    "trust": {"const": "untrusted"},
    "instruction_authority": {"const": false},
    "authority": {"$ref": "#/$defs/authority"},
    "raw_payload_retained": {"const": false},
    "raw_payload_retention": {"const": "none"}
  },
  "allOf": [
    {
      "if": {"properties": {"source_kind": {"const": "file"}}, "required": ["source_kind"]},
      "then": {"properties": {"source_ref": {"pattern": "^file:"}}}
    },
    {
      "if": {"properties": {"source_kind": {"const": "code-comment"}}, "required": ["source_kind"]},
      "then": {"properties": {"source_ref": {"pattern": "^code-comment:"}}}
    },
    {
      "if": {"properties": {"source_kind": {"const": "mcp-output"}}, "required": ["source_kind"]},
      "then": {"properties": {"source_ref": {"pattern": "^mcp:"}}}
    },
    {
      "if": {"properties": {"source_kind": {"const": "tool-output"}}, "required": ["source_kind"]},
      "then": {"properties": {"source_ref": {"pattern": "^tool:"}}}
    },
    {
      "if": {"properties": {"source_kind": {"const": "web-content"}}, "required": ["source_kind"]},
      "then": {"properties": {"source_ref": {"pattern": "^web:"}}}
    },
    {
      "if": {"properties": {"source_kind": {"const": "search-result"}}, "required": ["source_kind"]},
      "then": {"properties": {"source_ref": {"pattern": "^search:"}}}
    },
    {
      "if": {"properties": {"source_kind": {"const": "shell-output"}}, "required": ["source_kind"]},
      "then": {"properties": {"source_ref": {"pattern": "^shell:"}}}
    },
    {
      "if": {"properties": {"source_kind": {"const": "test-output"}}, "required": ["source_kind"]},
      "then": {"properties": {"source_ref": {"pattern": "^test:"}}}
    },
    {
      "if": {"properties": {"source_kind": {"const": "scanner-output"}}, "required": ["source_kind"]},
      "then": {"properties": {"source_ref": {"pattern": "^scanner:"}}}
    },
    {
      "if": {"properties": {"source_kind": {"const": "issue"}}, "required": ["source_kind"]},
      "then": {"properties": {"source_ref": {"pattern": "^issue:"}}}
    },
    {
      "if": {"properties": {"source_kind": {"const": "pull-request"}}, "required": ["source_kind"]},
      "then": {"properties": {"source_ref": {"pattern": "^pull-request:"}}}
    },
    {
      "if": {"properties": {"source_kind": {"const": "email"}}, "required": ["source_kind"]},
      "then": {"properties": {"source_ref": {"pattern": "^email:"}}}
    },
    {
      "if": {"properties": {"source_kind": {"const": "document"}}, "required": ["source_kind"]},
      "then": {"properties": {"source_ref": {"pattern": "^document:"}}}
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sourceKind": {
      "enum": [
        "file",
        "code-comment",
        "mcp-output",
        "tool-output",
        "web-content",
        "search-result",
        "shell-output",
        "test-output",
        "scanner-output",
        "issue",
        "pull-request",
        "email",
        "document"
      ]
    },
    "sourceRef": {
      "type": "string",
      "minLength": 3,
      "maxLength": 256,
      "pattern": "^(?:file|code-comment|mcp|tool|web|search|shell|test|scanner|issue|pull-request|email|document):[a-z0-9][a-z0-9._:/-]*$"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "boundary",
        "adapter_id",
        "origin_ref_sha256",
        "external_origin",
        "native_client_capture"
      ],
      "properties": {
        "schema_version": {"const": "1.0"},
        "kind": {"const": "UntrustedContentProvenance"},
        "boundary": {
          "enum": ["kt-scaffold-adapter", "mcp-adapter", "platform-adapter", "agent-contract"]
        },
        "adapter_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "origin_ref_sha256": {"$ref": "#/$defs/sha256"},
        "external_origin": {"const": true},
        "native_client_capture": {"const": false}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "tool",
        "approval",
        "admission",
        "agent_identity",
        "override",
        "permission",
        "delegation"
      ],
      "properties": {
        "policy": {"const": false},
        "tool": {"const": false},
        "approval": {"const": false},
        "admission": {"const": false},
        "agent_identity": {"const": false},
        "override": {"const": false},
        "permission": {"const": false},
        "delegation": {"const": false}
      }
    }
  }
}
