{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kt:agent-platform:decision-policy:1.3",
  "title": "Deterministik İnceleme Karar Politikası",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "metadata",
    "lineage",
    "instructions_ref",
    "controls",
    "claim_boundary",
    "required_agents",
    "weights",
    "finding_classification",
    "thresholds",
    "fail_closed",
    "security_critical_veto",
    "decision_precedence",
    "warning_disposition",
    "hard_fail_authority",
    "hard_fail_non_override",
    "decisions"
  ],
  "properties": {
    "schema_version": {"const": "1.3"},
    "kind": {"const": "DeterministicDecisionPolicy"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "owner", "lifecycle"],
      "properties": {
        "id": {"const": "policy:governed-review-aggregation"},
        "version": {"$ref": "#/$defs/semver"},
        "owner": {"$ref": "#/$defs/ownerRef"},
        "lifecycle": {"const": "draft"}
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_role",
        "source_artifacts",
        "source_artifact_ref",
        "source_locator",
        "source_artifact_sha256",
        "source_version",
        "source_authority",
        "implementation_status",
        "calibration_status",
        "runtime_admission"
      ],
      "properties": {
        "source_role": {"const": "governance-source:desktop-agents/supervisor"},
        "source_artifacts": {
          "type": "array",
          "prefixItems": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "sha256"],
              "properties": {
                "id": {"const": "governance-source:supervisor:instructions"},
                "sha256": {"$ref": "#/$defs/sha256"}
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "sha256"],
              "properties": {
                "id": {"const": "governance-source:supervisor:aggregation-policy"},
                "sha256": {"$ref": "#/$defs/sha256"}
              }
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "source_artifact_ref": {"const": "governance-source:supervisor:aggregation-policy"},
        "source_locator": {
          "const": "governance-source:desktop-agents/supervisor/aggregation_policy.yaml"
        },
        "source_artifact_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_version": {"const": "1.0.0"},
        "source_authority": {"const": "governance-authoritative"},
        "implementation_status": {"const": "implemented"},
        "calibration_status": {"const": "uncalibrated"},
        "runtime_admission": {"const": "not-admitted"}
      }
    },
    "instructions_ref": {
      "const": "policies/aggregation/governed-review-instructions.md"
    },
    "controls": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/control"}
    },
    "claim_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "thresholds_calibrated",
        "runtime_admission",
        "production_decision",
        "note"
      ],
      "properties": {
        "thresholds_calibrated": {"const": false},
        "runtime_admission": {"const": false},
        "production_decision": {"const": false},
        "note": {"type": "string", "minLength": 20, "maxLength": 500}
      }
    },
    "required_agents": {
      "const": [
        "agent:gereksinim-kapsami",
        "agent:kurumsal-mimari",
        "agent:kod-kalitesi",
        "agent:kod-inceleme",
        "agent:bilgi-guvenligi",
        "agent:uygulama-guvenligi",
        "agent:acik-kaynak-lisansi",
        "agent:gizlilik-kvkk",
        "agent:test-otomasyonu",
        "agent:dokumantasyon",
        "agent:devops",
        "agent:gozlemlenebilirlik"
      ]
    },
    "weights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent:gereksinim-kapsami",
        "agent:kurumsal-mimari",
        "agent:kod-kalitesi",
        "agent:kod-inceleme",
        "agent:bilgi-guvenligi",
        "agent:uygulama-guvenligi",
        "agent:acik-kaynak-lisansi",
        "agent:gizlilik-kvkk",
        "agent:test-otomasyonu",
        "agent:dokumantasyon",
        "agent:devops",
        "agent:gozlemlenebilirlik"
      ],
      "properties": {
        "agent:gereksinim-kapsami": {"$ref": "#/$defs/policyWeight"},
        "agent:kurumsal-mimari": {"$ref": "#/$defs/policyWeight"},
        "agent:kod-kalitesi": {"$ref": "#/$defs/policyWeight"},
        "agent:kod-inceleme": {"$ref": "#/$defs/policyWeight"},
        "agent:bilgi-guvenligi": {"$ref": "#/$defs/policyWeight"},
        "agent:uygulama-guvenligi": {"$ref": "#/$defs/policyWeight"},
        "agent:acik-kaynak-lisansi": {"$ref": "#/$defs/policyWeight"},
        "agent:gizlilik-kvkk": {"$ref": "#/$defs/policyWeight"},
        "agent:test-otomasyonu": {"$ref": "#/$defs/policyWeight"},
        "agent:dokumantasyon": {"$ref": "#/$defs/policyWeight"},
        "agent:devops": {"$ref": "#/$defs/policyWeight"},
        "agent:gozlemlenebilirlik": {"$ref": "#/$defs/policyWeight"}
      }
    },
    "finding_classification": {
      "$ref": "#/$defs/findingClassification"
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fail_score", "warning_score", "confidence_floor", "compliance_baseline"],
      "properties": {
        "fail_score": {"$ref": "#/$defs/scoreThreshold"},
        "warning_score": {"$ref": "#/$defs/scoreThreshold"},
        "confidence_floor": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "compliance_baseline": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        }
      }
    },
    "fail_closed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "missing_agent",
        "duplicate_agent",
        "agent_failed",
        "timeout",
        "invalid_schema",
        "raw_source_rejected",
        "integrity_failure",
        "request_digest_mismatch",
        "low_confidence",
        "prohibited_agent",
        "unexpected_agent",
        "unknown_policy_version",
        "authoritative_conflict",
        "detector_evidence_invalid",
        "finding_classification_invalid",
        "required_human_evidence_missing",
        "required_admission_evidence_missing"
      ],
      "properties": {
        "missing_agent": {"const": "BLOCKED_INCOMPLETE"},
        "duplicate_agent": {"const": "BLOCKED_INCOMPLETE"},
        "agent_failed": {"const": "BLOCKED_INCOMPLETE"},
        "timeout": {"const": "BLOCKED_INCOMPLETE"},
        "invalid_schema": {"const": "BLOCKED_INCOMPLETE"},
        "raw_source_rejected": {"const": "BLOCKED_INCOMPLETE"},
        "integrity_failure": {"const": "BLOCKED_INCOMPLETE"},
        "request_digest_mismatch": {"const": "BLOCKED_INCOMPLETE"},
        "low_confidence": {"const": "BLOCKED_INCOMPLETE"},
        "prohibited_agent": {"const": "BLOCKED_INCOMPLETE"},
        "unexpected_agent": {"const": "BLOCKED_INCOMPLETE"},
        "unknown_policy_version": {"const": "BLOCKED_INCOMPLETE"},
        "authoritative_conflict": {"const": "BLOCKED_INCOMPLETE"},
        "detector_evidence_invalid": {"const": "BLOCKED_INCOMPLETE"},
        "finding_classification_invalid": {"const": "BLOCKED_INCOMPLETE"},
        "required_human_evidence_missing": {"const": "BLOCKED_INCOMPLETE"},
        "required_admission_evidence_missing": {"const": "BLOCKED_INCOMPLETE"}
      }
    },
    "security_critical_veto": {
      "$ref": "#/$defs/securityCriticalVeto"
    },
    "decision_precedence": {
      "const": ["BLOCKED_INCOMPLETE", "HARD-FAIL", "FAIL", "PASS"]
    },
    "warning_disposition": {"const": "PASS_WITH_ADVISORY_REASON"},
    "hard_fail_authority": {
      "const": "canonical-detector-source-policy-and-evidence"
    },
    "hard_fail_non_override": {
      "$ref": "#/$defs/hardFailNonOverride"
    },
    "decisions": {
      "type": "array",
      "const": ["PASS", "HARD-FAIL", "FAIL", "BLOCKED_INCOMPLETE"]
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "ownerRef": {
      "type": "string",
      "pattern": "^(?:team|person):[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "policyWeight": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 10
    },
    "scoreThreshold": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "findingClassification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "authority",
        "calibration_status",
        "runtime_admission",
        "severity_bands",
        "semantic_evaluators",
        "unclassified_result",
        "mismatch_result"
      ],
      "properties": {
        "schema_version": {"const": "1.0"},
        "authority": {"const": "implementation-policy"},
        "calibration_status": {"const": "uncalibrated"},
        "runtime_admission": {"const": "not-admitted"},
        "severity_bands": {
          "type": "array",
          "prefixItems": [
            {"$ref": "#/$defs/infoSeverityBand"},
            {"$ref": "#/$defs/lowSeverityBand"},
            {"$ref": "#/$defs/mediumSeverityBand"},
            {"$ref": "#/$defs/highSeverityBand"},
            {"$ref": "#/$defs/criticalSeverityBand"}
          ],
          "items": false,
          "minItems": 5,
          "maxItems": 5
        },
        "semantic_evaluators": {
          "type": "array",
          "minItems": 0,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/semanticEvaluator"}
        },
        "unclassified_result": {"const": "BLOCKED_INCOMPLETE"},
        "mismatch_result": {"const": "BLOCKED_INCOMPLETE"}
      }
    },
    "severityBandBase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "severity",
        "label_tr",
        "minimum_score_basis_points",
        "maximum_score_basis_points",
        "detector_score_basis_points"
      ],
      "properties": {
        "severity": {"enum": ["info", "low", "medium", "high", "critical"]},
        "label_tr": {"enum": ["Bilgi", "Düşük", "Orta", "Yüksek", "Kritik"]},
        "minimum_score_basis_points": {"type": "integer", "minimum": 0, "maximum": 10000},
        "maximum_score_basis_points": {"type": "integer", "minimum": 0, "maximum": 10000},
        "detector_score_basis_points": {"type": "integer", "minimum": 0, "maximum": 10000}
      }
    },
    "infoSeverityBand": {
      "allOf": [
        {"$ref": "#/$defs/severityBandBase"},
        {"properties": {"severity": {"const": "info"}, "label_tr": {"const": "Bilgi"}}}
      ]
    },
    "lowSeverityBand": {
      "allOf": [
        {"$ref": "#/$defs/severityBandBase"},
        {"properties": {"severity": {"const": "low"}, "label_tr": {"const": "Düşük"}}}
      ]
    },
    "mediumSeverityBand": {
      "allOf": [
        {"$ref": "#/$defs/severityBandBase"},
        {"properties": {"severity": {"const": "medium"}, "label_tr": {"const": "Orta"}}}
      ]
    },
    "highSeverityBand": {
      "allOf": [
        {"$ref": "#/$defs/severityBandBase"},
        {"properties": {"severity": {"const": "high"}, "label_tr": {"const": "Yüksek"}}}
      ]
    },
    "criticalSeverityBand": {
      "allOf": [
        {"$ref": "#/$defs/severityBandBase"},
        {"properties": {"severity": {"const": "critical"}, "label_tr": {"const": "Kritik"}}}
      ]
    },
    "semanticEvaluator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producer_id",
        "producer_version",
        "evidence_kind",
        "deterministic",
        "score_authority"
      ],
      "properties": {
        "producer_id": {
          "type": "string",
          "pattern": "^(?:gate|tool|validator):[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
        },
        "producer_version": {"$ref": "#/$defs/semver"},
        "evidence_kind": {"const": "policy-evaluation"},
        "deterministic": {"const": true},
        "score_authority": {"const": "evaluator-output-within-policy-band"}
      }
    },
    "securityCriticalVeto": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "authority",
        "covered_agents",
        "minimum_severity",
        "confidence_source",
        "decision",
        "reason_code"
      ],
      "properties": {
        "schema_version": {"const": "1.0"},
        "authority": {"const": "implementation-policy"},
        "covered_agents": {
          "type": "array",
          "const": ["agent:bilgi-guvenligi", "agent:uygulama-guvenligi", "agent:gizlilik-kvkk"]
        },
        "minimum_severity": {"const": "critical"},
        "confidence_source": {"const": "thresholds.confidence_floor"},
        "decision": {"const": "FAIL"},
        "reason_code": {"const": "AGG_SECURITY_CRITICAL_VETO"}
      }
    },
    "hardFailNonOverride": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "non_overridable_decisions",
        "covered_agent_namespaces",
        "covered_detector_namespaces",
        "allowed_resolution",
        "decision_override_changes_decision",
        "prompt_or_instruction_changes_decision",
        "human_approval_changes_decision",
        "risk_acceptance_changes_decision",
        "score_or_weight_changes_decision"
      ],
      "properties": {
        "schema_version": {"const": "1.0"},
        "non_overridable_decisions": {"const": ["HARD-FAIL"]},
        "covered_agent_namespaces": {
          "const": [
            "agent:bilgi-guvenligi",
            "agent:uygulama-guvenligi",
            "agent:gizlilik-kvkk"
          ]
        },
        "covered_detector_namespaces": {
          "const": [
            "detector:bilgi-guvenligi/",
            "detector:uygulama-guvenligi/",
            "detector:gizlilik-kvkk/"
          ]
        },
        "allowed_resolution": {"const": "remediate-and-rerun"},
        "decision_override_changes_decision": {"const": false},
        "prompt_or_instruction_changes_decision": {"const": false},
        "human_approval_changes_decision": {"const": false},
        "risk_acceptance_changes_decision": {"const": false},
        "score_or_weight_changes_decision": {"const": false}
      }
    },
    "sourceItemRef": {
      "type": "string",
      "pattern": "^governance-source:desktop-agents/supervisor/(?:agent\\.md|aggregation_policy\\.yaml)#[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "statement",
        "enforcement",
        "on_failure",
        "source_refs",
        "implementation_status",
        "projection_status",
        "runtime_admission"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^SUPERVISOR-[0-9]{3}$"},
        "statement": {
          "type": "string",
          "minLength": 20,
          "maxLength": 500,
          "pattern": "^(?!.*[\\r\\n]).*\\S.*$"
        },
        "enforcement": {
          "enum": ["instruction", "deterministic-policy", "human-gate"]
        },
        "on_failure": {"const": "manual-review"},
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/sourceItemRef"}
        },
        "implementation_status": {
          "enum": ["implemented", "externally-enforced"]
        },
        "projection_status": {"const": "not-projectable"},
        "runtime_admission": {"const": "not-admitted"}
      }
    }
  }
}
