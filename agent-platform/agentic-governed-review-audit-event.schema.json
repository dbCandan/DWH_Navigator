{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kt:agent-platform:agentic-governed-review-audit-event:1.1",
  "title": "Faz 1 Agentic Yönetilen İnceleme Denetim Olayı",
  "description": "OTel'e sonradan eşlenebilen, makbuz ve karar kanıtı özetine bağlı, session ve turn bağı açık, korumalı çalışma zamanı üzerinde sıralı Faz 1 Agentic inceleme olayı. `event_sha256` kendi alanı hariç sıralı, küçültülmüş UTF-8 ve tek LF sonlu yük üzerinden hesaplanır.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "evidence_profile",
    "receipt_id",
    "project_id",
    "client_id",
    "prompt_session_id",
    "prompt_turn_id",
    "event",
    "chain_position",
    "event_canonicalization",
    "run_id",
    "trace_id",
    "span_id",
    "snapshot_sha256",
    "agentic_evaluator",
    "agent_id",
    "invocation_id",
    "status",
    "decision",
    "reason_code",
    "report_sha256",
    "decision_sha256",
    "decision_evidence_sha256",
    "receipt_sha256",
    "previous_event_sha256",
    "event_sha256",
    "native_result",
    "claim_boundary",
    "data_handling",
    "observed_at"
  ],
  "properties": {
    "schema_version": {"const": "1.1"},
    "kind": {"const": "AgenticGovernedReviewAuditEvent"},
    "evidence_profile": {"const": "phase1-agentic-advisory"},
    "receipt_id": {"$ref": "#/$defs/correlationId"},
    "project_id": {"type": "string", "pattern": "^project-[0-9a-f]{32}$"},
    "prompt_session_id": {"type": "string", "pattern": "^session:(client\\.[0-9a-f]{64}|local\\.(?!0{32}$)[0-9a-f]{32})$"},
    "prompt_turn_id": {"type": "string", "pattern": "^turn:(client\\.[0-9a-f]{64}|local\\.(?!0{32}$)[0-9a-f]{32})$"},
    "client_id": {"enum": ["claude-code", "codex", "cursor", "github-copilot-vscode"]},
    "event": {
      "enum": ["review_started", "agent_completed", "review_completed"]
    },
    "chain_position": {"type": "integer", "minimum": 0, "maximum": 13},
    "event_canonicalization": {"const": "kt-agentic-review-audit-event-json-v1"},
    "run_id": {"$ref": "#/$defs/runId"},
    "trace_id": {"$ref": "#/$defs/traceId"},
    "span_id": {"$ref": "#/$defs/spanId"},
    "snapshot_sha256": {"$ref": "#/$defs/sha256"},
    "agentic_evaluator": {"$ref": "#/$defs/agenticEvaluatorBinding"},
    "agent_id": {
      "oneOf": [
        {"type": "string", "pattern": "^agent:[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
        {"type": "null"}
      ]
    },
    "invocation_id": {
      "oneOf": [{"$ref": "#/$defs/correlationId"}, {"type": "null"}]
    },
    "status": {
      "oneOf": [
        {"enum": ["ok", "failed", "timeout", "invalid"]},
        {"type": "null"}
      ]
    },
    "decision": {
      "oneOf": [
        {"enum": ["PASS", "FAIL", "HARD-FAIL", "BLOCKED_INCOMPLETE"]},
        {"type": "null"}
      ]
    },
    "reason_code": {
      "oneOf": [
        {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"},
        {"type": "null"}
      ]
    },
    "report_sha256": {
      "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
    },
    "decision_sha256": {
      "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
    },
    "decision_evidence_sha256": {"$ref": "#/$defs/sha256"},
    "receipt_sha256": {"$ref": "#/$defs/sha256"},
    "previous_event_sha256": {"$ref": "#/$defs/sha256"},
    "event_sha256": {"$ref": "#/$defs/sha256"},
    "native_result": {
      "oneOf": [
        {"enum": ["allow", "deny", "advisory", "unknown"]},
        {"type": "null"}
      ]
    },
    "claim_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "immutable_audit",
        "otel_exported",
        "production_authority",
        "native_hook_result_recorded",
        "commit_retry_recorded"
      ],
      "properties": {
        "immutable_audit": {"const": false},
        "otel_exported": {"const": false},
        "production_authority": {"const": false},
        "native_hook_result_recorded": {"const": false},
        "commit_retry_recorded": {"const": false}
      }
    },
    "data_handling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw_prompt_stored", "source_content_stored", "pii_stored", "secret_stored"],
      "properties": {
        "raw_prompt_stored": {"const": false},
        "source_content_stored": {"const": false},
        "pii_stored": {"const": false},
        "secret_stored": {"const": false}
      }
    },
    "observed_at": {
      "type": "string",
      "format": "date-time",
      "description": "İlgili olayın gözlendiği UTC zamanıdır; dosyanın yazılma zamanı değildir. `review_started` uzman çağrılarından önce, `agent_completed` ilgili tamamlanma gözlendiğinde ve birincil değerlendirme başlamadan önce, `review_completed` çalıştırma makbuzu yazılıp doğrulandıktan sonra gözlenir. Denetim dosyası daha sonra yayımlanırken saklanan gerçek gözlem saatleri korunur; eksik saat geriye tahmin edilmez. Paralel ajan olayları tamamlanma gözlem sırasındadır; aynı UTC saniyesindeki eşit saatler geçerlidir."
    }
  },
  "allOf": [
    {
      "if": {"properties": {"event": {"const": "review_started"}}, "required": ["event"]},
      "then": {
        "properties": {
          "chain_position": {"const": 0},
          "agent_id": {"const": null},
          "invocation_id": {"const": null},
          "status": {"const": null},
          "decision": {"const": null},
          "reason_code": {"const": "REVIEW_STARTED"},
          "report_sha256": {"const": null},
          "decision_sha256": {"const": null},
          "native_result": {"const": null}
        }
      }
    },
    {
      "if": {"properties": {"event": {"const": "agent_completed"}}, "required": ["event"]},
      "then": {
        "properties": {
          "chain_position": {"minimum": 1, "maximum": 12},
          "agent_id": {"type": "string"},
          "invocation_id": {"$ref": "#/$defs/correlationId"},
          "status": {"enum": ["ok", "failed", "timeout", "invalid"]},
          "decision": {"const": null},
          "reason_code": {"type": "string"},
          "report_sha256": {"$ref": "#/$defs/sha256"},
          "decision_sha256": {"const": null},
          "native_result": {"const": null}
        }
      }
    },
    {
      "if": {"properties": {"event": {"const": "review_completed"}}, "required": ["event"]},
      "then": {
        "properties": {
          "chain_position": {"const": 13},
          "agent_id": {"const": null},
          "invocation_id": {"const": null},
          "status": {"const": null},
          "decision": {"enum": ["PASS", "FAIL", "HARD-FAIL", "BLOCKED_INCOMPLETE"]},
          "reason_code": {"type": "string"},
          "report_sha256": {"const": null},
          "decision_sha256": {"$ref": "#/$defs/sha256"},
          "native_result": {"const": null}
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "agenticEvaluatorBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_ref",
        "evaluator_id",
        "version",
        "sha256",
        "mode",
        "authority",
        "runtime_admission",
        "deterministic",
        "production_authority"
      ],
      "properties": {
        "policy_ref": {"const": "policy:governed-review-agentic-evaluation"},
        "evaluator_id": {"const": "evaluator:governed-review-agentic-phase1"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "mode": {"const": "code-policy-application"},
        "authority": {"const": "agentic-advisory"},
        "runtime_admission": {"const": false},
        "deterministic": {"const": false},
        "production_authority": {"const": false}
      }
    },
    "traceId": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "spanId": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "correlationId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "runId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 124,
      "pattern": "^run-[A-Za-z0-9][A-Za-z0-9._-]*$"
    }
  }
}
