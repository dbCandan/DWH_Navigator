{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kt:agent-platform:agent-migration-catalog:1.5",
  "title": "Yönetişim Ajanı Teslim Kataloğu",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "status", "as_of", "source_lineage", "projection", "roles"],
  "properties": {
    "schema_version": {"const": "1.5"},
    "kind": {"const": "GovernanceAgentCatalog"},
    "status": {"const": "implementation"},
    "as_of": {"const": "2026-10-05"},
    "source_lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locator",
        "source_manifest_ref",
        "source_authority",
        "mutation_allowed",
        "note"
      ],
      "properties": {
        "locator": {"const": "governance-source:desktop-agents"},
        "source_manifest_ref": {"const": "governance-source-manifest:desktop-agents-v1"},
        "source_authority": {"const": "governance-authoritative"},
        "mutation_allowed": {"const": false},
        "note": {"type": "string", "minLength": 20, "maxLength": 500}
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason"],
      "properties": {
        "status": {"enum": ["partially-implemented", "implemented"]},
        "reason": {"type": "string", "minLength": 20, "maxLength": 500}
      }
    },
    "roles": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/role"}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_role_id",
        "target_agent_id",
        "classification",
        "lifecycle",
        "local_discovery_status",
        "source_authority",
        "implementation_status",
        "projection_status",
        "runtime_admission",
        "status_reason",
        "risk_tier",
        "canonical_path"
      ],
      "properties": {
        "source_role_id": {"$ref": "#/$defs/id"},
        "target_agent_id": {
          "type": ["string", "null"],
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "classification": {
          "enum": [
            "custom-agent",
            "hybrid-agent-gate",
            "high-risk-agent",
            "deterministic-gate-with-agent-explainer",
            "deterministic-orchestrator",
            "isolated-execution-agent"
          ]
        },
        "lifecycle": {"enum": ["active", "draft", "deferred"]},
        "local_discovery_status": {"enum": ["available", "not-applicable"]},
        "source_authority": {"const": "governance-authoritative"},
        "implementation_status": {
          "enum": [
            "implemented",
            "partially-implemented",
            "implementation-pending",
            "externally-enforced"
          ]
        },
        "projection_status": {
          "enum": ["implemented", "blocked", "implementation-pending", "not-applicable"]
        },
        "runtime_admission": {"enum": ["admitted", "not-admitted", "denied"]},
        "status_reason": {"type": "string", "minLength": 20, "maxLength": 500},
        "risk_tier": {"enum": ["R0", "R1", "R2", "R3"]},
        "canonical_path": {
          "type": ["string", "null"],
          "pattern": "^(?:agents/[a-z][a-z0-9-]*|orchestrations/[a-z][a-z0-9-]*\\.yml)$"
        }
      }
    }
  }
}
