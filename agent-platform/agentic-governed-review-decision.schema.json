{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kt:agent-platform:agentic-governed-review-decision:1.0",
  "title": "Faz 1 Agentic Governed Review Kararı",
  "description": "Sıkı yapısal, değiştirilebilir ve kanonik karar yetkisi taşımayan Faz 1 Agentic karar kaydı; yerel kanıt-bütünlüğü kapısı şema, korelasyon, özet ve ayrık ikinci-geçiş eşitliğini doğrular fakat anlamsal toplama veya kararı yeniden hesaplamaz.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "evidence_profile",
    "receipt_id",
    "project_id",
    "run_id",
    "trace_id",
    "span_id",
    "evaluator_invocation_id",
    "snapshot_sha256",
    "aggregation_policy",
    "agentic_evaluator",
    "agent_statuses",
    "acceptance_criteria",
    "decision",
    "reason_codes",
    "rationale_summary",
    "weighted_risk_score_basis_points",
    "compliance_score_basis_points",
    "decision_evidence_sha256",
    "claim_boundary",
    "data_handling",
    "evaluation_started_at",
    "decided_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "kind": {"const": "AgenticGovernedReviewDecision"},
    "evidence_profile": {"const": "phase1-agentic-advisory"},
    "receipt_id": {"$ref": "#/$defs/correlationId"},
    "project_id": {"type": "string", "pattern": "^project-[0-9a-f]{32}$"},
    "run_id": {"$ref": "#/$defs/runId"},
    "trace_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "span_id": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "evaluator_invocation_id": {"$ref": "#/$defs/correlationId"},
    "snapshot_sha256": {"$ref": "#/$defs/sha256"},
    "aggregation_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "version", "sha256", "instructions_ref", "instructions_sha256"],
      "properties": {
        "ref": {"const": "policy:governed-review-aggregation"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "instructions_ref": {
          "const": "policies/aggregation/governed-review-instructions.md"
        },
        "instructions_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "agentic_evaluator": {"$ref": "#/$defs/agenticEvaluatorBinding"},
    "agent_statuses": {"$ref": "#/$defs/agentStatuses"},
    "acceptance_criteria": {"$ref": "#/$defs/acceptanceCriteria"},
    "decision": {"enum": ["PASS", "FAIL", "HARD-FAIL", "BLOCKED_INCOMPLETE"]},
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"}
    },
    "rationale_summary": {
      "type": "string",
      "minLength": 10,
      "maxLength": 500,
      "pattern": "^\\S(?:[^\\r\\n]*\\S)?$"
    },
    "weighted_risk_score_basis_points": {"type": "integer", "minimum": 0, "maximum": 10000},
    "compliance_score_basis_points": {"type": "integer", "minimum": 0, "maximum": 10000},
    "decision_evidence_sha256": {"$ref": "#/$defs/sha256"},
    "claim_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deterministic_decision",
        "canonical_conformance",
        "runtime_admission",
        "production_decision"
      ],
      "properties": {
        "deterministic_decision": {"const": false},
        "canonical_conformance": {"const": false},
        "runtime_admission": {"const": false},
        "production_decision": {"const": false}
      }
    },
    "data_handling": {"$ref": "#/$defs/dataHandling"},
    "evaluation_started_at": {"type": "string", "format": "date-time"},
    "decided_at": {
      "description": "Son karar yayımından önceki zorunlu mantıksal ikinci-geçiş doğrulamasının gözlenen UTC tamamlanma zamanıdır.",
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {"properties": {"decision": {"const": "PASS"}}, "required": ["decision"]},
      "then": {
        "properties": {
          "agent_statuses": {
            "properties": {
              "agent:gereksinim-kapsami": {"const": "ok"},
              "agent:kurumsal-mimari": {"const": "ok"},
              "agent:kod-kalitesi": {"const": "ok"},
              "agent:kod-inceleme": {"const": "ok"},
              "agent:bilgi-guvenligi": {"const": "ok"},
              "agent:uygulama-guvenligi": {"const": "ok"},
              "agent:acik-kaynak-lisansi": {"const": "ok"},
              "agent:gizlilik-kvkk": {"const": "ok"},
              "agent:test-otomasyonu": {"const": "ok"},
              "agent:dokumantasyon": {"const": "ok"},
              "agent:devops": {"const": "ok"},
              "agent:gozlemlenebilirlik": {"const": "ok"}
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "repositoryRelativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "pattern": "^(?!/)(?![A-Za-z]:/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)[^/]+(?:/[^/]+)*$"
    },
    "acceptanceCriteria": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criteria_id",
        "criteria_version",
        "path",
        "sha256",
        "lifecycle",
        "derived_from_application_code"
      ],
      "properties": {
        "criteria_id": {
          "type": "string",
          "pattern": "^criteria:[a-z][a-z0-9]*(?:[-.:][a-z0-9]+)*$"
        },
        "criteria_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "path": {"$ref": "#/$defs/repositoryRelativePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "lifecycle": {
          "description": "PRD'nin staged index'teki ilk `Status:` satırı: `Accepted` için `accepted-frozen`, `Draft` için `draft`. Taslak kriter incelemeyi ve commit'i engellemez; kanonik GovernanceAssessmentReport yalnız `accepted-frozen` kabul eder.",
          "enum": ["accepted-frozen", "draft"]
        },
        "derived_from_application_code": {"const": false}
      }
    },
    "agenticEvaluatorBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_ref",
        "evaluator_id",
        "version",
        "sha256",
        "mode",
        "authority",
        "runtime_admission",
        "deterministic",
        "production_authority"
      ],
      "properties": {
        "policy_ref": {"const": "policy:governed-review-agentic-evaluation"},
        "evaluator_id": {"const": "evaluator:governed-review-agentic-phase1"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "mode": {"const": "code-policy-application"},
        "authority": {"const": "agentic-advisory"},
        "runtime_admission": {"const": false},
        "deterministic": {"const": false},
        "production_authority": {"const": false}
      }
    },
    "correlationId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "runId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 124,
      "pattern": "^run-[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "status": {"enum": ["ok", "failed", "timeout", "invalid"]},
    "agentStatuses": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent:gereksinim-kapsami",
        "agent:kurumsal-mimari",
        "agent:kod-kalitesi",
        "agent:kod-inceleme",
        "agent:bilgi-guvenligi",
        "agent:uygulama-guvenligi",
        "agent:acik-kaynak-lisansi",
        "agent:gizlilik-kvkk",
        "agent:test-otomasyonu",
        "agent:dokumantasyon",
        "agent:devops",
        "agent:gozlemlenebilirlik"
      ],
      "properties": {
        "agent:gereksinim-kapsami": {"$ref": "#/$defs/status"},
        "agent:kurumsal-mimari": {"$ref": "#/$defs/status"},
        "agent:kod-kalitesi": {"$ref": "#/$defs/status"},
        "agent:kod-inceleme": {"$ref": "#/$defs/status"},
        "agent:bilgi-guvenligi": {"$ref": "#/$defs/status"},
        "agent:uygulama-guvenligi": {"$ref": "#/$defs/status"},
        "agent:acik-kaynak-lisansi": {"$ref": "#/$defs/status"},
        "agent:gizlilik-kvkk": {"$ref": "#/$defs/status"},
        "agent:test-otomasyonu": {"$ref": "#/$defs/status"},
        "agent:dokumantasyon": {"$ref": "#/$defs/status"},
        "agent:devops": {"$ref": "#/$defs/status"},
        "agent:gozlemlenebilirlik": {"$ref": "#/$defs/status"}
      }
    },
    "dataHandling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw_prompt_stored", "source_content_stored", "pii_stored", "secret_stored"],
      "properties": {
        "raw_prompt_stored": {"const": false},
        "source_content_stored": {"const": false},
        "pii_stored": {"const": false},
        "secret_stored": {"const": false}
      }
    }
  }
}
