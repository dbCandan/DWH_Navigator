{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kt:agent-platform:agentic-governance-observation:1.1",
  "title": "Faz 1 Agentic Yönetişim Gözlemi",
  "description": "Bir istemci LLM'inin ürettiği, kanonik veya belirlenimci kanıt yetkisi taşımayan ajan gözlemi.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "evidence_profile",
    "receipt_id",
    "project_id",
    "agent_id",
    "run_id",
    "trace_id",
    "span_id",
    "invocation_id",
    "snapshot_sha256",
    "agentic_evaluator",
    "status",
    "component_binding",
    "acceptance_criteria",
    "findings",
    "scanned_files",
    "error_code",
    "error_summary",
    "claim_boundary",
    "data_handling"
  ],
  "properties": {
    "schema_version": {"const": "1.1"},
    "kind": {"const": "AgenticGovernanceObservation"},
    "evidence_profile": {"const": "phase1-agentic-advisory"},
    "receipt_id": {"$ref": "#/$defs/correlationId"},
    "project_id": {"$ref": "#/$defs/projectId"},
    "agent_id": {"$ref": "#/$defs/agentRef"},
    "run_id": {"$ref": "#/$defs/runId"},
    "trace_id": {"$ref": "#/$defs/traceId"},
    "span_id": {"$ref": "#/$defs/spanId"},
    "invocation_id": {"$ref": "#/$defs/correlationId"},
    "snapshot_sha256": {"$ref": "#/$defs/sha256"},
    "agentic_evaluator": {"$ref": "#/$defs/agenticEvaluatorBinding"},
    "status": {"enum": ["ok", "failed", "timeout", "invalid"]},
    "component_binding": {"$ref": "#/$defs/componentBinding"},
    "acceptance_criteria": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/acceptanceCriteria"}
      ]
    },
    "findings": {
      "type": "array",
      "maxItems": 128,
      "items": {"$ref": "#/$defs/finding"}
    },
    "scanned_files": {
      "type": "array",
      "maxItems": 4096,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/repositoryRelativePath"}
    },
    "error_code": {
      "type": ["string", "null"],
      "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
    },
    "error_summary": {
      "type": ["string", "null"],
      "minLength": 10,
      "maxLength": 300,
      "pattern": "^\\S(?:[^\\r\\n]*\\S)?$"
    },
    "claim_boundary": {"$ref": "#/$defs/claimBoundary"},
    "data_handling": {"$ref": "#/$defs/dataHandling"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"agent_id": {"const": "agent:test-otomasyonu"}},
        "required": ["agent_id"]
      },
      "then": {"properties": {"acceptance_criteria": {"$ref": "#/$defs/acceptanceCriteria"}}},
      "else": {"properties": {"acceptance_criteria": {"type": "null"}}}
    },
    {
      "if": {"properties": {"status": {"const": "ok"}}, "required": ["status"]},
      "then": {
        "properties": {
          "error_code": {"const": null},
          "error_summary": {"const": null}
        }
      },
      "else": {
        "properties": {
          "findings": {"maxItems": 0},
          "error_code": {"type": "string"},
          "error_summary": {"type": "string"}
        }
      }
    }
  ],
  "$defs": {
    "agentRef": {
      "enum": [
        "agent:gereksinim-kapsami",
        "agent:kurumsal-mimari",
        "agent:kod-kalitesi",
        "agent:kod-inceleme",
        "agent:bilgi-guvenligi",
        "agent:uygulama-guvenligi",
        "agent:acik-kaynak-lisansi",
        "agent:gizlilik-kvkk",
        "agent:test-otomasyonu",
        "agent:dokumantasyon",
        "agent:devops",
        "agent:gozlemlenebilirlik"
      ]
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "acceptanceCriteria": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criteria_id",
        "criteria_version",
        "path",
        "sha256",
        "lifecycle",
        "derived_from_application_code"
      ],
      "properties": {
        "criteria_id": {
          "type": "string",
          "pattern": "^criteria:[a-z][a-z0-9]*(?:[-.:][a-z0-9]+)*$"
        },
        "criteria_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "path": {"$ref": "#/$defs/repositoryRelativePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "lifecycle": {
          "description": "PRD'nin staged index'teki ilk `Status:` satırı: `Accepted` için `accepted-frozen`, `Draft` için `draft`. Taslak kriter incelemeyi ve commit'i engellemez; kanonik GovernanceAssessmentReport yalnız `accepted-frozen` kabul eder.",
          "enum": ["accepted-frozen", "draft"]
        },
        "derived_from_application_code": {"const": false}
      }
    },
    "traceId": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "spanId": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "correlationId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "runId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 124,
      "pattern": "^run-[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "projectId": {"type": "string", "pattern": "^project-[0-9a-f]{32}$"},
    "agenticEvaluatorBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_ref",
        "evaluator_id",
        "version",
        "sha256",
        "mode",
        "authority",
        "runtime_admission",
        "deterministic",
        "production_authority"
      ],
      "properties": {
        "policy_ref": {"const": "policy:governed-review-agentic-evaluation"},
        "evaluator_id": {"const": "evaluator:governed-review-agentic-phase1"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "mode": {"const": "code-policy-application"},
        "authority": {"const": "agentic-advisory"},
        "runtime_admission": {"const": false},
        "deterministic": {"const": false},
        "production_authority": {"const": false}
      }
    },
    "versionOrUnavailable": {
      "oneOf": [
        {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        {"const": "unavailable"}
      ]
    },
    "versionedDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "sha256"],
      "properties": {
        "version": {"$ref": "#/$defs/versionOrUnavailable"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "projectionBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["client_id", "path", "version", "sha256"],
      "properties": {
        "client_id": {
          "enum": ["claude-code", "codex", "cursor", "github-copilot-vscode"]
        },
        "path": {"$ref": "#/$defs/repositoryRelativePath"},
        "version": {"$ref": "#/$defs/versionOrUnavailable"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "componentBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent", "policy", "detectors", "instructions", "projection"],
      "properties": {
        "agent": {"$ref": "#/$defs/versionedDigest"},
        "policy": {"$ref": "#/$defs/versionedDigest"},
        "detectors": {"$ref": "#/$defs/versionedDigest"},
        "instructions": {"$ref": "#/$defs/versionedDigest"},
        "projection": {"$ref": "#/$defs/projectionBinding"}
      }
    },
    "repositoryRelativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "pattern": "^(?!/)(?![A-Za-z]:/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)[^/]+(?:/[^/]+)*$"
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "start_line", "end_line"],
      "properties": {
        "path": {"$ref": "#/$defs/repositoryRelativePath"},
        "start_line": {"type": "integer", "minimum": 1},
        "end_line": {"type": "integer", "minimum": 1}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "title",
        "controls",
        "classification_basis",
        "severity",
        "source",
        "locations",
        "evidence_summary",
        "confidence",
        "hard_fail_binding"
      ],
      "properties": {
        "finding_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "title": {"type": "string", "minLength": 3, "maxLength": 200},
        "controls": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/control"}
        },
        "classification_basis": {
          "enum": ["agentic-semantic", "canonical-detector"]
        },
        "severity": {"enum": ["info", "low", "medium", "high", "critical"]},
        "source": {"type": "string", "minLength": 3, "maxLength": 200},
        "locations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {"$ref": "#/$defs/location"}
        },
        "evidence_summary": {
          "type": "string",
          "minLength": 10,
          "maxLength": 500,
          "pattern": "^\\S(?:[^\\r\\n]*\\S)?$"
        },
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "hard_fail_binding": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "authority",
                "canonicalization",
                "detector_id",
                "detector_pack_sha256",
                "policy_ref",
                "policy_sha256",
                "evidence_sha256"
              ],
              "properties": {
                "authority": {
                  "const": "canonical-detector-source-policy-and-evidence"
                },
                "canonicalization": {
                  "const": "kt-agentic-hard-fail-evidence-json-v1"
                },
                "detector_id": {
                  "type": "string",
                  "pattern": "^detector:[a-z][a-z0-9]*(?:-[a-z0-9]+)*/[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
                },
                "detector_pack_sha256": {"$ref": "#/$defs/sha256"},
                "policy_ref": {
                  "type": "string",
                  "pattern": "^policy:[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
                },
                "policy_sha256": {"$ref": "#/$defs/sha256"},
                "evidence_sha256": {"$ref": "#/$defs/sha256"}
              }
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"classification_basis": {"const": "agentic-semantic"}},
            "required": ["classification_basis"]
          },
          "then": {"properties": {"hard_fail_binding": {"const": null}}}
        },
        {
          "if": {
            "properties": {"hard_fail_binding": {"type": "object"}},
            "required": ["hard_fail_binding"]
          },
          "then": {
            "properties": {
              "classification_basis": {"const": "canonical-detector"},
              "source": {
                "pattern": "^detector:[a-z][a-z0-9]*(?:-[a-z0-9]+)*/[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
              }
            }
          }
        }
      ]
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["standard_id", "control_id", "version"],
      "properties": {
        "standard_id": {
          "type": "string",
          "pattern": "^[A-Z0-9][A-Z0-9._/-]{1,63}$"
        },
        "control_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,95}$"
        },
        "version": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+){1,3}$"}
      }
    },
    "claimBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deterministic_evidence",
        "canonical_conformance",
        "runtime_admission",
        "production_decision",
        "immutable_audit"
      ],
      "properties": {
        "deterministic_evidence": {"const": false},
        "canonical_conformance": {"const": false},
        "runtime_admission": {"const": false},
        "production_decision": {"const": false},
        "immutable_audit": {"const": false}
      }
    },
    "dataHandling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw_prompt_stored", "source_content_stored", "pii_stored", "secret_stored"],
      "properties": {
        "raw_prompt_stored": {"const": false},
        "source_content_stored": {"const": false},
        "pii_stored": {"const": false},
        "secret_stored": {"const": false}
      }
    }
  }
}
