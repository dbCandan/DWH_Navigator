{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kt:agent-platform:deterministic-orchestration:1.1",
  "title": "Deterministik Ajan Orkestrasyonu",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "metadata",
    "input",
    "agents",
    "execution",
    "decision",
    "output",
    "prohibited_agents"
  ],
  "properties": {
    "schema_version": {"const": "1.1"},
    "kind": {"const": "DeterministicOrchestration"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "owner", "lifecycle", "risk_tier"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "version": {"$ref": "#/$defs/semver"},
        "owner": {"$ref": "#/$defs/ownerRef"},
        "lifecycle": {"const": "draft"},
        "risk_tier": {"const": "R1"}
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "raw_source_visible_to_aggregator"],
      "properties": {
        "contract": {"const": "schema:review-request"},
        "raw_source_visible_to_aggregator": {"const": false}
      }
    },
    "agents": {
      "type": "array",
      "const": [
        {"agent": "agent:gereksinim-kapsami", "required": true, "output_contract": "schema:governance-assessment-report-v1-2"},
        {"agent": "agent:kurumsal-mimari", "required": true, "output_contract": "schema:governance-assessment-report-v1-2"},
        {"agent": "agent:kod-kalitesi", "required": true, "output_contract": "schema:governance-assessment-report-v1-2"},
        {"agent": "agent:kod-inceleme", "required": true, "output_contract": "schema:governance-assessment-report-v1-2"},
        {"agent": "agent:bilgi-guvenligi", "required": true, "output_contract": "schema:governance-assessment-report-v1-2"},
        {"agent": "agent:uygulama-guvenligi", "required": true, "output_contract": "schema:governance-assessment-report-v1-2"},
        {"agent": "agent:acik-kaynak-lisansi", "required": true, "output_contract": "schema:governance-assessment-report-v1-2"},
        {"agent": "agent:gizlilik-kvkk", "required": true, "output_contract": "schema:governance-assessment-report-v1-2"},
        {"agent": "agent:test-otomasyonu", "required": true, "output_contract": "schema:governance-assessment-report-v1-2"},
        {"agent": "agent:dokumantasyon", "required": true, "output_contract": "schema:governance-assessment-report-v1-2"},
        {"agent": "agent:devops", "required": true, "output_contract": "schema:governance-assessment-report-v1-2"},
        {"agent": "agent:gozlemlenebilirlik", "required": true, "output_contract": "schema:governance-assessment-report-v1-2"}
      ]
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "max_parallel", "agent_isolation", "retries"],
      "properties": {
        "strategy": {"const": "parallel-independent"},
        "max_parallel": {"const": 12},
        "agent_isolation": {"const": true},
        "retries": {"const": 0}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine",
        "policy_ref",
        "verify_result_integrity",
        "missing_result",
        "failed_result",
        "invalid_result"
      ],
      "properties": {
        "engine": {"const": "deterministic-policy"},
        "policy_ref": {"const": "policy:governed-review-aggregation"},
        "verify_result_integrity": {"const": true},
        "missing_result": {"const": "BLOCKED_INCOMPLETE"},
        "failed_result": {"const": "BLOCKED_INCOMPLETE"},
        "invalid_result": {"const": "BLOCKED_INCOMPLETE"}
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "audit_required"],
      "properties": {
        "contract": {"const": "schema:governed-review-decision"},
        "audit_required": {"const": true}
      }
    },
    "prohibited_agents": {
      "type": "array",
      "const": ["agent:otomatik-duzeltme", "agent:supervisor"]
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
    "semver": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "ownerRef": {"type": "string", "pattern": "^(?:team|person):[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
    "agentRef": {"type": "string", "pattern": "^agent:[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"}
  }
}
