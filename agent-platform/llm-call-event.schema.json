{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "llm-call-event.schema.json",
  "title": "LLMCallEvent",
  "description": "Mevcut oturum ve tur kimliklerine bağlı, ham içerik taşımayan yerel yaşam döngüsü gözlemi. Sağlayıcı isteklerinin veya dahili tekrarların eksiksiz gözlendiğini iddia etmez. Araç ve istemci hataları, gözlenen model API hatalarından ayrılır.",
  "$comment": "Native adapter references verified 2026-09-15: https://code.claude.com/docs/en/hooks ; https://code.visualstudio.com/docs/agents/reference/hooks-reference ; https://cursor.com/docs/hooks . Codex adapts only the existing UserPromptSubmit envelope.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "project_id",
    "client_id",
    "event_id",
    "invocation_id",
    "observed_at",
    "prompt_session_id",
    "prompt_session_id_source",
    "prompt_turn_id",
    "prompt_turn_id_source",
    "agent_ref",
    "native_call_ref",
    "native_call_ref_source",
    "hook_event_name",
    "evidence_scope",
    "call_scope",
    "status",
    "error",
    "duration_ms",
    "raw_content_recorded",
    "complete_llm_attempt_coverage",
    "run_id",
    "trace_context",
    "model"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "kind": {"const": "LLMCallEvent"},
    "project_id": {"type": "string", "pattern": "^project-(?!0{32}$)[0-9a-f]{32}$"},
    "client_id": {"enum": ["claude-code", "codex", "github-copilot-vscode", "cursor"]},
    "event_id": {"type": "string", "pattern": "^event:(?!0{32}$)[0-9a-f]{32}$"},
    "invocation_id": {"type": "string", "pattern": "^invocation:(?!0{32}$)[0-9a-f]{32}$"},
    "observed_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    },
    "prompt_session_id": {
      "type": "string",
      "pattern": "^session:(?:client\\.[0-9a-f]{64}|local\\.(?!0{32}$)[0-9a-f]{32})$"
    },
    "prompt_session_id_source": {"enum": ["client-envelope", "local-generated-client-unavailable"]},
    "prompt_turn_id": {"type": "string", "pattern": "^turn:(?:client\\.[0-9a-f]{64}|local\\.(?!0{32}$)[0-9a-f]{32})$"},
    "prompt_turn_id_source": {"enum": ["client-envelope", "local-generated-client-unavailable"]},
    "agent_ref": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^agent:sha256:[0-9a-f]{64}$"}]},
    "native_call_ref": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^call:sha256:[0-9a-f]{64}$"}]},
    "native_call_ref_source": {"enum": ["tool_use_id", "tool_call_id", "request_id", "unavailable"]},
    "hook_event_name": {
      "enum": [
        "UserPromptSubmit",
        "Stop",
        "StopFailure",
        "SubagentStart",
        "SubagentStop",
        "PreToolUse",
        "PostToolUse",
        "PostToolUseFailure",
        "beforeSubmitPrompt",
        "stop",
        "subagentStart",
        "subagentStop",
        "preToolUse",
        "postToolUse",
        "postToolUseFailure"
      ]
    },
    "evidence_scope": {"enum": ["prompt-submission", "turn-lifecycle", "subagent-lifecycle", "tool-lifecycle"]},
    "call_scope": {"enum": ["main", "subagent"]},
    "status": {"enum": ["started", "completed", "failed", "cancelled"]},
    "error": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/error"}]},
    "duration_ms": {"type": ["integer", "null"], "minimum": 0, "maximum": 604800000},
    "raw_content_recorded": {"const": false},
    "complete_llm_attempt_coverage": {"const": false},
    "run_id": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^run:(?!0{32}$)[0-9a-f]{32}$"}]},
    "trace_context": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/traceContext"}]},
    "model": {"$ref": "#/$defs/observedModel"}
  },
  "oneOf": [
    {
      "properties": {
        "client_id": {"enum": ["claude-code", "github-copilot-vscode", "codex"]},
        "hook_event_name": {"enum": ["UserPromptSubmit"]},
        "status": {"enum": ["started"]},
        "evidence_scope": {"const": "prompt-submission"},
        "error": {"type": "null"}
      }
    },
    {
      "properties": {
        "client_id": {"enum": ["cursor"]},
        "hook_event_name": {"enum": ["beforeSubmitPrompt"]},
        "status": {"enum": ["started"]},
        "evidence_scope": {"const": "prompt-submission"},
        "error": {"type": "null"}
      }
    },
    {
      "properties": {
        "client_id": {"enum": ["claude-code", "github-copilot-vscode"]},
        "hook_event_name": {"enum": ["SubagentStart"]},
        "status": {"enum": ["started"]},
        "evidence_scope": {"const": "subagent-lifecycle"},
        "error": {"type": "null"}
      }
    },
    {
      "properties": {
        "client_id": {"enum": ["cursor"]},
        "hook_event_name": {"enum": ["subagentStart"]},
        "status": {"enum": ["started"]},
        "evidence_scope": {"const": "subagent-lifecycle"},
        "error": {"type": "null"}
      }
    },
    {
      "properties": {
        "client_id": {"enum": ["claude-code", "github-copilot-vscode"]},
        "hook_event_name": {"enum": ["PreToolUse"]},
        "status": {"enum": ["started"]},
        "evidence_scope": {"const": "tool-lifecycle"},
        "error": {"type": "null"}
      }
    },
    {
      "properties": {
        "client_id": {"enum": ["cursor"]},
        "hook_event_name": {"enum": ["preToolUse"]},
        "status": {"enum": ["started"]},
        "evidence_scope": {"const": "tool-lifecycle"},
        "error": {"type": "null"}
      }
    },
    {
      "properties": {
        "client_id": {"enum": ["claude-code", "github-copilot-vscode"]},
        "hook_event_name": {"enum": ["PostToolUse"]},
        "status": {"enum": ["completed"]},
        "evidence_scope": {"const": "tool-lifecycle"},
        "error": {"type": "null"}
      }
    },
    {
      "properties": {
        "client_id": {"enum": ["cursor"]},
        "hook_event_name": {"enum": ["postToolUse"]},
        "status": {"enum": ["completed"]},
        "evidence_scope": {"const": "tool-lifecycle"},
        "error": {"type": "null"}
      }
    },
    {
      "properties": {
        "client_id": {"enum": ["claude-code", "github-copilot-vscode"]},
        "hook_event_name": {"enum": ["Stop"]},
        "status": {"enum": ["completed"]},
        "evidence_scope": {"const": "turn-lifecycle"},
        "error": {"type": "null"}
      }
    },
    {
      "properties": {
        "client_id": {"enum": ["claude-code", "github-copilot-vscode"]},
        "hook_event_name": {"enum": ["SubagentStop"]},
        "status": {"enum": ["completed"]},
        "evidence_scope": {"const": "subagent-lifecycle"},
        "error": {"type": "null"}
      }
    },
    {
      "properties": {
        "client_id": {"enum": ["claude-code"]},
        "hook_event_name": {"enum": ["StopFailure"]},
        "status": {"enum": ["failed"]},
        "evidence_scope": {"const": "turn-lifecycle"},
        "error": {
          "type": "object",
          "properties": {
            "origin": {"const": "llm-api"},
            "class": {
              "enum": [
                "authentication",
                "authorization",
                "billing",
                "invalid-request",
                "model-unavailable",
                "output-limit",
                "overloaded",
                "provider-error",
                "rate-limit",
                "unknown"
              ]
            }
          }
        }
      }
    },
    {
      "properties": {
        "client_id": {"enum": ["claude-code"]},
        "hook_event_name": {"enum": ["PostToolUseFailure"]},
        "status": {"enum": ["failed"]},
        "evidence_scope": {"const": "tool-lifecycle"},
        "error": {
          "type": "object",
          "properties": {"origin": {"const": "tool"}, "class": {"enum": ["tool-error"]}}
        }
      }
    },
    {
      "properties": {
        "client_id": {"enum": ["cursor"]},
        "hook_event_name": {"enum": ["postToolUseFailure"]},
        "status": {"enum": ["failed"]},
        "evidence_scope": {"const": "tool-lifecycle"},
        "error": {
          "type": "object",
          "properties": {
            "origin": {"const": "tool"},
            "class": {"enum": ["tool-error", "timeout", "permission-denied"]}
          }
        }
      }
    },
    {
      "properties": {
        "client_id": {"enum": ["claude-code"]},
        "hook_event_name": {"enum": ["PostToolUseFailure"]},
        "status": {"enum": ["cancelled"]},
        "evidence_scope": {"const": "tool-lifecycle"},
        "error": {
          "type": "object",
          "properties": {"origin": {"const": "tool"}, "class": {"enum": ["cancelled"]}}
        }
      }
    },
    {
      "properties": {
        "client_id": {"enum": ["cursor"]},
        "hook_event_name": {"enum": ["postToolUseFailure"]},
        "status": {"enum": ["cancelled"]},
        "evidence_scope": {"const": "tool-lifecycle"},
        "error": {
          "type": "object",
          "properties": {"origin": {"const": "tool"}, "class": {"enum": ["cancelled"]}}
        }
      }
    },
    {
      "properties": {
        "client_id": {"enum": ["cursor"]},
        "hook_event_name": {"enum": ["stop"]},
        "status": {"enum": ["completed"]},
        "evidence_scope": {"const": "turn-lifecycle"},
        "error": {"type": "null"}
      }
    },
    {
      "properties": {
        "client_id": {"enum": ["cursor"]},
        "hook_event_name": {"enum": ["stop"]},
        "status": {"enum": ["failed"]},
        "evidence_scope": {"const": "turn-lifecycle"},
        "error": {
          "type": "object",
          "properties": {"origin": {"const": "client-unspecified"}, "class": {"enum": ["unknown"]}}
        }
      }
    },
    {
      "properties": {
        "client_id": {"enum": ["cursor"]},
        "hook_event_name": {"enum": ["stop"]},
        "status": {"enum": ["cancelled"]},
        "evidence_scope": {"const": "turn-lifecycle"},
        "error": {
          "type": "object",
          "properties": {"origin": {"const": "client-unspecified"}, "class": {"enum": ["cancelled"]}}
        }
      }
    },
    {
      "properties": {
        "client_id": {"enum": ["cursor"]},
        "hook_event_name": {"enum": ["subagentStop"]},
        "status": {"enum": ["completed"]},
        "evidence_scope": {"const": "subagent-lifecycle"},
        "error": {"type": "null"}
      }
    },
    {
      "properties": {
        "client_id": {"enum": ["cursor"]},
        "hook_event_name": {"enum": ["subagentStop"]},
        "status": {"enum": ["failed"]},
        "evidence_scope": {"const": "subagent-lifecycle"},
        "error": {
          "type": "object",
          "properties": {"origin": {"const": "client-unspecified"}, "class": {"enum": ["unknown"]}}
        }
      }
    },
    {
      "properties": {
        "client_id": {"enum": ["cursor"]},
        "hook_event_name": {"enum": ["subagentStop"]},
        "status": {"enum": ["cancelled"]},
        "evidence_scope": {"const": "subagent-lifecycle"},
        "error": {
          "type": "object",
          "properties": {"origin": {"const": "client-unspecified"}, "class": {"enum": ["cancelled"]}}
        }
      }
    }
  ],
  "allOf": [
    {
      "if": {"properties": {"prompt_session_id_source": {"const": "client-envelope"}}},
      "then": {
        "properties": {"prompt_session_id": {"type": "string", "pattern": "^session:client\\.[0-9a-f]{64}$"}}
      },
      "else": {
        "properties": {
          "prompt_session_id": {"type": "string", "pattern": "^session:local\\.(?!0{32}$)[0-9a-f]{32}$"}
        }
      }
    },
    {
      "if": {"properties": {"prompt_turn_id_source": {"const": "client-envelope"}}},
      "then": {
        "properties": {"prompt_turn_id": {"type": "string", "pattern": "^turn:client\\.[0-9a-f]{64}$"}}
      },
      "else": {
        "properties": {"prompt_turn_id": {"type": "string", "pattern": "^turn:local\\.(?!0{32}$)[0-9a-f]{32}$"}}
      }
    },
    {
      "if": {"properties": {"native_call_ref_source": {"const": "unavailable"}}},
      "then": {"properties": {"native_call_ref": {"type": "null"}}},
      "else": {"properties": {"native_call_ref": {"type": "string"}}}
    },
    {
      "if": {
        "anyOf": [
          {"properties": {"agent_ref": {"type": "string"}}},
          {
            "properties": {
              "hook_event_name": {"enum": ["SubagentStart", "SubagentStop", "subagentStart", "subagentStop"]}
            }
          }
        ]
      },
      "then": {"properties": {"call_scope": {"const": "subagent"}}},
      "else": {"properties": {"call_scope": {"const": "main"}}}
    },
    {
      "if": {
        "properties": {"hook_event_name": {"enum": ["SubagentStart", "SubagentStop", "subagentStart"]}}
      },
      "then": {"properties": {"agent_ref": {"type": "string"}}}
    },
    {
      "if": {"properties": {"run_id": {"type": "null"}}},
      "then": {"properties": {"trace_context": {"type": "null"}}},
      "else": {"properties": {"trace_context": {"type": "object"}}}
    }
  ],
  "$defs": {
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "summary", "origin"],
      "properties": {
        "class": {
          "enum": [
            "rate-limit",
            "overloaded",
            "authentication",
            "authorization",
            "billing",
            "invalid-request",
            "model-unavailable",
            "provider-error",
            "output-limit",
            "timeout",
            "permission-denied",
            "tool-error",
            "cancelled",
            "unknown"
          ]
        },
        "summary": {"type": "string"},
        "origin": {"enum": ["llm-api", "tool", "client-unspecified"]}
      },
      "oneOf": [
        {
          "properties": {
            "class": {"const": "rate-limit"},
            "summary": {"const": "The provider reported a rate limit."}
          }
        },
        {
          "properties": {
            "class": {"const": "overloaded"},
            "summary": {"const": "The provider reported unavailable capacity."}
          }
        },
        {
          "properties": {
            "class": {"const": "authentication"},
            "summary": {"const": "The provider rejected authentication."}
          }
        },
        {
          "properties": {
            "class": {"const": "authorization"},
            "summary": {"const": "The provider rejected authorization."}
          }
        },
        {
          "properties": {
            "class": {"const": "billing"},
            "summary": {"const": "The provider rejected account or billing state."}
          }
        },
        {
          "properties": {
            "class": {"const": "invalid-request"},
            "summary": {"const": "The provider rejected the request."}
          }
        },
        {
          "properties": {
            "class": {"const": "model-unavailable"},
            "summary": {"const": "The requested model was unavailable."}
          }
        },
        {
          "properties": {
            "class": {"const": "provider-error"},
            "summary": {"const": "The provider reported an API error."}
          }
        },
        {
          "properties": {
            "class": {"const": "output-limit"},
            "summary": {"const": "The provider reported an output limit."}
          }
        },
        {
          "properties": {"class": {"const": "timeout"}, "summary": {"const": "The observed operation timed out."}}
        },
        {
          "properties": {
            "class": {"const": "permission-denied"},
            "summary": {"const": "The observed operation was denied."}
          }
        },
        {
          "properties": {
            "class": {"const": "tool-error"},
            "summary": {"const": "The client reported a tool failure."}
          }
        },
        {
          "properties": {
            "class": {"const": "cancelled"},
            "summary": {"const": "The client reported cancellation."}
          }
        },
        {
          "properties": {
            "class": {"const": "unknown"},
            "summary": {"const": "The client reported a failure without a supported error classification."}
          }
        }
      ]
    },
    "traceContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "trace_id", "span_id", "parent_span_id", "trace_flags"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "trace_id": {"type": "string", "pattern": "^(?!0{32}$)[0-9a-f]{32}$"},
        "span_id": {"type": "string", "pattern": "^(?!0{16}$)[0-9a-f]{16}$"},
        "parent_span_id": {"type": ["string", "null"], "pattern": "^(?!0{16}$)[0-9a-f]{16}$"},
        "trace_flags": {"const": "01"}
      }
    },
    "observedModel": {
      "type": "object",
      "additionalProperties": false,
      "description": "İstemcinin bu olay için bildirdiği etkin model ve effort. Codex ve Cursor modeli kanca olayında, Claude Code oturum logunda bildirir; VS Code/Copilot bildirmez. Gözlenemeyen değer uydurulmaz.",
      "required": ["source", "id", "effort"],
      "properties": {
        "source": {"enum": ["native-event-observed", "client-log-observed", "unavailable"]},
        "id": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]{0,159}$"},
        "effort": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,39}$"}
      },
      "allOf": [
        {
          "if": {"properties": {"source": {"const": "unavailable"}}, "required": ["source"]},
          "then": {"properties": {"id": {"const": null}, "effort": {"const": null}}},
          "else": {"properties": {"id": {"type": "string"}}}
        }
      ]
    }
  }
}
