{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kt:agent-platform:local-governance-trace:1.0",
  "title": "Yerel Yönetişim İz Demeti",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "telemetry_profile",
    "audit_identity",
    "audit_identity_ref",
    "spans",
    "export_status",
    "collector_configured",
    "immutable_audit_storage"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "kind": {"const": "LocalGovernanceTraceBundle"},
    "telemetry_profile": {"const": "w3c-trace-context-1.0-otel-core"},
    "audit_identity": {
      "anyOf": [
        {"type": "null"},
        {"$ref": "#/$defs/auditIdentity"}
      ]
    },
    "audit_identity_ref": {
      "anyOf": [
        {"type": "null"},
        {"$ref": "#/$defs/auditIdentityRef"}
      ]
    },
    "spans": {
      "type": "array",
      "minItems": 2,
      "maxItems": 130,
      "items": {"$ref": "#/$defs/span"}
    },
    "export_status": {"const": "local-only"},
    "collector_configured": {"const": false},
    "immutable_audit_storage": {"const": false}
  },
  "allOf": [
    {
      "if": {
        "properties": {"audit_identity": {"type": "null"}}
      },
      "then": {
        "properties": {"audit_identity_ref": {"type": "null"}}
      },
      "else": {
        "properties": {"audit_identity_ref": {"$ref": "#/$defs/auditIdentityRef"}}
      }
    }
  ],
  "$defs": {
    "runId": {
      "type": "string",
      "pattern": "^run:[a-z0-9]+(?:[-.:][a-z0-9]+)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "auditIdentityRef": {
      "type": "string",
      "pattern": "^vibecoder-identity:sha256:[0-9a-f]{64}$"
    },
    "identitySafeText": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:[^\\u0000-\\u001F\\u007F-\\u009F\\u2028\\u2029\\uD800-\\uDFFF]*\\S)?$"
    },
    "identityClientId": {
      "allOf": [
        {"$ref": "#/$defs/identitySafeText"},
        {"maxLength": 80}
      ]
    },
    "identityDisplayName": {
      "allOf": [
        {"$ref": "#/$defs/identitySafeText"},
        {"maxLength": 200}
      ]
    },
    "identityEmail": {
      "type": "string",
      "minLength": 3,
      "maxLength": 320,
      "pattern": "^[^\\s@\\u0000-\\u001F\\u007F-\\u009F\\u2028\\u2029\\uD800-\\uDFFF]+@[^\\s@\\u0000-\\u001F\\u007F-\\u009F\\u2028\\u2029\\uD800-\\uDFFF]+$"
    },
    "identityAccountId": {
      "allOf": [
        {"$ref": "#/$defs/identitySafeText"},
        {"maxLength": 200}
      ]
    },
    "auditIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "client_id",
        "display_name",
        "email",
        "account_id",
        "source"
      ],
      "properties": {
        "schema_version": {"const": "1.0"},
        "kind": {"const": "VibecoderIdentity"},
        "client_id": {"$ref": "#/$defs/identityClientId"},
        "display_name": {
          "anyOf": [
            {"$ref": "#/$defs/identityDisplayName"},
            {"type": "null"}
          ]
        },
        "email": {
          "anyOf": [
            {"$ref": "#/$defs/identityEmail"},
            {"type": "null"}
          ]
        },
        "account_id": {
          "anyOf": [
            {"$ref": "#/$defs/identityAccountId"},
            {"type": "null"}
          ]
        },
        "source": {
          "enum": ["client-visible", "os-fallback", "git-fallback", "unavailable"]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"source": {"const": "client-visible"}}},
          "then": {
            "anyOf": [
              {"properties": {"display_name": {"$ref": "#/$defs/identityDisplayName"}}},
              {"properties": {"email": {"$ref": "#/$defs/identityEmail"}}},
              {"properties": {"account_id": {"$ref": "#/$defs/identityAccountId"}}}
            ]
          }
        },
        {
          "if": {"properties": {"source": {"const": "os-fallback"}}},
          "then": {
            "properties": {
              "display_name": {"$ref": "#/$defs/identityDisplayName"},
              "account_id": {"type": "null"}
            }
          }
        },
        {
          "if": {"properties": {"source": {"const": "git-fallback"}}},
          "then": {
            "properties": {
              "display_name": {"type": "null"},
              "email": {"$ref": "#/$defs/identityEmail"},
              "account_id": {"type": "null"}
            }
          }
        },
        {
          "if": {"properties": {"source": {"const": "unavailable"}}},
          "then": {
            "properties": {
              "display_name": {"type": "null"},
              "email": {"type": "null"},
              "account_id": {"type": "null"}
            }
          }
        }
      ]
    },
    "traceContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "trace_id", "span_id", "parent_span_id", "trace_flags"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "trace_id": {"type": "string", "pattern": "^(?!0{32}$)[0-9a-f]{32}$"},
        "span_id": {"type": "string", "pattern": "^(?!0{16}$)[0-9a-f]{16}$"},
        "parent_span_id": {
          "type": ["string", "null"],
          "pattern": "^(?!0{16}$)[0-9a-f]{16}$"
        },
        "trace_flags": {"type": "string", "pattern": "^[0-9a-f]{2}$"}
      }
    },
    "executionComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\r\\n]+$"
        },
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "clientComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_id", "version"],
      "properties": {
        "component_id": {
          "enum": ["claude-code", "codex", "cursor", "vscode", "copilot"]
        },
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
      }
    },
    "instructionBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "bundle_version",
        "instructions",
        "rules",
        "skills",
        "bundle_sha256"
      ],
      "properties": {
        "schema_version": {"const": "1.0"},
        "kind": {"const": "EffectiveInstructionBundle"},
        "bundle_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "instructions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {"$ref": "#/$defs/executionComponent"}
        },
        "rules": {
          "type": "array",
          "maxItems": 256,
          "items": {"$ref": "#/$defs/executionComponent"}
        },
        "skills": {
          "type": "array",
          "maxItems": 64,
          "items": {"$ref": "#/$defs/executionComponent"}
        },
        "bundle_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "executionComposition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "agent_id",
        "agent_version",
        "agent_identity_sha256",
        "contract",
        "projection",
        "registry_lock",
        "instruction_bundle",
        "policy_id",
        "policy_version",
        "policy",
        "provider",
        "resolved_model_id",
        "model_revision",
        "model_digest",
        "client_id",
        "client_version",
        "client_components",
        "evidence_scope",
        "production_runtime_proof",
        "composition_sha256"
      ],
      "properties": {
        "schema_version": {"const": "1.0"},
        "kind": {"const": "AgentExecutionComposition"},
        "agent_id": {
          "type": "string",
          "pattern": "^agent:[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "agent_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "agent_identity_sha256": {"$ref": "#/$defs/sha256"},
        "contract": {"$ref": "#/$defs/executionComponent"},
        "projection": {"$ref": "#/$defs/executionComponent"},
        "registry_lock": {"$ref": "#/$defs/executionComponent"},
        "instruction_bundle": {"$ref": "#/$defs/instructionBundle"},
        "policy_id": {
          "type": "string",
          "pattern": "^policy:[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "policy_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "policy": {"$ref": "#/$defs/executionComponent"},
        "provider": {
          "type": "string",
          "maxLength": 80,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "resolved_model_id": {
          "type": "string",
          "maxLength": 160,
          "pattern": "^[a-z][a-z0-9]*(?:[-.:/][a-z0-9]+)*$"
        },
        "model_revision": {
          "type": "string",
          "maxLength": 160,
          "pattern": "^[a-z0-9][a-z0-9]*(?:[-.:/][a-z0-9]+)*$"
        },
        "model_digest": {"$ref": "#/$defs/sha256"},
        "client_id": {
          "enum": ["codex", "claude-code", "github-copilot-vscode", "cursor"]
        },
        "client_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "client_components": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {"$ref": "#/$defs/clientComponent"}
        },
        "evidence_scope": {"const": "observer-supplied-local"},
        "production_runtime_proof": {"const": false},
        "composition_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "span_kind",
        "name",
        "run_id",
        "context",
        "started_at",
        "ended_at",
        "status",
        "prompt_session_id",
        "prompt_turn_id",
        "client_id",
        "agent_id",
        "agent_instance_id",
        "agent_version",
        "invocation_id",
        "agent_identity_sha256",
        "contract_sha256",
        "policy_sha256",
        "projection_sha256",
        "registry_lock_sha256",
        "execution_composition",
        "artifact_sha256",
        "observation_source",
        "production_runtime_proof",
        "gen_ai_semconv_mapping"
      ],
      "properties": {
        "schema_version": {"const": "1.0"},
        "span_kind": {"enum": ["trigger", "agent", "decision"]},
        "name": {"type": "string", "minLength": 1, "maxLength": 160},
        "run_id": {"$ref": "#/$defs/runId"},
        "context": {"$ref": "#/$defs/traceContext"},
        "started_at": {"type": "string", "format": "date-time"},
        "ended_at": {"type": "string", "format": "date-time"},
        "status": {"enum": ["ok", "failed", "timeout", "blocked"]},
        "prompt_session_id": {
          "type": ["string", "null"],
          "pattern": "^session:[a-z0-9]+(?:[-.:][a-z0-9]+)*$"
        },
        "prompt_turn_id": {
          "type": ["string", "null"],
          "pattern": "^turn:[a-z0-9]+(?:[-.:][a-z0-9]+)*$"
        },
        "client_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 80},
        "agent_id": {
          "type": ["string", "null"],
          "pattern": "^agent:[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "agent_instance_id": {
          "type": ["string", "null"],
          "pattern": "^agent-instance:[a-z0-9]+(?:[-.:][a-z0-9]+)*$"
        },
        "agent_version": {
          "type": ["string", "null"],
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "invocation_id": {
          "type": ["string", "null"],
          "pattern": "^invocation:[a-z0-9]+(?:[-.:][a-z0-9]+)*$"
        },
        "agent_identity_sha256": {
          "anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
        },
        "contract_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "policy_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "projection_sha256": {
          "anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
        },
        "registry_lock_sha256": {
          "anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
        },
        "execution_composition": {
          "anyOf": [{"$ref": "#/$defs/executionComposition"}, {"type": "null"}]
        },
        "artifact_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "observation_source": {"enum": ["agent-self-report", "client-host"]},
        "production_runtime_proof": {"const": false},
        "gen_ai_semconv_mapping": {"const": "development-2026-08"}
      },
      "allOf": [
        {
          "if": {"properties": {"span_kind": {"const": "agent"}}},
          "then": {"properties": {"execution_composition": {"$ref": "#/$defs/executionComposition"}}},
          "else": {"properties": {"execution_composition": {"type": "null"}}}
        }
      ]
    }
  }
}
