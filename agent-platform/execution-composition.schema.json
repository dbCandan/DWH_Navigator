{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kt.internal/schemas/agent-execution-composition-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "agent_id",
    "agent_version",
    "agent_identity_sha256",
    "contract",
    "projection",
    "registry_lock",
    "instruction_bundle",
    "policy_id",
    "policy_version",
    "policy",
    "provider",
    "resolved_model_id",
    "model_revision",
    "model_digest",
    "client_id",
    "client_version",
    "client_components",
    "evidence_scope",
    "production_runtime_proof",
    "composition_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "kind": {"const": "AgentExecutionComposition"},
    "agent_id": {"$ref": "#/$defs/agentId"},
    "agent_version": {"$ref": "#/$defs/semver"},
    "agent_identity_sha256": {"$ref": "#/$defs/sha256"},
    "contract": {"$ref": "#/$defs/component"},
    "projection": {"$ref": "#/$defs/component"},
    "registry_lock": {"$ref": "#/$defs/component"},
    "instruction_bundle": {"$ref": "#/$defs/instructionBundle"},
    "policy_id": {
      "type": "string",
      "pattern": "^policy:[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "policy_version": {"$ref": "#/$defs/semver"},
    "policy": {"$ref": "#/$defs/component"},
    "provider": {
      "type": "string",
      "maxLength": 80,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "resolved_model_id": {
      "type": "string",
      "maxLength": 160,
      "pattern": "^[a-z][a-z0-9]*(?:[-.:/][a-z0-9]+)*$"
    },
    "model_revision": {
      "type": "string",
      "maxLength": 160,
      "pattern": "^[a-z0-9][a-z0-9]*(?:[-.:/][a-z0-9]+)*$"
    },
    "model_digest": {"$ref": "#/$defs/sha256"},
    "client_id": {
      "enum": ["codex", "claude-code", "github-copilot-vscode", "cursor"]
    },
    "client_version": {"$ref": "#/$defs/semver"},
    "client_components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/clientComponent"}
    },
    "evidence_scope": {"const": "observer-supplied-local"},
    "production_runtime_proof": {"const": false},
    "composition_sha256": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {"properties": {"client_id": {"const": "claude-code"}}},
      "then": {
        "properties": {
          "client_components": {
            "prefixItems": [
              {
                "allOf": [
                  {"$ref": "#/$defs/clientComponent"},
                  {"properties": {"component_id": {"const": "claude-code"}}}
                ]
              }
            ],
            "items": false,
            "minItems": 1,
            "maxItems": 1
          }
        }
      }
    },
    {
      "if": {"properties": {"client_id": {"const": "codex"}}},
      "then": {
        "properties": {
          "client_components": {
            "prefixItems": [
              {
                "allOf": [
                  {"$ref": "#/$defs/clientComponent"},
                  {"properties": {"component_id": {"const": "codex"}}}
                ]
              }
            ],
            "items": false,
            "minItems": 1,
            "maxItems": 1
          }
        }
      }
    },
    {
      "if": {"properties": {"client_id": {"const": "cursor"}}},
      "then": {
        "properties": {
          "client_components": {
            "prefixItems": [
              {
                "allOf": [
                  {"$ref": "#/$defs/clientComponent"},
                  {"properties": {"component_id": {"const": "cursor"}}}
                ]
              }
            ],
            "items": false,
            "minItems": 1,
            "maxItems": 1
          }
        }
      }
    },
    {
      "if": {"properties": {"client_id": {"const": "github-copilot-vscode"}}},
      "then": {
        "properties": {
          "client_components": {
            "prefixItems": [
              {
                "allOf": [
                  {"$ref": "#/$defs/clientComponent"},
                  {"properties": {"component_id": {"const": "vscode"}}}
                ]
              },
              {
                "allOf": [
                  {"$ref": "#/$defs/clientComponent"},
                  {"properties": {"component_id": {"const": "copilot"}}}
                ]
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "semver": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "agentId": {
      "type": "string",
      "pattern": "^agent:[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\r\\n]+$"
        },
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "clientComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_id", "version"],
      "properties": {
        "component_id": {
          "enum": ["claude-code", "codex", "cursor", "vscode", "copilot"]
        },
        "version": {"$ref": "#/$defs/semver"}
      }
    },
    "instructionBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "bundle_version",
        "instructions",
        "rules",
        "skills",
        "bundle_sha256"
      ],
      "properties": {
        "schema_version": {"const": "1.0"},
        "kind": {"const": "EffectiveInstructionBundle"},
        "bundle_version": {"$ref": "#/$defs/semver"},
        "instructions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {"$ref": "#/$defs/component"}
        },
        "rules": {
          "type": "array",
          "maxItems": 256,
          "items": {"$ref": "#/$defs/component"}
        },
        "skills": {
          "type": "array",
          "maxItems": 64,
          "items": {"$ref": "#/$defs/component"}
        },
        "bundle_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
