{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kt:agent-platform:agentic-governed-review-decision-evidence:1.1",
  "title": "Faz 1 Agentic Governed Review Karar Kanıtı",
  "description": "Denetim bağlamını yeniden kurmak, özet zincirini doğrulamak ve karar ilkesini yeniden değerlendirmek için sıkı Faz 1 kaydı. Bit bit aynı model çıktısı, harici doğrulayıcı bağımsızlığı, değişmez denetim, uyum veya üretim yetkisi kanıtı değildir.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "evidence_profile",
    "canonicalization",
    "evidence_sha256",
    "audit_replay",
    "model_rerun",
    "data_handling"
  ],
  "properties": {
    "schema_version": {"const": "1.1"},
    "kind": {"const": "AgenticGovernedReviewDecisionEvidence"},
    "evidence_profile": {"const": "phase1-evidence-bound-accountable-replay"},
    "canonicalization": {"const": "kt-agentic-decision-evidence-json-v1"},
    "evidence_sha256": {"$ref": "#/$defs/sha256"},
    "audit_replay": {"$ref": "#/$defs/auditReplay"},
    "model_rerun": {"$ref": "#/$defs/modelRerun"},
    "data_handling": {"$ref": "#/$defs/dataHandling"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "correlationId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "runId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 124,
      "pattern": "^run-[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "traceId": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "spanId": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "projectId": {"type": "string", "pattern": "^project-[0-9a-f]{32}$"},
    "semanticVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "repositoryRelativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "pattern": "^(?!/)(?![A-Za-z]:/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)[^/]+(?:/[^/]+)*$"
    },
    "acceptanceCriteria": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criteria_id",
        "criteria_version",
        "path",
        "sha256",
        "lifecycle",
        "derived_from_application_code"
      ],
      "properties": {
        "criteria_id": {
          "type": "string",
          "pattern": "^criteria:[a-z][a-z0-9]*(?:[-.:][a-z0-9]+)*$"
        },
        "criteria_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "path": {"$ref": "#/$defs/repositoryRelativePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "lifecycle": {
          "description": "PRD'nin staged index'teki ilk `Status:` satırı: `Accepted` için `accepted-frozen`, `Draft` için `draft`. Taslak kriter incelemeyi ve commit'i engellemez; kanonik GovernanceAssessmentReport yalnız `accepted-frozen` kabul eder.",
          "enum": ["accepted-frozen", "draft"]
        },
        "derived_from_application_code": {"const": false}
      }
    },
    "reasonCodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"}
    },
    "versionedBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "version", "sha256"],
      "properties": {
        "ref": {"type": "string", "minLength": 3, "maxLength": 300},
        "version": {"$ref": "#/$defs/semanticVersion"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "manifestBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonicalization", "availability", "reason_code", "item_count", "sha256"],
      "properties": {
        "canonicalization": {
          "enum": [
            "kt-agentic-context-manifest-json-v1",
            "kt-agentic-retrieval-manifest-json-v1",
            "kt-agentic-tool-result-manifest-json-v1"
          ]
        },
        "availability": {"enum": ["available", "not-used", "unavailable"]},
        "reason_code": {
          "oneOf": [
            {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"},
            {"type": "null"}
          ]
        },
        "item_count": {"type": "integer", "minimum": 0, "maximum": 16384},
        "sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
      },
      "allOf": [
        {
          "if": {"properties": {"availability": {"const": "available"}}, "required": ["availability"]},
          "then": {
            "properties": {
              "reason_code": {"const": null},
              "item_count": {"minimum": 1},
              "sha256": {"$ref": "#/$defs/sha256"}
            }
          }
        },
        {
          "if": {"properties": {"availability": {"const": "not-used"}}, "required": ["availability"]},
          "then": {
            "properties": {
              "reason_code": {"const": "NOT_USED"},
              "item_count": {"const": 0},
              "sha256": {"$ref": "#/$defs/sha256"}
            }
          }
        },
        {
          "if": {"properties": {"availability": {"const": "unavailable"}}, "required": ["availability"]},
          "then": {
            "properties": {
              "reason_code": {"type": "string"},
              "item_count": {"const": 0},
              "sha256": {"const": null}
            }
          }
        }
      ]
    },
    "checkedDigestSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonicalization",
        "canonical_input_sha256",
        "snapshot_sha256",
        "authority_sha256",
        "orchestration_sha256",
        "aggregation_policy_sha256",
        "agentic_evaluator_sha256",
        "harness_sha256",
        "rule_sha256",
        "skill_sha256",
        "agent_manifest_sha256",
        "client_sha256",
        "prompt_template_sha256",
        "prompt_envelope_sha256",
        "context_manifest_sha256",
        "retrieval_manifest_sha256",
        "tool_result_manifest_sha256",
        "primary_evaluation_sha256"
      ],
      "properties": {
        "canonicalization": {"const": "kt-agentic-checked-digest-set-json-v1"},
        "canonical_input_sha256": {"$ref": "#/$defs/sha256"},
        "snapshot_sha256": {"$ref": "#/$defs/sha256"},
        "authority_sha256": {"$ref": "#/$defs/sha256"},
        "orchestration_sha256": {"$ref": "#/$defs/sha256"},
        "aggregation_policy_sha256": {"$ref": "#/$defs/sha256"},
        "agentic_evaluator_sha256": {"$ref": "#/$defs/sha256"},
        "harness_sha256": {"$ref": "#/$defs/sha256"},
        "rule_sha256": {"$ref": "#/$defs/sha256"},
        "skill_sha256": {"$ref": "#/$defs/sha256"},
        "agent_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "client_sha256": {"$ref": "#/$defs/sha256"},
        "prompt_template_sha256": {"$ref": "#/$defs/sha256"},
        "prompt_envelope_sha256": {"$ref": "#/$defs/sha256"},
        "context_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "retrieval_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "tool_result_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "primary_evaluation_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "decisionOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verdict",
        "reason_codes",
        "rationale_summary",
        "weighted_risk_score_basis_points",
        "compliance_score_basis_points"
      ],
      "properties": {
        "verdict": {"enum": ["PASS", "FAIL", "HARD-FAIL", "BLOCKED_INCOMPLETE"]},
        "reason_codes": {"$ref": "#/$defs/reasonCodes"},
        "rationale_summary": {
          "type": "string",
          "minLength": 10,
          "maxLength": 500,
          "pattern": "^\\S(?:[^\\r\\n]*\\S)?$"
        },
        "weighted_risk_score_basis_points": {"type": "integer", "minimum": 0, "maximum": 10000},
        "compliance_score_basis_points": {"type": "integer", "minimum": 0, "maximum": 10000}
      }
    },
    "primaryEvaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonicalization",
        "sha256",
        "invocation_id",
        "span_id",
        "started_at",
        "completed_at",
        "verdict",
        "reason_codes",
        "rationale_summary",
        "weighted_risk_score_basis_points",
        "compliance_score_basis_points"
      ],
      "properties": {
        "canonicalization": {"const": "kt-agentic-primary-evaluation-json-v1"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "invocation_id": {"$ref": "#/$defs/correlationId"},
        "span_id": {"$ref": "#/$defs/spanId"},
        "started_at": {"type": "string", "format": "date-time"},
        "completed_at": {"type": "string", "format": "date-time"},
        "verdict": {"enum": ["PASS", "FAIL", "HARD-FAIL", "BLOCKED_INCOMPLETE"]},
        "reason_codes": {"$ref": "#/$defs/reasonCodes"},
        "rationale_summary": {
          "type": "string",
          "minLength": 10,
          "maxLength": 500,
          "pattern": "^\\S(?:[^\\r\\n]*\\S)?$"
        },
        "weighted_risk_score_basis_points": {"type": "integer", "minimum": 0, "maximum": 10000},
        "compliance_score_basis_points": {"type": "integer", "minimum": 0, "maximum": 10000}
      }
    },
    "secondPassValidator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "validator_id",
        "version",
        "sha256",
        "method",
        "invocation_id",
        "span_id",
        "checked_digest_set",
        "checked_digest_set_sha256",
        "result",
        "recalculated",
        "matches_primary_evaluation",
        "claim_boundary",
        "completed_at"
      ],
      "properties": {
        "validator_id": {"const": "validator:governed-review-agentic-second-pass"},
        "version": {
          "description": "Yerel özeti doğrulanmış Agentic değerlendirici ilkesi sürümüne eşit olmalıdır.",
          "$ref": "#/$defs/semanticVersion"
        },
        "sha256": {
          "description": "Yerel doğrulanmış değerlendirici ilkesi, seçili yönetilen inceleme becerisi ve makbuz koşum takımı özetlerini taşıyan `kt-agentic-second-pass-validator-binding-json-v1` kanonik nesnesinin SHA-256 değeridir; harici yürütme bağımsızlığını kanıtlamaz.",
          "$ref": "#/$defs/sha256"
        },
        "method": {"const": "independent-second-pass-policy-recalculation"},
        "invocation_id": {"$ref": "#/$defs/correlationId"},
        "span_id": {"$ref": "#/$defs/spanId"},
        "checked_digest_set": {"$ref": "#/$defs/checkedDigestSet"},
        "checked_digest_set_sha256": {"$ref": "#/$defs/sha256"},
        "result": {"enum": ["verified", "mismatch", "unavailable"]},
        "recalculated": {"$ref": "#/$defs/decisionOutcome"},
        "matches_primary_evaluation": {"type": "boolean"},
        "claim_boundary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "external_independence_proven",
            "deterministic_runtime",
            "production_authority"
          ],
          "properties": {
            "external_independence_proven": {"const": false},
            "deterministic_runtime": {"const": false},
            "production_authority": {"const": false}
          }
        },
        "completed_at": {"type": "string", "format": "date-time"}
      },
      "allOf": [
        {
          "if": {"properties": {"result": {"const": "verified"}}, "required": ["result"]},
          "then": {"properties": {"matches_primary_evaluation": {"const": true}}}
        },
        {
          "if": {"properties": {"result": {"const": "mismatch"}}, "required": ["result"]},
          "then": {"properties": {"matches_primary_evaluation": {"const": false}}}
        },
        {
          "if": {"properties": {"result": {"const": "unavailable"}}, "required": ["result"]},
          "then": {"properties": {"matches_primary_evaluation": {"const": false}}}
        }
      ]
    },
    "auditReplay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability",
        "requirement",
        "canonicalization",
        "sha256",
        "status",
        "reason_codes",
        "project_id",
        "run_id",
        "trace_id",
        "input_binding",
        "component_binding",
        "prompt_binding",
        "manifests",
        "primary_evaluation",
        "second_pass_validator"
      ],
      "properties": {
        "capability": {"const": "audit_replay"},
        "requirement": {"const": "mandatory"},
        "canonicalization": {"const": "kt-agentic-audit-replay-json-v1"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "status": {"enum": ["verified", "mismatch", "unavailable"]},
        "reason_codes": {"$ref": "#/$defs/reasonCodes"},
        "project_id": {"$ref": "#/$defs/projectId"},
        "run_id": {"$ref": "#/$defs/runId"},
        "trace_id": {"$ref": "#/$defs/traceId"},
        "input_binding": {
          "type": "object",
          "additionalProperties": false,
          "required": ["canonical_input", "snapshot", "acceptance_criteria"],
          "properties": {
            "canonical_input": {
              "type": "object",
              "additionalProperties": false,
              "required": ["canonicalization", "item_count", "sha256"],
              "properties": {
                "canonicalization": {"const": "kt-agentic-review-input-manifest-json-v1"},
                "item_count": {"type": "integer", "minimum": 1, "maximum": 65536},
                "sha256": {"$ref": "#/$defs/sha256"}
              }
            },
            "snapshot": {
              "type": "object",
              "additionalProperties": false,
              "required": ["canonicalization", "sha256"],
              "properties": {
                "canonicalization": {"const": "kt-git-index-snapshot-json-v1"},
                "sha256": {"$ref": "#/$defs/sha256"}
              }
            },
            "acceptance_criteria": {"$ref": "#/$defs/acceptanceCriteria"}
          }
        },
        "component_binding": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "authority",
            "orchestration",
            "aggregation_policy",
            "agentic_evaluator",
            "harness",
            "rule",
            "skill",
            "agent_manifest",
            "client"
          ],
          "properties": {
            "authority": {"$ref": "#/$defs/versionedBinding"},
            "orchestration": {"$ref": "#/$defs/versionedBinding"},
            "aggregation_policy": {"$ref": "#/$defs/versionedBinding"},
            "agentic_evaluator": {
              "allOf": [
                {"$ref": "#/$defs/versionedBinding"},
                {"properties": {"ref": {"const": "policy:governed-review-agentic-evaluation"}}}
              ]
            },
            "harness": {
              "allOf": [
                {"$ref": "#/$defs/versionedBinding"},
                {"properties": {"ref": {"const": "protocol:mandatory-governed-execution-phase1"}}}
              ]
            },
            "rule": {
              "allOf": [
                {"$ref": "#/$defs/versionedBinding"},
                {"properties": {"ref": {"const": "rules/13-tamamlanma-tanimi.md"}}}
              ]
            },
            "skill": {
              "allOf": [
                {"$ref": "#/$defs/versionedBinding"},
                {"properties": {"ref": {"$ref": "#/$defs/repositoryRelativePath"}}}
              ]
            },
            "agent_manifest": {
              "type": "object",
              "additionalProperties": false,
              "required": ["canonicalization", "agent_count", "sha256"],
              "properties": {
                "canonicalization": {"const": "kt-agentic-agent-component-manifest-json-v1"},
                "agent_count": {"const": 12},
                "sha256": {"$ref": "#/$defs/sha256"}
              }
            },
            "client": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "version", "sha256"],
              "properties": {
                "id": {"enum": ["claude-code", "codex", "cursor", "github-copilot-vscode"]},
                "version": {"type": "string", "minLength": 1, "maxLength": 160},
                "sha256": {"$ref": "#/$defs/sha256"}
              }
            }
          }
        },
        "prompt_binding": {
          "type": "object",
          "additionalProperties": false,
          "required": ["template", "envelope"],
          "properties": {
            "template": {
              "allOf": [
                {"$ref": "#/$defs/versionedBinding"},
                {"properties": {"ref": {"$ref": "#/$defs/repositoryRelativePath"}}}
              ]
            },
            "envelope": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "version",
                "source_event_id",
                "source_prompt_turn_id",
                "source_receipt_sha256",
                "prompt_capture_sha256",
                "sha256",
                "raw_content_stored"
              ],
              "properties": {
                "kind": {"const": "redacted-digest-only-prompt-envelope"},
                "version": {"$ref": "#/$defs/semanticVersion"},
                "source_event_id": {
                  "type": "string",
                  "pattern": "^event:(?!0{32}$)[0-9a-f]{32}$"
                },
                "source_prompt_turn_id": {
                  "type": "string",
                  "pattern": "^turn:(?:client\\.[0-9a-f]{64}|local\\.(?!0{32}$)[0-9a-f]{32})$"
                },
                "source_receipt_sha256": {"$ref": "#/$defs/sha256"},
                "prompt_capture_sha256": {"$ref": "#/$defs/sha256"},
                "sha256": {"$ref": "#/$defs/sha256"},
                "raw_content_stored": {"const": false}
              }
            }
          }
        },
        "manifests": {
          "type": "object",
          "additionalProperties": false,
          "required": ["context", "retrieval", "tool_results"],
          "properties": {
            "context": {
              "allOf": [
                {"$ref": "#/$defs/manifestBinding"},
                {"properties": {"canonicalization": {"const": "kt-agentic-context-manifest-json-v1"}}}
              ]
            },
            "retrieval": {
              "allOf": [
                {"$ref": "#/$defs/manifestBinding"},
                {"properties": {"canonicalization": {"const": "kt-agentic-retrieval-manifest-json-v1"}}}
              ]
            },
            "tool_results": {
              "allOf": [
                {"$ref": "#/$defs/manifestBinding"},
                {"properties": {"canonicalization": {"const": "kt-agentic-tool-result-manifest-json-v1"}}}
              ]
            }
          }
        },
        "primary_evaluation": {"$ref": "#/$defs/primaryEvaluation"},
        "second_pass_validator": {"$ref": "#/$defs/secondPassValidator"}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "verified"}}, "required": ["status"]},
          "then": {
            "properties": {
              "second_pass_validator": {
                "properties": {
                  "result": {"const": "verified"},
                  "matches_primary_evaluation": {"const": true}
                }
              },
              "manifests": {
                "properties": {
                  "context": {
                    "properties": {
                      "availability": {"const": "not-used"},
                      "reason_code": {"const": "NOT_USED"},
                      "item_count": {"const": 0},
                      "sha256": {"$ref": "#/$defs/sha256"}
                    }
                  },
                  "retrieval": {
                    "properties": {
                      "availability": {"const": "not-used"},
                      "reason_code": {"const": "NOT_USED"},
                      "item_count": {"const": 0},
                      "sha256": {"$ref": "#/$defs/sha256"}
                    }
                  },
                  "tool_results": {
                    "properties": {
                      "availability": {"const": "not-used"},
                      "reason_code": {"const": "NOT_USED"},
                      "item_count": {"const": 0},
                      "sha256": {"$ref": "#/$defs/sha256"}
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {"properties": {"status": {"const": "mismatch"}}, "required": ["status"]},
          "then": {"properties": {"second_pass_validator": {"properties": {"result": {"const": "mismatch"}}}}}
        },
        {
          "if": {"properties": {"status": {"const": "unavailable"}}, "required": ["status"]},
          "then": {"properties": {"second_pass_validator": {"properties": {"result": {"const": "unavailable"}}}}}
        }
      ]
    },
    "optionalRuntimeComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["availability", "reason_code", "id", "version", "sha256"],
      "properties": {
        "availability": {"enum": ["available", "unavailable"]},
        "reason_code": {
          "oneOf": [
            {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"},
            {"type": "null"}
          ]
        },
        "id": {"type": ["string", "null"], "minLength": 1, "maxLength": 160},
        "version": {"type": ["string", "null"], "minLength": 1, "maxLength": 160},
        "sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
      },
      "allOf": [
        {
          "if": {"properties": {"availability": {"const": "available"}}, "required": ["availability"]},
          "then": {
            "properties": {
              "reason_code": {"const": null},
              "id": {"type": "string"},
              "version": {"type": "string"},
              "sha256": {"$ref": "#/$defs/sha256"}
            }
          }
        },
        {
          "if": {"properties": {"availability": {"const": "unavailable"}}, "required": ["availability"]},
          "then": {
            "properties": {
              "reason_code": {"type": "string"},
              "id": {"const": null},
              "version": {"const": null},
              "sha256": {"const": null}
            }
          }
        }
      ]
    },
    "inferenceParameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "availability", "reason_code", "value"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"},
        "availability": {"enum": ["available", "unavailable"]},
        "reason_code": {
          "oneOf": [
            {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"},
            {"type": "null"}
          ]
        },
        "value": {"type": ["string", "number", "integer", "boolean", "null"]}
      },
      "allOf": [
        {
          "if": {"properties": {"availability": {"const": "available"}}, "required": ["availability"]},
          "then": {
            "properties": {
              "reason_code": {"const": null},
              "value": {"not": {"type": "null"}}
            }
          }
        },
        {
          "if": {"properties": {"availability": {"const": "unavailable"}}, "required": ["availability"]},
          "then": {
            "properties": {
              "reason_code": {"type": "string"},
              "value": {"const": null}
            }
          }
        }
      ]
    },
    "controlledEvidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason_code",
        "reference",
        "content_sha256",
        "access_controlled",
        "time_bounded",
        "expires_at"
      ],
      "properties": {
        "status": {"enum": ["available", "unavailable"]},
        "reason_code": {
          "oneOf": [
            {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"},
            {"type": "null"}
          ]
        },
        "reference": {
          "oneOf": [
            {"type": "string", "pattern": "^evidence-vault:[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"},
