{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kt:agent-platform:agentic-agent-consultation:1.0",
  "title": "Tek uzman ajan danışma kaydı",
  "description": "Kullanıcının tek bir uzman ajanı çağırdığı danışma koşumunun ortak kökteki kaydıdır. Karar, commit yetkisi veya denetim zinciri değildir; yönetilen inceleme makbuzunun yerine geçmez.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "consultation_id",
    "project_id",
    "agent_id",
    "invocation_id",
    "requested_at",
    "completed_at",
    "snapshot_sha256",
    "status",
    "findings",
    "scanned_files",
    "authority",
    "commit_authority",
    "decision",
    "protected_audit",
    "claim_boundary",
    "data_handling"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "kind": {"const": "AgentConsultationRecord"},
    "consultation_id": {
      "type": "string",
      "pattern": "^consultation-[A-Za-z0-9][A-Za-z0-9._-]{3,119}$"
    },
    "project_id": {
      "$ref": "urn:kt:agent-platform:agentic-governance-observation:1.1#/$defs/projectId"
    },
    "agent_id": {
      "$ref": "urn:kt:agent-platform:agentic-governance-observation:1.1#/$defs/agentRef"
    },
    "invocation_id": {"type": "string", "minLength": 3, "maxLength": 200},
    "requested_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "snapshot_sha256": {
      "$ref": "urn:kt:agent-platform:agentic-governance-observation:1.1#/$defs/sha256"
    },
    "status": {"enum": ["ok", "failed", "timeout"]},
    "findings": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "urn:kt:agent-platform:agentic-governance-observation:1.1#/$defs/finding"
      }
    },
    "scanned_files": {
      "type": "array",
      "maxItems": 4096,
      "uniqueItems": true,
      "items": {
        "$ref": "urn:kt:agent-platform:agentic-governance-observation:1.1#/$defs/repositoryRelativePath"
      }
    },
    "authority": {"const": "advisory-consultation"},
    "commit_authority": {"const": false},
    "decision": {"const": null},
    "protected_audit": {"const": "not-recorded"},
    "claim_boundary": {
      "$ref": "urn:kt:agent-platform:agentic-governance-observation:1.1#/$defs/claimBoundary"
    },
    "data_handling": {
      "$ref": "urn:kt:agent-platform:agentic-governance-observation:1.1#/$defs/dataHandling"
    }
  }
}
