{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kt:agent-platform:application-security-source-crosswalk:1.1",
  "title": "Uygulama Güvenliği Kaynak Madde Crosswalk",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "metadata",
    "claim_boundary",
    "reference_corrections",
    "source_conflicts",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "kind": {
      "const": "ApplicationSecuritySourceCrosswalk"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "as_of",
        "owner",
        "source_revision_ref",
        "source_clause_count"
      ],
      "properties": {
        "id": {
          "const": "governance-crosswalk:application-security-v3.0-ingestion-20260831"
        },
        "version": {
          "const": "1.1.0"
        },
        "as_of": {
          "const": "2026-09-17"
        },
        "owner": {
          "const": "team:agent-platform"
        },
        "source_revision_ref": {
          "const": "governance-source-revision:ai-agent-security-coding-v3.0:20260831"
        },
        "source_clause_count": {
          "const": 63
        }
      }
    },
    "claim_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exhaustive_for_observed_source",
        "standards_conformance_claimed",
        "certification_claimed",
        "runtime_admission"
      ],
      "properties": {
        "exhaustive_for_observed_source": {
          "const": true
        },
        "standards_conformance_claimed": {
          "const": false
        },
        "certification_claimed": {
          "const": false
        },
        "runtime_admission": {
          "const": "not-admitted"
        }
      }
    },
    "reference_corrections": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_label",
          "normalized_reference",
          "status",
          "scope_note"
        ],
        "properties": {
          "source_label": {
            "type": "string",
            "minLength": 3
          },
          "normalized_reference": {
            "type": "string",
            "minLength": 3
          },
          "status": {
            "enum": [
              "version-corrected",
              "archived-reference",
              "identifier-format-required"
            ]
          },
          "scope_note": {
            "type": "string",
            "minLength": 20
          }
        }
      }
    },
    "source_conflicts": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "owner",
          "affected_refs",
          "resolution_policy",
          "note"
        ],
        "properties": {
          "id": {
            "enum": [
              "source-conflict:appsec-password-kdf",
              "source-conflict:appsec-rsa-minimum"
            ]
          },
          "status": {
            "enum": [
              "profile-resolution-pending-source-owner",
              "unresolved-owner-decision",
              "resolved-by-owner-profile"
            ]
          },
          "owner": {
            "const": "team:application-security"
          },
          "affected_refs": {
            "type": "array",
            "minItems": 2,
            "maxItems": 4,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 8
            }
          },
          "resolution_policy": {
            "enum": [
              "do-not-recommend-until-owner-resolution",
              "do-not-normalize-to-a-single-minimum",
              "use-rsa-minimum-2048-profile"
            ]
          },
          "note": {
            "type": "string",
            "minLength": 30,
            "maxLength": 500,
            "pattern": "^(?!.*[\\r\\n]).*\\S.*$"
          },
          "resolution_ref": {
            "const": "resolution:rsa-minimum-2048"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "id": {
                  "const": "source-conflict:appsec-rsa-minimum"
                }
              },
              "required": [
                "id"
              ]
            },
            "then": {
              "required": [
                "resolution_ref"
              ],
              "properties": {
                "status": {
                  "const": "resolved-by-owner-profile"
                },
                "resolution_policy": {
                  "const": "use-rsa-minimum-2048-profile"
                }
              }
            },
            "else": {
              "not": {
                "required": [
                  "resolution_ref"
                ]
              },
              "properties": {
                "status": {
                  "const": "profile-resolution-pending-source-owner"
                },
                "resolution_policy": {
                  "const": "do-not-recommend-until-owner-resolution"
                }
              }
            }
          }
        ]
      }
    },
    "entries": {
      "type": "array",
      "minItems": 63,
      "maxItems": 63,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_line",
        "source_section",
        "owner",
        "disposition",
        "enforcement_classes",
        "canonical_refs",
        "mapping_status",
        "standard_refs",
        "implementation_status",
        "projection_status",
        "runtime_admission",
        "rationale"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^APPSEC-V3-(?:0[1-9]|1[0-3])-[0-9]{2}$"
        },
        "source_line": {
          "type": "integer",
          "minimum": 1,
          "maximum": 98
        },
        "source_section": {
          "type": "integer",
          "minimum": 1,
          "maximum": 13
        },
        "owner": {
          "enum": [
            "application-security",
            "information-security",
            "privacy-kvkk",
            "devops",
            "oss-license",
            "workflow-governance",
            "platform-human-approval",
            "enterprise-architecture"
          ]
        },
        "disposition": {
          "enum": [
            "accepted-normalized",
            "accepted-institutional-profile",
            "contextualized",
            "externalized",
            "rejected-authority-escalation",
            "deferred-unsupported-profile"
          ]
        },
        "enforcement_classes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "instruction",
              "detector-specification",
              "hook",
              "ci",
              "external-evidence",
              "human-approval"
            ]
          }
        },
        "canonical_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9:./_-]+$"
          }
        },
        "mapping_status": {
          "enum": [
            "not-mapped",
            "source-stated-unverified",
            "verified-reference",
            "institutional-profile"
          ]
        },
        "standard_refs": {
          "type": "array",
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9:./#_-]+$"
          }
        },
        "implementation_status": {
          "enum": [
            "implemented",
            "partially-implemented",
            "calibration-pending",
            "externally-enforced",
            "profile-gated",
            "deferred"
          ]
        },
        "projection_status": {
          "enum": [
            "projected",
            "not-projectable",
            "external"
          ]
        },
        "runtime_admission": {
          "const": "not-admitted"
        },
        "rationale": {
          "type": "string",
          "minLength": 20,
          "maxLength": 500,
          "pattern": "^(?!.*[\\r\\n]).*\\S.*$"
        }
      }
    }
  }
}
