{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kt:agent-platform:human-approval:1.0",
  "title": "İnsan Onayı Eylem Sözleşmeleri",
  "description": "Tek bir ajan eyleminin işlem öncesi insan onayına bağlanması için katı istek, grant ve makbuz sözleşmeleri. Bir istemci onay arayüzü veya bu belgenin varlığı tek başına çalışma zamanı yetkisi vermez; grant güvenilir harici onay sağlayıcısı üzerinden doğrulanmalıdır.",
  "oneOf": [
    {"$ref": "#/$defs/actionRequest"},
    {"$ref": "#/$defs/grant"},
    {"$ref": "#/$defs/receipt"}
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "agentId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "approvalId": {
      "type": "string",
      "pattern": "^approval:[a-z0-9]+(?:[-.:][a-z0-9]+)*$"
    },
    "runId": {
      "type": "string",
      "pattern": "^run:[a-z0-9]+(?:[-.:][a-z0-9]+)*$"
    },
    "invocationId": {
      "type": "string",
      "pattern": "^invocation:[a-z0-9]+(?:[-.:][a-z0-9]+)*$"
    },
    "principal": {
      "type": "string",
      "pattern": "^(?:agent|user):[a-z0-9][a-z0-9._@+-]{0,199}$"
    },
    "approver": {
      "type": "string",
      "pattern": "^user:[a-z0-9][a-z0-9._@+-]{0,199}$"
    },
    "utcSecond": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "action": {
      "enum": [
        "workspace-write",
        "isolated-test-execution",
        "regulated-decision",
        "external-side-effect",
        "destructive-action"
      ]
    },
    "scopeRefs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?:environment|resource|workspace):[a-z0-9][a-z0-9._/-]{0,255}$"
      }
    },
    "approverIdentities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/approver"}
    },
    "w3cTraceContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "trace_id", "span_id", "parent_span_id", "trace_flags"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "trace_id": {
          "type": "string",
          "pattern": "^(?!0{32}$)[0-9a-f]{32}$"
        },
        "span_id": {
          "type": "string",
          "pattern": "^(?!0{16}$)[0-9a-f]{16}$"
        },
        "parent_span_id": {
          "type": "string",
          "pattern": "^(?!0{16}$)[0-9a-f]{16}$"
        },
        "trace_flags": {
          "type": "string",
          "pattern": "^[0-9a-f]{2}$"
        }
      }
    },
    "policyRequirement": {
      "type": "object",
      "required": [
        "approval_policy_digest",
        "minimum_approvers",
        "separation_of_duties",
        "max_ttl_seconds"
      ],
      "properties": {
        "approval_policy_digest": {"$ref": "#/$defs/sha256"},
        "minimum_approvers": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "separation_of_duties": {"type": "boolean"},
        "max_ttl_seconds": {"type": "integer", "minimum": 1}
      }
    },
    "actionBinding": {
      "type": "object",
      "required": [
        "agent_id",
        "action",
        "action_request_sha256",
        "scope_refs",
        "run_id",
        "invocation_id",
        "trace_context",
        "requester_identity"
      ],
      "properties": {
        "agent_id": {"$ref": "#/$defs/agentId"},
        "action": {"$ref": "#/$defs/action"},
        "action_request_sha256": {"$ref": "#/$defs/sha256"},
        "scope_refs": {"$ref": "#/$defs/scopeRefs"},
        "run_id": {"$ref": "#/$defs/runId"},
        "invocation_id": {"$ref": "#/$defs/invocationId"},
        "trace_context": {"$ref": "#/$defs/w3cTraceContext"},
        "requester_identity": {"$ref": "#/$defs/principal"}
      }
    },
    "actionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "agent_id",
        "action",
        "action_request_sha256",
        "scope_refs",
        "run_id",
        "invocation_id",
        "trace_context",
        "requester_identity",
        "approval_policy_digest",
        "minimum_approvers",
        "separation_of_duties",
        "max_ttl_seconds"
      ],
      "properties": {
        "schema_version": {"const": "1.0"},
        "kind": {"const": "AgentActionAuthorizationRequest"},
        "agent_id": {"$ref": "#/$defs/agentId"},
        "action": {"$ref": "#/$defs/action"},
        "action_request_sha256": {"$ref": "#/$defs/sha256"},
        "scope_refs": {"$ref": "#/$defs/scopeRefs"},
        "run_id": {"$ref": "#/$defs/runId"},
        "invocation_id": {"$ref": "#/$defs/invocationId"},
        "trace_context": {"$ref": "#/$defs/w3cTraceContext"},
        "requester_identity": {"$ref": "#/$defs/principal"},
        "approval_policy_digest": {"$ref": "#/$defs/sha256"},
        "minimum_approvers": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "separation_of_duties": {"type": "boolean"},
        "max_ttl_seconds": {"type": "integer", "minimum": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"separation_of_duties": {"const": true}}},
          "then": {"properties": {"minimum_approvers": {"minimum": 2}}}
        }
      ]
    },
    "grant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "decision",
        "approval_id",
        "agent_id",
        "action",
        "action_request_sha256",
        "scope_refs",
        "run_id",
        "invocation_id",
        "trace_context",
        "requester_identity",
        "approver_identities",
        "approval_policy_digest",
        "minimum_approvers",
        "separation_of_duties",
        "max_ttl_seconds",
        "issued_at",
        "expires_at",
        "single_use"
      ],
      "properties": {
        "schema_version": {"const": "1.0"},
        "kind": {"const": "HumanApprovalGrant"},
        "decision": {"const": "approved"},
        "approval_id": {"$ref": "#/$defs/approvalId"},
        "agent_id": {"$ref": "#/$defs/agentId"},
        "action": {"$ref": "#/$defs/action"},
        "action_request_sha256": {"$ref": "#/$defs/sha256"},
        "scope_refs": {"$ref": "#/$defs/scopeRefs"},
        "run_id": {"$ref": "#/$defs/runId"},
        "invocation_id": {"$ref": "#/$defs/invocationId"},
        "trace_context": {"$ref": "#/$defs/w3cTraceContext"},
        "requester_identity": {"$ref": "#/$defs/principal"},
        "approver_identities": {"$ref": "#/$defs/approverIdentities"},
        "approval_policy_digest": {"$ref": "#/$defs/sha256"},
        "minimum_approvers": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "separation_of_duties": {"type": "boolean"},
        "max_ttl_seconds": {"type": "integer", "minimum": 1},
        "issued_at": {"$ref": "#/$defs/utcSecond"},
        "expires_at": {"$ref": "#/$defs/utcSecond"},
        "single_use": {"const": true}
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "status",
        "approval_id",
        "grant_sha256",
        "agent_id",
        "action",
        "action_request_sha256",
        "scope_refs",
        "run_id",
        "invocation_id",
        "trace_context",
        "requester_identity",
        "approver_identities",
        "approval_policy_digest",
        "minimum_approvers",
        "separation_of_duties",
        "max_ttl_seconds",
        "authorized_at",
        "expires_at",
        "single_use",
        "replay_consumed"
      ],
      "properties": {
        "schema_version": {"const": "1.0"},
        "kind": {"const": "HumanApprovalReceipt"},
        "status": {"const": "authorized"},
        "approval_id": {"$ref": "#/$defs/approvalId"},
        "grant_sha256": {"$ref": "#/$defs/sha256"},
        "agent_id": {"$ref": "#/$defs/agentId"},
        "action": {"$ref": "#/$defs/action"},
        "action_request_sha256": {"$ref": "#/$defs/sha256"},
        "scope_refs": {"$ref": "#/$defs/scopeRefs"},
        "run_id": {"$ref": "#/$defs/runId"},
        "invocation_id": {"$ref": "#/$defs/invocationId"},
        "trace_context": {"$ref": "#/$defs/w3cTraceContext"},
        "requester_identity": {"$ref": "#/$defs/principal"},
        "approver_identities": {"$ref": "#/$defs/approverIdentities"},
        "approval_policy_digest": {"$ref": "#/$defs/sha256"},
        "minimum_approvers": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "separation_of_duties": {"type": "boolean"},
        "max_ttl_seconds": {"type": "integer", "minimum": 1},
        "authorized_at": {"$ref": "#/$defs/utcSecond"},
        "expires_at": {"$ref": "#/$defs/utcSecond"},
        "single_use": {"const": true},
        "replay_consumed": {"const": true}
      },
      "allOf": [
        {
          "if": {"properties": {"separation_of_duties": {"const": true}}},
          "then": {"properties": {"minimum_approvers": {"minimum": 2}}}
        }
      ]
    }
  }
}
