        },
        "version": {
          "const": "1.0.0"
        },
        "accepted_on": {
          "const": "2026-09-17"
        },
        "acceptance_ref": {
          "const": "specs/agent-platform/PRDs/002-policy-normalization-and-detector-lineage/PRD.md#requirement-18"
        },
        "scope": {
