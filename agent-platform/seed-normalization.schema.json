    "dependency_acceptance_inheritance": {
      "const": {
        "id": "package-inheritance:locked-transitive-20260917",
        "decision_ref": "specs/agent-platform/PRDs/002-policy-normalization-and-detector-lineage/PRD.md#requirement-25",
        "scope": "package-name-allowlist-only",
        "root_acceptance": "authoritative-and-scope-matched",
        "required_evidence": [
          "same-candidate",
          "manifest-lock-consistency",
          "dependency-path-from-accepted-root",
          "exact-version",
          "artifact-digest"
        ],
        "direct_packages": "independent-acceptance-required",
        "usage_scope": "inherit-root-no-development-to-production-promotion",
        "preserved_controls": [
          "security-findings",
          "license-policy-and-notices",
          "download-source-policy",
          "release-age",
          "dependency-admission"
        ],
        "update_review": "changed-nodes-edges-versions-digests-sources-licenses-and-open-findings",
        "missing_or_invalid_input": "BLOCKED_INCOMPLETE",
