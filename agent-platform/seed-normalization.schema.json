  "$defs": {
    "sourceRef": {
      "type": "string",
      "pattern": "^governance-source:desktop-agents/[a-z][a-z0-9]*(?:-[a-z0-9]+)*/(?:agent\\.md|policy\\.yaml|aggregation_policy\\.yaml|allowlist\\.yaml|detectors\\.yaml)#[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "targetRef": {
      "type": "string",
      "pattern": "^(?:control:[A-Z][A-Z0-9]*-[0-9]{3}|detector:[a-z][a-z0-9]*(?:[./-][a-z0-9]+)*|instructions:(?:agent:[a-z][a-z0-9]*(?:-[a-z0-9]+)*|orchestration:[a-z][a-z0-9]*(?:-[a-z0-9]+)*)|runtime-profile:[a-z][a-z0-9]*(?:-[a-z0-9]+)*)$"
    },
    "conflictRef": {
      "type": "string",
      "pattern": "^source-conflict:[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "evidenceRecordRef": {
      "type": "string",
      "pattern": "^docs/evidence/[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9]+(?:-[a-z0-9]+)*\\.md$"
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_ref",
        "source_kind",
        "source_authority",
        "implementation_status",
        "projection_status",
        "runtime_admission",
        "target_refs",
        "source_conflict_refs",
        "rationale"
      ],
      "properties": {
        "source_ref": {
          "$ref": "#/$defs/sourceRef"
        },
        "source_kind": {
          "enum": [
            "instructions",
            "rule",
            "weights",
            "threshold",
            "runtime-setting",
            "semantic-check",
            "structural-setting",
            "fix-rule",
            "architecture-setting",
            "aggregation-weight",
            "aggregation-threshold",
            "aggregation-setting",
            "allowlist-entry",
            "control",
            "detector"
          ]
        },
        "source_authority": {
          "const": "governance-authoritative"
        },
        "implementation_status": {
          "enum": [
            "implemented",
            "implementation-pending",
            "calibration-pending",
            "externally-enforced"
          ]
        },
        "projection_status": {
          "enum": [
            "projected",
            "not-projectable",
            "blocked"
          ]
        },
        "runtime_admission": {
          "const": "not-admitted"
        },
        "target_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/targetRef"
          }
        },
        "source_conflict_refs": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/conflictRef"
          }
        },
        "rationale": {
          "type": "string",
          "minLength": 20,
          "maxLength": 500,
          "pattern": "^(?!.*[\\r\\n]).*\\S.*$"
        }
      }
    },
    "sourceConflict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_refs",
        "description",
        "resolution_status",
        "authority_disposition"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/conflictRef"
        },
        "source_refs": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sourceRef"
          }
        },
        "description": {
          "type": "string",
          "minLength": 20,
          "maxLength": 500,
          "pattern": "^(?!.*[\\r\\n]).*\\S.*$"
        },
        "resolution_status": {
          "enum": [
            "owner-resolution-required",
            "resolved-by-technology-profile"
          ]
        },
        "authority_disposition": {
          "enum": [
            "preserved-without-silent-precedence",
            "source-preserved-explicit-profile-precedence"
          ]
        },
        "resolution": {
          "oneOf": [
            {
              "$ref": "#/$defs/pythonProfileResolution"
            },
            {
              "$ref": "#/$defs/fastapiProfileResolution"
            },
            {
              "$ref": "#/$defs/typescriptProfileResolution"
            },
            {
              "$ref": "#/$defs/frontendProfileResolution"
            },
            {
              "$ref": "#/$defs/rsaMinimumResolution"
            },
            {
              "$ref": "#/$defs/sec009LoopbackResolution"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "id": {
                "const": "source-conflict:python-allowed-and-target-version"
              }
            },
            "required": [
              "id"
            ]
          },
          "then": {
            "required": [
              "resolution"
            ],
            "properties": {
              "resolution_status": {
                "const": "resolved-by-technology-profile"
              },
              "authority_disposition": {
                "const": "source-preserved-explicit-profile-precedence"
              },
              "resolution": {
                "$ref": "#/$defs/pythonProfileResolution"
              }
            }
          },
          "else": {
            "if": {
              "properties": {
                "id": {
                  "const": "source-conflict:fastapi-allowed-and-profile-version"
                }
              },
              "required": [
                "id"
              ]
            },
            "then": {
              "required": [
                "resolution"
              ],
              "properties": {
                "resolution_status": {
                  "const": "resolved-by-technology-profile"
                },
                "authority_disposition": {
                  "const": "source-preserved-explicit-profile-precedence"
                },
                "resolution": {
                  "$ref": "#/$defs/fastapiProfileResolution"
                },
                "source_refs": {
                  "const": [
                    "governance-source:desktop-agents/oss-license/allowlist.yaml#allowlist/approved-technology/fastapi",
                    "governance-source:desktop-agents/oss-license/allowlist.yaml#allowlist/approved-package/fastapi"
                  ]
                }
              }
            },
            "else": {
              "if": {
                "properties": {
                  "id": {
                    "const": "source-conflict:typescript-allowed-and-profile-roles"
                  }
                },
                "required": [
                  "id"
                ]
              },
              "then": {
                "required": [
                  "resolution"
                ],
                "properties": {
                  "resolution_status": {
                    "const": "resolved-by-technology-profile"
                  },
                  "authority_disposition": {
                    "const": "source-preserved-explicit-profile-precedence"
                  },
                  "resolution": {
                    "$ref": "#/$defs/typescriptProfileResolution"
                  },
                  "source_refs": {
                    "const": [
                      "governance-source:desktop-agents/oss-license/agent.md#instruction/document",
                      "governance-source:desktop-agents/oss-license/allowlist.yaml#allowlist/approved-technology/typescript"
                    ]
                  }
                }
              },
              "else": {
                "if": {
                  "properties": {
                    "id": {
                      "const": "source-conflict:nextjs-only-and-react-vite-profile"
                    }
                  },
                  "required": [
                    "id"
                  ]
                },
                "then": {
                  "required": [
                    "resolution"
                  ],
                  "properties": {
                    "resolution_status": {
                      "const": "resolved-by-technology-profile"
                    },
                    "authority_disposition": {
                      "const": "source-preserved-explicit-profile-precedence"
                    },
                    "resolution": {
                      "$ref": "#/$defs/frontendProfileResolution"
                    },
                    "source_refs": {
                      "const": [
                        "governance-source:desktop-agents/oss-license/agent.md#instruction/document",
                        "governance-source:desktop-agents/oss-license/allowlist.yaml#allowlist/approved-technology/next-js"
                      ]
                    }
                  }
                },
                "else": {
                  "if": {
                    "properties": {
                      "id": {
                        "const": "source-conflict:appsec-rsa-minimum"
                      }
                    },
                    "required": [
                      "id"
                    ]
                  },
                  "then": {
                    "required": [
                      "resolution"
                    ],
                    "properties": {
                      "resolution_status": {
                        "const": "resolved-by-technology-profile"
                      },
                      "authority_disposition": {
                        "const": "source-preserved-explicit-profile-precedence"
                      },
                      "resolution": {
                        "$ref": "#/$defs/rsaMinimumResolution"
                      },
                      "source_refs": {
                        "const": [
                          "governance-source:desktop-agents/application-security/agent.md#instruction/document",
                          "governance-source:desktop-agents/application-security/policy.yaml#rule/APPSEC-012"
                        ]
                      }
                    }
                  },
                  "else": {
                    "if": {
                      "properties": {
                        "id": {
                          "const": "source-conflict:information-security-sec009-loopback"
                        }
                      },
                      "required": [
                        "id"
                      ]
                    },
                    "then": {
                      "required": [
                        "resolution"
                      ],
                      "properties": {
                        "resolution_status": {
                          "const": "resolved-by-technology-profile"
                        },
                        "authority_disposition": {
                          "const": "source-preserved-explicit-profile-precedence"
                        },
                        "resolution": {
                          "$ref": "#/$defs/sec009LoopbackResolution"
                        },
                        "source_refs": {
                          "const": [
                            "governance-source:desktop-agents/information-security/agent.md#instruction/document",
                            "governance-source:desktop-agents/information-security/policy.yaml#rule/SEC-009"
                          ]
                        }
                      }
                    },
                    "else": {
                      "not": {
                        "required": [
                          "resolution"
                        ]
                      },
                      "properties": {
                        "resolution_status": {
                          "const": "owner-resolution-required"
                        },
                        "authority_disposition": {
                          "const": "preserved-without-silent-precedence"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "pythonProfileResolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "accepted_on",
        "acceptance_ref",
        "scope",
        "profile_refs",
        "missing_or_invalid_input",
        "runtime_admission"
      ],
      "properties": {
        "id": {
          "const": "resolution:python-runtime-profile"
        },
        "version": {
          "const": "1.0.0"
        },
        "accepted_on": {
          "const": "2026-09-16"
        },
        "acceptance_ref": {
          "const": "specs/agent-platform/PRDs/002-policy-normalization-and-detector-lineage/PRD.md#requirement-17"
        },
        "scope": {
