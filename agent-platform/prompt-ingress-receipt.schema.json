{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "prompt-ingress-receipt.schema.json",
  "title": "PromptIngressReceipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "phase",
    "event_id",
    "invocation_id",
    "occurred_at",
    "project_id",
    "run_id",
    "trace_context",
    "prompt_session_id",
    "prompt_session_id_source",
    "prompt_turn_id",
    "prompt_turn_id_source",
    "audit_identity_ref",
    "audit_identity_source",
    "client_id",
    "event",
    "decision",
    "outcome",
    "policy_availability",
    "policy_version",
    "policy_sha256",
    "state_policy_version",
    "state_policy_sha256",
    "storage_authority",
    "immutable_audit_storage_proof",
    "capture_scope",
    "prompt_capture",
    "detector_counts",
    "raw_sensitive_content_recorded",
    "excluded_content_recorded",
    "model"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "kind": {"const": "PromptIngressReceipt"},
    "phase": {"const": "sanitized-user-prompt-audit-phase-1"},
    "event_id": {
      "type": "string",
      "pattern": "^event:(?!0{32}$)[0-9a-f]{32}$"
    },
    "invocation_id": {
      "type": "string",
      "pattern": "^invocation:(?!0{32}$)[0-9a-f]{32}$"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^project-(?!0{32}$)[0-9a-f]{32}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^run:(?!0{32}$)[0-9a-f]{32}$"
    },
    "trace_context": {"$ref": "#/$defs/traceContext"},
    "prompt_session_id": {
      "type": "string",
      "pattern": "^session:(?:client\\.[0-9a-f]{64}|local\\.(?!0{32}$)[0-9a-f]{32})$"
    },
    "prompt_session_id_source": {"$ref": "#/$defs/correlationSource"},
    "prompt_turn_id": {
      "type": "string",
      "pattern": "^turn:(?:client\\.[0-9a-f]{64}|local\\.(?!0{32}$)[0-9a-f]{32})$"
    },
    "prompt_turn_id_source": {"$ref": "#/$defs/correlationSource"},
    "audit_identity_ref": {
      "type": "string",
      "pattern": "^vibecoder-identity:sha256:[0-9a-f]{64}$"
    },
    "audit_identity_source": {
      "enum": ["client-visible", "os-fallback", "unavailable"]
    },
    "client_id": {"enum": ["claude-code", "codex", "github-copilot-vscode", "cursor"]},
    "event": {"enum": ["UserPromptSubmit", "beforeSubmitPrompt"]},
    "decision": {"enum": ["allow", "block"]},
    "outcome": {"enum": ["clean", "matched", "input-invalid", "guard-error"]},
    "policy_availability": {"enum": ["available", "unavailable"]},
    "policy_version": {
      "type": ["string", "null"],
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "policy_sha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "state_policy_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "state_policy_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "storage_authority": {"const": "shared-governance-root"},
    "immutable_audit_storage_proof": {"const": false},
    "capture_scope": {"const": "user-prompt-text-only"},
    "prompt_capture": {"$ref": "#/$defs/promptCapture"},
    "detector_counts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["detector_id", "class", "count"],
        "properties": {
          "detector_id": {"type": "string", "pattern": "^detector:[a-z0-9-]+/[a-z0-9-]+$"},
          "class": {"$ref": "#/$defs/detectorClass"},
          "count": {"type": "integer", "minimum": 1}
        }
      }
    },
    "raw_sensitive_content_recorded": {"const": false},
    "excluded_content_recorded": {"const": false},
    "model": {"$ref": "#/$defs/observedModel"}
  },
  "allOf": [
    {
      "if": {"properties": {"policy_availability": {"const": "available"}}},
      "then": {
        "properties": {
          "policy_version": {"type": "string"},
          "policy_sha256": {"type": "string"}
        }
      },
      "else": {
        "properties": {
          "outcome": {"const": "guard-error"},
          "decision": {"const": "block"},
          "policy_version": {"type": "null"},
          "policy_sha256": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"outcome": {"const": "clean"}}},
      "then": {
        "properties": {
          "decision": {"const": "allow"},
          "detector_counts": {"const": []},
          "prompt_capture": {
            "properties": {
              "mode": {"const": "clean-exact"},
              "text": {"type": "string"},
              "sha256": {"type": "string"},
              "redaction_strategy": {"const": "none"},
              "redaction_count": {"const": 0},
              "redacted_classes": {"const": []}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"outcome": {"const": "matched"}}},
      "then": {
        "properties": {
          "decision": {"const": "block"},
          "detector_counts": {"minItems": 1},
          "prompt_capture": {
            "properties": {
              "mode": {
                "enum": ["sensitive-span-redacted", "sensitive-whole-prompt-redacted"]
              },
              "text": {"type": "string"},
              "sha256": {"type": "string"},
              "redaction_strategy": {
                "enum": ["validated-detector-spans-v1", "whole-prompt-redacted-v1"]
              },
              "redaction_count": {"type": "integer", "minimum": 1},
              "redacted_classes": {"minItems": 1}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {"outcome": {"enum": ["input-invalid", "guard-error"]}}
      },
      "then": {
        "properties": {
          "decision": {"const": "block"},
          "detector_counts": {"const": []},
          "prompt_capture": {
            "properties": {
              "mode": {"const": "unavailable"},
              "text": {"type": "null"},
              "sha256": {"type": "null"},
              "redaction_strategy": {"const": "none"},
              "redaction_count": {"const": 0},
              "redacted_classes": {"const": []}
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "correlationSource": {
      "enum": ["client-envelope", "local-generated-client-unavailable"]
    },
    "detectorClass": {
      "enum": [
        "labelled-secret",
        "cloud-access-key",
        "private-key",
        "email",
        "tckn",
        "iban",
        "payment-card",
        "phone-number"
      ]
    },
    "promptCapture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "text",
        "sha256",
        "redaction_strategy",
        "redaction_count",
        "redacted_classes"
      ],
      "properties": {
        "mode": {
          "enum": [
            "clean-exact",
            "sensitive-span-redacted",
            "sensitive-whole-prompt-redacted",
            "unavailable"
          ]
        },
        "text": {"type": ["string", "null"], "maxLength": 524288},
        "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "redaction_strategy": {
          "enum": ["none", "validated-detector-spans-v1", "whole-prompt-redacted-v1"]
        },
        "redaction_count": {"type": "integer", "minimum": 0},
        "redacted_classes": {
          "type": "array",
          "items": {"$ref": "#/$defs/detectorClass"},
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"mode": {"const": "sensitive-span-redacted"}},
            "required": ["mode"]
          },
          "then": {
            "properties": {
              "redaction_strategy": {"const": "validated-detector-spans-v1"},
              "redacted_classes": {
                "not": {
                  "contains": {"enum": ["labelled-secret", "private-key"]}
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {"mode": {"const": "sensitive-whole-prompt-redacted"}},
            "required": ["mode"]
          },
          "then": {
            "properties": {
              "text": {"const": "[REDACTED:high-risk-prompt]"},
              "redaction_strategy": {"const": "whole-prompt-redacted-v1"},
              "redaction_count": {"const": 1},
              "redacted_classes": {
                "contains": {"enum": ["labelled-secret", "private-key"]}
              }
            }
          }
        }
      ]
    },
    "traceContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "trace_id", "span_id", "parent_span_id", "trace_flags"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "trace_id": {
          "type": "string",
          "pattern": "^(?!0{32}$)[0-9a-f]{32}$"
        },
        "span_id": {
          "type": "string",
          "pattern": "^(?!0{16}$)[0-9a-f]{16}$"
        },
        "parent_span_id": {"type": "null"},
        "trace_flags": {"type": "string", "pattern": "^[0-9a-f]{2}$"}
      }
    },
    "observedModel": {
      "type": "object",
      "additionalProperties": false,
      "description": "İstemcinin bu olay için bildirdiği etkin model ve effort. Codex ve Cursor modeli kanca olayında, Claude Code oturum logunda bildirir; VS Code/Copilot bildirmez. Gözlenemeyen değer uydurulmaz.",
      "required": ["source", "id", "effort"],
      "properties": {
        "source": {"enum": ["native-event-observed", "client-log-observed", "unavailable"]},
        "id": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]{0,159}$"},
        "effort": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,39}$"}
      },
      "allOf": [
        {
          "if": {"properties": {"source": {"const": "unavailable"}}, "required": ["source"]},
          "then": {"properties": {"id": {"const": null}, "effort": {"const": null}}},
          "else": {"properties": {"id": {"type": "string"}}}
        }
      ]
    }
  }
}
