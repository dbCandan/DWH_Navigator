{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "privacy-identifier-eval.schema.json",
  "title": "PrivacyIdentifierValidationEval",
  "oneOf": [
    {"$ref": "#/$defs/corpus"},
    {"$ref": "#/$defs/report"}
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "scheme": {"enum": ["tckn-checksum", "iban-mod97", "luhn-checksum"]},
    "corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "kind", "eval_id", "version", "measurement_scope", "cases"],
      "properties": {
        "$schema": {"type": "string", "minLength": 1},
        "schema_version": {"const": "1.0"},
        "kind": {"const": "PrivacyIdentifierValidationEvalCorpus"},
        "eval_id": {"const": "eval:privacy-identifier-validation"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "measurement_scope": {"const": "bounded-synthetic-regression-not-population-estimate"},
        "cases": {
          "type": "array",
          "minItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["case_id", "scheme", "candidate", "expected_outcome", "synthetic"],
            "properties": {
              "case_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
              "scheme": {"$ref": "#/$defs/scheme"},
              "candidate": {"type": "string", "minLength": 2, "maxLength": 64},
              "expected_outcome": {"enum": ["valid", "invalid"]},
              "synthetic": {"const": true}
            }
          }
        }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "eval_id",
        "corpus_version",
        "corpus_sha256",
        "measurement_scope",
        "population_claim",
        "metrics",
        "acceptance"
      ],
      "properties": {
        "$schema": {"type": "string", "minLength": 1},
        "schema_version": {"const": "1.0"},
        "kind": {"const": "PrivacyIdentifierValidationEvalReport"},
        "eval_id": {"const": "eval:privacy-identifier-validation"},
        "corpus_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "corpus_sha256": {"$ref": "#/$defs/sha256"},
        "measurement_scope": {"const": "bounded-synthetic-regression-not-population-estimate"},
        "population_claim": {"const": false},
        "metrics": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "scheme",
              "sample_count",
              "positive_count",
              "negative_count",
              "regex_candidate_false_positives",
              "validated_false_positives",
              "validated_false_negatives",
              "regex_false_positive_rate_basis_points",
              "validated_false_positive_rate_basis_points"
            ],
            "properties": {
              "scheme": {"$ref": "#/$defs/scheme"},
              "sample_count": {"type": "integer", "minimum": 1},
              "positive_count": {"type": "integer", "minimum": 1},
              "negative_count": {"type": "integer", "minimum": 1},
              "regex_candidate_false_positives": {"type": "integer", "minimum": 0},
              "validated_false_positives": {"type": "integer", "minimum": 0},
              "validated_false_negatives": {"type": "integer", "minimum": 0},
              "regex_false_positive_rate_basis_points": {"type": "integer", "minimum": 0, "maximum": 10000},
              "validated_false_positive_rate_basis_points": {"type": "integer", "minimum": 0, "maximum": 10000}
            }
          }
        },
        "acceptance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_false_positive_rate_basis_points", "max_false_negatives", "passed"],
          "properties": {
            "max_false_positive_rate_basis_points": {"type": "integer", "minimum": 0, "maximum": 10000},
            "max_false_negatives": {"type": "integer", "minimum": 0},
            "passed": {"type": "boolean"}
          }
        }
      }
    }
  }
}
