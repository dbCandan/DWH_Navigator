{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "local-governance-state-policy.schema.json",
  "title": "LocalGovernanceStatePolicy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "metadata",
    "layout",
    "limits",
    "retention",
    "export",
    "assurance"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "kind": {
      "const": "LocalGovernanceStatePolicy"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version"
      ],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "macos",
        "windows",
        "linux",
        "prompt_receipts",
        "authority_pin",
        "review_baselines",
        "commit_guard_receipts"
      ],
      "properties": {
        "macos": {
          "const": "/Users/Shared/kt-scaffold/governance/"
        },
        "windows": {
          "const": "%ProgramData%\\kt-scaffold\\governance\\"
        },
        "linux": {
          "const": "/var/lib/kt-scaffold/governance/"
        },
        "prompt_receipts": {
          "const": "{project_id}/prompt-ingress/"
        },
        "authority_pin": {
          "const": "{project_id}/authority-pin/"
        },
        "review_baselines": {
          "const": "{project_id}/review-baseline/"
        },
        "commit_guard_receipts": {
          "const": "{project_id}/commit-governance/"
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_prompt_record_bytes",
        "max_authority_receipt_bytes",
        "max_review_baseline_file_bytes",
        "max_commit_guard_event_bytes"
      ],
      "properties": {
        "max_prompt_record_bytes": {
          "const": 262144
        },
        "max_authority_receipt_bytes": {
          "const": 65536
        },
        "max_review_baseline_file_bytes": {
          "const": 2097152
        },
        "max_commit_guard_event_bytes": {
          "const": 65536
        }
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "automatic_delete",
        "delete_requires_export_ack"
      ],
      "properties": {
        "automatic_delete": {
          "const": false
        },
        "delete_requires_export_ack": {
          "const": true
        }
      }
    },
    "export": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "protocol",
        "endpoint",
        "persistent_queue"
      ],
      "properties": {
        "enabled": {
          "const": false
        },
        "protocol": {
          "const": "otlp/https"
        },
        "endpoint": {
          "type": "null"
        },
        "persistent_queue": {
          "const": "collector-file-storage-not-configured"
        }
      }
    },
    "assurance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clean_prompt_exact_content_allowed",
        "excluded_content_allowed",
        "local_spool_immutable",
        "production_admission",
        "raw_sensitive_content_allowed"
      ],
      "properties": {
        "clean_prompt_exact_content_allowed": {
          "const": true
        },
        "excluded_content_allowed": {
          "const": false
        },
        "local_spool_immutable": {
          "const": false
        },
        "production_admission": {
          "const": false
        },
        "raw_sensitive_content_allowed": {
          "const": false
        }
      }
    }
  }
}
