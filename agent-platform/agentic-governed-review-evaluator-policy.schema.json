{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kt:agent-platform:agentic-governed-review-evaluator-policy:1.0",
  "title": "Faz 1 Agentic Yönetilen İnceleme Değerlendirici İlkesi",
  "description": "On iki Agentic gözlemi sürümlü kanonik toplama değerlerine göre değerlendiren, kanonik veya belirlenimci karar yetkisi taşımayan Faz 1 LLM-Agentic değerlendirici sözleşmesi.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "metadata",
    "aggregation_source",
    "mandatory_governed_execution",
    "evaluation",
    "evidence_bound_replay",
    "native_gate_validation",
    "finalization",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "kind": {"const": "AgenticEvaluationPolicy"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "owner", "lifecycle", "evaluator_id"],
      "properties": {
        "id": {"const": "policy:governed-review-agentic-evaluation"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "owner": {"const": "team:ai-governance"},
        "lifecycle": {"const": "draft"},
        "evaluator_id": {"const": "evaluator:governed-review-agentic-phase1"}
      }
    },
    "aggregation_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_ref",
        "policy_version",
        "policy_sha256",
        "path",
        "required_fields",
        "copy_values"
      ],
      "properties": {
        "policy_ref": {"const": "policy:governed-review-aggregation"},
        "policy_version": {"const": "1.5.0"},
        "policy_sha256": {
          "const": "7e17ae795f050b4345b3b4074b3a6dab0626d612a37bdf2ccebe8987482f4ccb"
        },
        "path": {"const": "policies/aggregation/governed-review.yml"},
        "required_fields": {
          "const": [
            "required_agents",
            "weights",
            "finding_classification.severity_bands",
            "thresholds",
            "fail_closed",
            "security_critical_veto",
            "decision_precedence",
            "warning_disposition",
            "hard_fail_authority",
            "hard_fail_non_override"
          ]
        },
        "copy_values": {"const": false}
      }
    },
    "mandatory_governed_execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_id",
        "version",
        "stage_order",
        "required_observation_count",
        "missing_or_stale_result"
      ],
      "properties": {
        "protocol_id": {"const": "protocol:mandatory-governed-execution-phase1"},
        "version": {"const": "1.3.0"},
        "stage_order": {
          "const": [
            "exact-snapshot",
            "twelve-agent-observations",
            "agentic-policy-evaluation",
            "decision-evidence-assembly",
            "independent-second-pass-validation",
            "decision",
            "snapshot-bound-receipt",
            "review-audit",
            "current-receipt-publication",
            "same-snapshot-action-retry"
          ]
        },
        "required_observation_count": {"const": 12},
        "missing_or_stale_result": {"const": "BLOCKED_INCOMPLETE"}
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "authority",
        "severity_score_source",
        "per_agent_reduction",
        "weighted_score_algorithm",
        "weight_scale_micros",
        "weighted_score_rounding",
        "threshold_source",
        "threshold_percent_to_basis_points_multiplier",
        "compliance_score_formula",
        "reason_code_map",
        "completeness_requirements",
        "hard_fail"
      ],
      "properties": {
        "mode": {"const": "code-policy-application"},
        "authority": {"const": "agentic-advisory"},
        "severity_score_source": {
          "const": "finding_classification.severity_bands[].detector_score_basis_points"
        },
        "per_agent_reduction": {"const": "maximum-finding-score"},
        "weighted_score_algorithm": {"const": "normalized-weighted-mean"},
        "weight_scale_micros": {"const": 1000000},
        "weighted_score_rounding": {
          "const": "(weighted_sum + total_weight // 2) // total_weight"
        },
        "threshold_source": {"const": "thresholds.fail_score-and-warning_score"},
        "threshold_percent_to_basis_points_multiplier": {"const": 100},
        "compliance_score_formula": {
          "const": "max(0, compliance_baseline * 100 - weighted_risk_score_basis_points)"
        },
        "reason_code_map": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pass",
            "warning",
            "fail",
            "hard_fail",
            "security_critical_veto",
            "classification_incomplete"
          ],
          "properties": {
            "pass": {"const": "AGG_THRESHOLD_PASS"},
            "warning": {"const": "AGG_THRESHOLD_WARNING"},
            "fail": {"const": "AGG_THRESHOLD_FAIL"},
            "hard_fail": {"const": "AGG_HARD_FAIL"},
            "security_critical_veto": {"const": "AGG_SECURITY_CRITICAL_VETO"},
            "classification_incomplete": {
              "const": "AGG_FINDING_CLASSIFICATION_INVALID"
            }
          }
        },
        "completeness_requirements": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "observation_status",
            "observation_fields",
            "finding_fields",
            "on_missing_or_ambiguous"
          ],
          "properties": {
            "observation_status": {"const": "ok"},
            "observation_fields": {
              "const": [
                "component_binding",
                "agentic_evaluator",
                "snapshot_sha256",
                "invocation_id",
                "span_id"
              ]
            },
            "finding_fields": {
              "const": [
                "controls",
                "classification_basis",
                "severity",
                "source",
                "locations",
                "evidence_summary",
                "confidence",
                "hard_fail_binding"
              ]
            },
            "on_missing_or_ambiguous": {"const": "BLOCKED_INCOMPLETE"}
          }
        },
        "hard_fail": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "authority_source",
            "binding_required",
            "evidence_canonicalization",
            "evidence_fields",
            "evidence_encoding",
            "free_llm_severity_authoritative"
          ],
          "properties": {
            "authority_source": {
              "const": "hard_fail_authority-and-hard_fail_non_override"
            },
            "binding_required": {"const": "canonical-detector-policy-and-evidence"},
            "evidence_canonicalization": {
              "const": "kt-agentic-hard-fail-evidence-json-v1"
            },
            "evidence_fields": {
              "const": [
                "snapshot_sha256",
                "agent_id",
                "finding_id",
                "detector_id",
                "controls",
                "locations",
                "detector_pack_sha256",
                "policy_sha256"
              ]
            },
            "evidence_encoding": {"const": "sorted-minified-utf8-single-lf"},
            "free_llm_severity_authoritative": {"const": false}
          }
        }
      }
    },
    "evidence_bound_replay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audit_replay", "model_rerun", "second_pass_validation", "data_handling"],
      "properties": {
        "audit_replay": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requirement",
            "canonicalization",
            "required_bindings",
            "manifest_states",
            "stale_if_changed",
            "missing_or_mismatch_result",
            "digest_recipes"
          ],
          "properties": {
            "requirement": {"const": "mandatory"},
            "canonicalization": {"const": "kt-agentic-decision-evidence-json-v1"},
            "required_bindings": {
              "const": [
                "canonical-input",
                "exact-snapshot",
                "authority",
                "orchestration",
                "aggregation-policy",
                "agentic-evaluator",
                "mandatory-governed-execution-harness",
                "canonical-rule",
                "selected-client-skill",
                "twelve-agent-component-manifest",
                "client",
                "prompt-template",
                "redacted-prompt-envelope",
                "context-manifest",
                "retrieval-manifest",
                "tool-result-manifest",
                "primary-evaluation",
                "second-pass-validator"
              ]
            },
            "manifest_states": {"const": ["available", "not-used", "unavailable"]},
            "stale_if_changed": {
              "const": [
                "canonical-input",
                "exact-snapshot",
                "authority",
                "aggregation-policy",
                "agentic-evaluator",
                "harness",
                "rule",
                "skill",
                "agent-component-manifest",
                "client",
                "prompt-template",
                "prompt-envelope",
                "context-manifest",
                "retrieval-manifest",
                "tool-result-manifest"
              ]
            },
            "missing_or_mismatch_result": {"const": "BLOCKED_INCOMPLETE"},
            "digest_recipes": {
              "const": {
                "canonical_input": {
                  "canonicalization": "kt-agentic-review-input-manifest-json-v1",
                  "item_count": 1,
                  "sha256_source": "exact-snapshot.snapshot_sha256"
                },
                "prompt_envelope": {
                  "canonicalization": "kt-agentic-redacted-prompt-envelope-json-v1",
                  "version": "1.0.0",
                  "source": "exact-clean-prompt-ingress-receipt",
                  "payload_fields": [
                    "kind",
                    "version",
                    "source_event_id",
                    "source_prompt_turn_id",
                    "source_receipt_sha256",
                    "prompt_capture_sha256",
                    "raw_content_stored"
                  ],
                  "field_sources": {
                    "source_event_id": "PromptIngressReceipt.event_id",
                    "source_prompt_turn_id": "PromptIngressReceipt.prompt_turn_id",
                    "source_receipt_sha256": "sha256(exact-receipt-file-bytes)",
                    "prompt_capture_sha256": "PromptIngressReceipt.prompt_capture.sha256"
                  },
                  "encoding": "sorted-minified-utf8-single-lf"
                },
                "supplemental_manifests": {
                  "scope": "supplemental-context-retrieval-and-tool-results-only",
                  "governed_inputs_bound_elsewhere": true,
                  "verified_phase1_state": "not-used",
                  "empty_payload_fields": ["canonicalization", "items"],
                  "empty_items": [],
                  "encoding": "sorted-minified-utf8-single-lf",
                  "used_or_unobservable_result": "BLOCKED_INCOMPLETE"
                }
              }
            }
          }
        },
        "model_rerun": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requirement",
            "exact_output_guaranteed",
            "unknown_metadata",
            "optional_metadata_unavailable_blocks_audit_replay",
            "full_content_location"
          ],
          "properties": {
            "requirement": {"const": "best-effort"},
            "exact_output_guaranteed": {"const": false},
            "unknown_metadata": {"const": "explicit-unavailable-never-invent"},
            "optional_metadata_unavailable_blocks_audit_replay": {"const": false},
            "full_content_location": {"const": "future-controlled-time-bounded-evidence-vault-reference-only"}
          }
        },
        "second_pass_validation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method",
            "distinct_invocation_and_span",
            "checked_digest_set_required",
            "recalculated_outcome_required",
            "mechanical_provenance",
            "self_attestation_sufficient_for_external_independence",
            "external_independence_proven"
          ],
          "properties": {
            "method": {"const": "independent-second-pass-policy-recalculation"},
            "distinct_invocation_and_span": {"const": true},
            "checked_digest_set_required": {"const": true},
            "recalculated_outcome_required": {"const": true},
            "mechanical_provenance": {"const": "commit-guard-policy-recalculation"},
            "self_attestation_sufficient_for_external_independence": {"const": false},
            "external_independence_proven": {"const": false}
          }
        },
        "data_handling": {
          "type": "object",
          "additionalProperties": false,
          "required": ["general_audit_content", "full_content_reference"],
          "properties": {
            "general_audit_content": {"const": "digest-and-redacted-metadata-only"},
            "full_content_reference": {"const": "evidence-vault-reference-or-unavailable"}
          }
        }
      }
    },
    "native_gate_validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applicability",
        "success_condition",
        "failure_result",
        "required_failure_classes",
        "harness_boundary",
        "reuse_payload",
        "timestamp_provenance"
      ],
      "properties": {
        "applicability": {"const": "supported-native-direct-commit-retry"},
        "success_condition": {"const": "all-required-checks-completed"},
        "failure_result": {"const": "BLOCKED_INCOMPLETE"},
        "required_failure_classes": {
          "const": [
            "tool-unavailable",
            "permission-denied",
            "tool-error",
            "truncated-output",
            "unreadable-artifact",
            "parse-error",
            "schema-error",
            "canonicalization-error",
            "digest-mismatch",
            "snapshot-mismatch",
            "recalculation-mismatch",
            "stale-or-missing-evidence"
          ]
        },
        "harness_boundary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "installed_runtime_required",
            "agent_invocation",
            "semantic_decision",
            "finding_scoring",
            "evidence_creation_or_repair",
            "claim"
          ],
          "properties": {
            "mode": {"const": "dependency-free-evidence-integrity-command-hook"},
            "installed_runtime_required": {"const": true},
            "agent_invocation": {"const": false},
            "semantic_decision": {"const": false},
            "finding_scoring": {"const": false},
            "evidence_creation_or_repair": {"const": false},
            "claim": {"const": "conditional-native-guard"}
          }
        },
        "reuse_payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "canonicalization",
            "exact_full_object_required",
            "reduced_object_allowed"
          ],
          "properties": {
            "canonicalization": {"const": "kt-agentic-review-reuse-json-v3"},
            "exact_full_object_required": {"const": true},
            "reduced_object_allowed": {"const": false}
          }
        },
        "timestamp_provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "synthetic_values_allowed",
            "future_values_allowed",
            "chronology_required",
            "failure_result"
          ],
          "properties": {
            "source": {"const": "client-observed-utc-clock"},
            "synthetic_values_allowed": {"const": false},
            "future_values_allowed": {"const": false},
            "chronology_required": {"const": true},
            "failure_result": {"const": "BLOCKED_INCOMPLETE"}
          }
        }
      }
    },
    "finalization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "sequence",
        "exact_retry_behavior",
        "changed_retry_behavior",
        "audit_event_derivation",
        "user_confirmation_required",
        "new_agent_invocation",
        "performance_target_p95_ms",
        "performance_target_is_current_proof"
      ],
      "properties": {
        "command": {"const": "governance-client-finalize-review"},
        "sequence": {
          "const": [
            "reports-complete",
            "code-policy-application",
            "independent-policy-recalculation",
            "decision-evidence-assembly",
            "decision-and-receipt-write",
            "protected-audit-verification",
            "idempotent-protected-audit-append",
            "atomic-current-receipt-publication",
            "same-snapshot-commit-retry"
          ]
        },
        "exact_retry_behavior": {"const": "return-original-ack"},
        "changed_retry_behavior": {"const": "reject-record-exists"},
        "audit_event_derivation": {"const": "bound-artifact-publication-chronology"},
        "user_confirmation_required": {"const": false},
        "new_agent_invocation": {"const": false},
        "performance_target_p95_ms": {"const": 10000},
        "performance_target_is_current_proof": {"const": false}
      }
    },
    "claim_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deterministic",
        "canonical_conformance",
        "runtime_admission",
        "production_authority"
      ],
      "properties": {
        "deterministic": {"const": false},
        "canonical_conformance": {"const": false},
        "runtime_admission": {"const": false},
        "production_authority": {"const": false}
      }
    }
  }
}
