{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kt:agent-platform:governance-assessment-report:1.2",
  "title": "Yönetişim Değerlendirme Raporu",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "output_contract",
    "agent_id",
    "request_sha256",
    "input_snapshot_sha256",
    "lineage",
    "status",
    "findings",
    "scanned_files",
    "acceptance_criteria",
    "error_code",
    "error_summary",
    "report_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.2"},
    "kind": {"const": "GovernanceAssessmentReport"},
    "output_contract": {"const": "schema:governance-assessment-report-v1-2"},
    "agent_id": {"$ref": "#/$defs/agentRef"},
    "request_sha256": {"$ref": "#/$defs/sha256"},
    "input_snapshot_sha256": {"$ref": "#/$defs/sha256"},
    "lineage": {"$ref": "#/$defs/lineage"},
    "status": {"enum": ["ok", "failed", "timeout"]},
    "findings": {
      "type": "array",
      "maxItems": 128,
      "items": {"$ref": "#/$defs/finding"}
    },
    "scanned_files": {
      "type": "array",
      "maxItems": 4096,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/repositoryRelativePath"}
    },
    "acceptance_criteria": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/frozenAcceptanceCriteria"}
      ]
    },
    "error_code": {
      "type": ["string", "null"],
      "minLength": 3,
      "maxLength": 64,
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "error_summary": {
      "type": ["string", "null"],
      "minLength": 10,
      "maxLength": 300,
      "pattern": "^\\S(?:[^\\r\\n]*\\S)?$"
    },
    "report_sha256": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"agent_id": {"const": "agent:test-otomasyonu"}},
        "required": ["agent_id"]
      },
      "then": {"properties": {"acceptance_criteria": {"$ref": "#/$defs/frozenAcceptanceCriteria"}}},
      "else": {"properties": {"acceptance_criteria": {"type": "null"}}}
    },
    {
      "if": {"properties": {"status": {"const": "ok"}}},
      "then": {
        "properties": {
          "error_code": {"const": null},
          "error_summary": {"const": null}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "failed"}}},
      "then": {
        "properties": {
          "findings": {"maxItems": 0},
          "error_code": {"type": "string"},
          "error_summary": {"type": "string"}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "timeout"}}},
      "then": {
        "properties": {
          "findings": {"maxItems": 0},
          "error_code": {"const": null},
          "error_summary": {"const": null}
        }
      }
    }
  ],
  "$defs": {
    "repositoryRelativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "pattern": "^(?!/)(?![A-Za-z]:/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)[^/]+(?:/[^/]+)*$"
    },
    "agentRef": {
      "type": "string",
      "pattern": "^agent:[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "frozenAcceptanceCriteria": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criteria_id",
        "criteria_version",
        "path",
        "sha256",
        "lifecycle",
        "derived_from_application_code"
      ],
      "properties": {
        "criteria_id": {
          "type": "string",
          "pattern": "^criteria:[a-z][a-z0-9]*(?:[-.:][a-z0-9]+)*$"
        },
        "criteria_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "path": {"$ref": "#/$defs/repositoryRelativePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "lifecycle": {"const": "accepted-frozen"},
        "derived_from_application_code": {"const": false}
      }
    },
    "lineageId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[-.:][a-z0-9]+)*$"
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["standard_id", "control_id", "version"],
      "properties": {
        "standard_id": {
          "type": "string",
          "pattern": "^[A-Z0-9][A-Z0-9._/-]{1,63}$"
        },
        "control_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,95}$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+(?:\\.[0-9]+){1,3}$"
        }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "start_line", "end_line", "start_column", "end_column"],
      "properties": {
        "path": {
          "$ref": "#/$defs/repositoryRelativePath"
        },
        "start_line": {"type": "integer", "minimum": 1, "maximum": 10000000},
        "end_line": {"type": "integer", "minimum": 1, "maximum": 10000000},
        "start_column": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 100000
        },
        "end_column": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 100000
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "kind",
        "producer_id",
        "producer_version",
        "sha256",
        "deterministic"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "maxLength": 160,
          "pattern": "^evidence:[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
        },
        "kind": {
          "enum": [
            "auxiliary-validation",
            "deterministic-check",
            "policy-evaluation",
            "requirements-trace",
            "source-observation",
            "subagent-report",
            "test-result"
          ]
        },
        "producer_id": {
          "type": "string",
          "maxLength": 160,
          "pattern": "^(?:(?:agent|gate|tool|validator):[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*|detector:[a-z][a-z0-9]*(?:[./-][a-z0-9]+)*)$"
        },
        "producer_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "sha256": {"$ref": "#/$defs/sha256"},
        "deterministic": {"const": true}
      }
    },
    "childReportRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_id", "invocation_id", "request_sha256", "report_sha256"],
      "properties": {
        "agent_id": {"$ref": "#/$defs/agentRef"},
        "invocation_id": {
          "type": "string",
          "pattern": "^invocation:[a-z0-9]+(?:[-.:][a-z0-9]+)*$"
        },
        "request_sha256": {"$ref": "#/$defs/sha256"},
        "report_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "executionComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\r\\n]+$"
        },
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "clientComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_id", "version"],
      "properties": {
        "component_id": {
          "enum": ["claude-code", "codex", "cursor", "vscode", "copilot"]
        },
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
      }
    },
    "instructionBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "bundle_version",
        "instructions",
        "rules",
        "skills",
        "bundle_sha256"
      ],
      "properties": {
        "schema_version": {"const": "1.0"},
        "kind": {"const": "EffectiveInstructionBundle"},
        "bundle_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "instructions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {"$ref": "#/$defs/executionComponent"}
        },
        "rules": {
          "type": "array",
          "maxItems": 256,
          "items": {"$ref": "#/$defs/executionComponent"}
        },
        "skills": {
          "type": "array",
          "maxItems": 64,
          "items": {"$ref": "#/$defs/executionComponent"}
        },
        "bundle_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "executionComposition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "agent_id",
        "agent_version",
        "agent_identity_sha256",
        "contract",
        "projection",
        "registry_lock",
        "instruction_bundle",
        "policy_id",
        "policy_version",
        "policy",
        "provider",
        "resolved_model_id",
        "model_revision",
        "model_digest",
        "client_id",
        "client_version",
        "client_components",
        "evidence_scope",
        "production_runtime_proof",
        "composition_sha256"
      ],
      "properties": {
        "schema_version": {"const": "1.0"},
        "kind": {"const": "AgentExecutionComposition"},
        "agent_id": {"$ref": "#/$defs/agentRef"},
        "agent_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "agent_identity_sha256": {"$ref": "#/$defs/sha256"},
        "contract": {"$ref": "#/$defs/executionComponent"},
        "projection": {"$ref": "#/$defs/executionComponent"},
        "registry_lock": {"$ref": "#/$defs/executionComponent"},
        "instruction_bundle": {"$ref": "#/$defs/instructionBundle"},
        "policy_id": {
          "type": "string",
          "pattern": "^policy:[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "policy_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "policy": {"$ref": "#/$defs/executionComponent"},
        "provider": {
          "type": "string",
          "maxLength": 80,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "resolved_model_id": {
          "type": "string",
          "maxLength": 160,
          "pattern": "^[a-z][a-z0-9]*(?:[-.:/][a-z0-9]+)*$"
        },
        "model_revision": {
          "type": "string",
          "maxLength": 160,
          "pattern": "^[a-z0-9][a-z0-9]*(?:[-.:/][a-z0-9]+)*$"
        },
        "model_digest": {"$ref": "#/$defs/sha256"},
        "client_id": {
          "enum": ["codex", "claude-code", "github-copilot-vscode", "cursor"]
        },
        "client_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "client_components": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {"$ref": "#/$defs/clientComponent"}
        },
        "evidence_scope": {"const": "observer-supplied-local"},
        "production_runtime_proof": {"const": false},
        "composition_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "invocation_id",
        "trace_context",
        "parent_run_id",
        "delegation_depth",
        "agent_instance_id",
        "client_id",
        "agent_identity_sha256",
        "contract_sha256",
        "policy_sha256",
        "projection_sha256",
        "registry_lock_sha256",
        "execution_composition",
        "admission_id",
        "child_report_refs"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "pattern": "^run:[a-z0-9]+(?:[-.:][a-z0-9]+)*$"
        },
        "invocation_id": {
          "type": "string",
          "pattern": "^invocation:[a-z0-9]+(?:[-.:][a-z0-9]+)*$"
        },
        "trace_context": {"$ref": "#/$defs/w3cTraceContext"},
        "parent_run_id": {
          "type": ["string", "null"],
          "pattern": "^run:[a-z0-9]+(?:[-.:][a-z0-9]+)*$"
        },
        "delegation_depth": {"type": "integer", "minimum": 0, "maximum": 3},
        "agent_instance_id": {
          "type": "string",
          "pattern": "^agent-instance:[a-z0-9]+(?:[-.:][a-z0-9]+)*$"
        },
        "client_id": {
          "enum": ["codex", "claude-code", "github-copilot-vscode", "cursor"]
        },
        "agent_identity_sha256": {"$ref": "#/$defs/sha256"},
        "contract_sha256": {"$ref": "#/$defs/sha256"},
        "policy_sha256": {"$ref": "#/$defs/sha256"},
        "projection_sha256": {"$ref": "#/$defs/sha256"},
        "registry_lock_sha256": {"$ref": "#/$defs/sha256"},
        "execution_composition": {"$ref": "#/$defs/executionComposition"},
        "admission_id": {
          "type": ["string", "null"],
          "pattern": "^admission:[a-z0-9]+(?:[-.:][a-z0-9]+)*$"
        },
        "child_report_refs": {
          "type": "array",
          "maxItems": 16,
          "items": {"$ref": "#/$defs/childReportRef"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"delegation_depth": {"const": 0}}},
          "then": {"properties": {"parent_run_id": {"type": "null"}}},
          "else": {"properties": {"parent_run_id": {"type": "string"}}}
        }
      ]
    },
    "w3cTraceContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "trace_id", "span_id", "parent_span_id", "trace_flags"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "trace_id": {
          "type": "string",
          "pattern": "^(?!0{32}$)[0-9a-f]{32}$"
        },
        "span_id": {
          "type": "string",
          "pattern": "^(?!0{16}$)[0-9a-f]{16}$"
        },
        "parent_span_id": {
          "type": ["string", "null"],
          "pattern": "^(?!0{16}$)[0-9a-f]{16}$"
        },
        "trace_flags": {
          "type": "string",
          "pattern": "^[0-9a-f]{2}$"
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "title",
        "observation",
        "severity",
        "risk_score_basis_points",
        "confidence_basis_points",
        "controls",
        "locations",
        "evidence"
      ],
      "properties": {
        "finding_id": {
          "type": "string",
          "maxLength": 120,
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
        },
        "title": {"type": "string", "minLength": 8, "maxLength": 200},
        "observation": {"type": "string", "minLength": 10, "maxLength": 2000},
        "severity": {"enum": ["info", "low", "medium", "high", "critical"]},
        "risk_score_basis_points": {"type": "integer", "minimum": 0, "maximum": 10000},
        "confidence_basis_points": {"type": "integer", "minimum": 0, "maximum": 10000},
        "controls": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {"$ref": "#/$defs/control"}
        },
        "locations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {"$ref": "#/$defs/location"}
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {"$ref": "#/$defs/evidence"}
        }
      }
    }
  }
}
