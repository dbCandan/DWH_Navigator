{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kt:agent-platform:governance-run-evidence:1.0",
  "title": "Yönetişim Çalışma Kanıtı Demeti",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "run_id",
    "trace_id",
    "evidence_scope",
    "decision",
    "accepted_reports",
    "execution_compositions",
    "test_evidence",
    "sbom_evidence",
    "storage_scope",
    "immutable_audit_storage_proof",
    "production_runtime_proof",
    "bundle_sha256",
    "signature_status",
    "signature"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "kind": {"const": "GovernanceRunEvidenceBundle"},
    "run_id": {"$ref": "#/$defs/runId"},
    "trace_id": {"$ref": "#/$defs/traceId"},
    "evidence_scope": {"const": "local-content-addressed-run-evidence"},
    "decision": {"$ref": "#/$defs/decisionReference"},
    "accepted_reports": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/reportReference"}
    },
    "execution_compositions": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/compositionReference"}
    },
    "test_evidence": {"$ref": "#/$defs/testEvidence"},
    "sbom_evidence": {"$ref": "#/$defs/sbomEvidence"},
    "storage_scope": {"const": "caller-managed"},
    "immutable_audit_storage_proof": {"const": false},
    "production_runtime_proof": {"const": false},
    "bundle_sha256": {"$ref": "#/$defs/sha256"},
    "signature_status": {"enum": ["unsigned-local", "signed-unverified"]},
    "signature": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/signature"}
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"signature_status": {"const": "unsigned-local"}}},
      "then": {"properties": {"signature": {"type": "null"}}},
      "else": {"properties": {"signature": {"$ref": "#/$defs/signature"}}}
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "runId": {
      "type": "string",
      "pattern": "^run:[a-z0-9]+(?:[-.:][a-z0-9]+)*$"
    },
    "traceId": {
      "type": "string",
      "pattern": "^(?!0{32}$)[0-9a-f]{32}$"
    },
    "agentId": {
      "type": "string",
      "pattern": "^agent:[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "invocationId": {
      "type": "string",
      "pattern": "^invocation:[a-z0-9]+(?:[-.:][a-z0-9]+)*$"
    },
    "spanId": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_ref", "sha256", "media_type"],
      "properties": {
        "artifact_ref": {
          "type": "string",
          "maxLength": 300,
          "pattern": "^[a-z][a-z0-9]*(?:[-._:/][a-z0-9]+)*$"
        },
        "sha256": {"$ref": "#/$defs/sha256"},
        "media_type": {
          "type": "string",
          "maxLength": 120,
          "pattern": "^[a-z0-9][a-z0-9.+-]+/[a-z0-9][a-z0-9.+-]+$"
        }
      }
    },
    "reportArtifact": {
      "allOf": [
        {"$ref": "#/$defs/artifact"},
        {
          "properties": {
            "media_type": {
              "const": "application/vnd.kt.governance-assessment-report+json"
            }
          }
        }
      ]
    },
    "compositionArtifact": {
      "allOf": [
        {"$ref": "#/$defs/artifact"},
        {
          "properties": {
            "media_type": {
              "const": "application/vnd.kt.agent-execution-composition+json"
            }
          }
        }
      ]
    },
    "decisionArtifact": {
      "allOf": [
        {"$ref": "#/$defs/artifact"},
        {
          "properties": {
            "media_type": {
              "const": "application/vnd.kt.governed-review-decision+json"
            }
          }
        }
      ]
    },
    "reportReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_id", "invocation_id", "span_id", "report", "report_sha256"],
      "properties": {
        "agent_id": {"$ref": "#/$defs/agentId"},
        "invocation_id": {"$ref": "#/$defs/invocationId"},
        "span_id": {"$ref": "#/$defs/spanId"},
        "report": {"$ref": "#/$defs/reportArtifact"},
        "report_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "compositionReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_id",
        "invocation_id",
        "composition",
        "composition_sha256"
      ],
      "properties": {
        "agent_id": {"$ref": "#/$defs/agentId"},
        "invocation_id": {"$ref": "#/$defs/invocationId"},
        "composition": {"$ref": "#/$defs/compositionArtifact"},
        "composition_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "decisionReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision"],
      "properties": {
        "decision": {"$ref": "#/$defs/decisionArtifact"}
      }
    },
    "testEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applicability",
        "status",
        "artifact_format",
        "artifact",
        "source_run_id",
        "not_applicable_reason"
      ],
      "properties": {
        "applicability": {"enum": ["applicable", "not-applicable"]},
        "status": {"enum": ["executed", "reused", "failed", "not-applicable"]},
        "artifact_format": {
          "oneOf": [
            {"enum": ["junit-xml", "json", "text"]},
            {"type": "null"}
          ]
        },
        "artifact": {
          "oneOf": [
            {"$ref": "#/$defs/artifact"},
            {"type": "null"}
          ]
        },
        "source_run_id": {
          "oneOf": [
            {"$ref": "#/$defs/runId"},
            {"type": "null"}
          ]
        },
        "not_applicable_reason": {
          "oneOf": [
            {"enum": ["no-testable-change", "policy-exempt"]},
            {"type": "null"}
          ]
        }
      },
      "oneOf": [
        {
          "properties": {
            "applicability": {"const": "not-applicable"},
            "status": {"const": "not-applicable"},
            "artifact_format": {"type": "null"},
            "artifact": {"type": "null"},
            "source_run_id": {"type": "null"},
            "not_applicable_reason": {"enum": ["no-testable-change", "policy-exempt"]}
          }
        },
        {
          "properties": {
            "applicability": {"const": "applicable"},
            "status": {"const": "executed"},
            "artifact_format": {"enum": ["junit-xml", "json", "text"]},
            "artifact": {"$ref": "#/$defs/artifact"},
            "source_run_id": {"type": "null"},
            "not_applicable_reason": {"type": "null"}
          }
        },
        {
          "properties": {
            "applicability": {"const": "applicable"},
            "status": {"const": "reused"},
            "artifact_format": {"enum": ["junit-xml", "json", "text"]},
            "artifact": {"$ref": "#/$defs/artifact"},
            "source_run_id": {"$ref": "#/$defs/runId"},
            "not_applicable_reason": {"type": "null"}
          }
        },
        {
          "properties": {
            "applicability": {"const": "applicable"},
            "status": {"const": "failed"},
            "artifact_format": {"type": "null"},
            "artifact": {"type": "null"},
            "source_run_id": {"type": "null"},
            "not_applicable_reason": {"type": "null"}
          }
        },
        {
          "properties": {
            "applicability": {"const": "applicable"},
            "status": {"const": "failed"},
            "artifact_format": {"enum": ["junit-xml", "json", "text"]},
            "artifact": {"$ref": "#/$defs/artifact"},
            "source_run_id": {"type": "null"},
            "not_applicable_reason": {"type": "null"}
          }
        }
      ]
    },
    "sbomEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applicability",
        "status",
        "artifact_format",
        "artifact",
        "source_run_id",
        "not_applicable_reason"
      ],
      "properties": {
        "applicability": {"enum": ["applicable", "not-applicable"]},
        "status": {"enum": ["generated", "reused", "failed", "not-applicable"]},
        "artifact_format": {
          "oneOf": [
            {
              "enum": [
                "cyclonedx-json",
                "cyclonedx-xml",
                "spdx-json",
                "spdx-tag-value"
              ]
            },
            {"type": "null"}
          ]
        },
        "artifact": {
          "oneOf": [
            {"$ref": "#/$defs/artifact"},
            {"type": "null"}
          ]
        },
        "source_run_id": {
          "oneOf": [
            {"$ref": "#/$defs/runId"},
            {"type": "null"}
          ]
        },
        "not_applicable_reason": {
          "oneOf": [
            {
              "enum": [
                "no-build-artifact",
                "no-dependency-change",
                "policy-exempt"
              ]
            },
            {"type": "null"}
          ]
        }
      },
      "oneOf": [
        {
          "properties": {
            "applicability": {"const": "not-applicable"},
            "status": {"const": "not-applicable"},
            "artifact_format": {"type": "null"},
            "artifact": {"type": "null"},
            "source_run_id": {"type": "null"},
            "not_applicable_reason": {
              "enum": ["no-build-artifact", "no-dependency-change", "policy-exempt"]
            }
          }
        },
        {
          "properties": {
            "applicability": {"const": "applicable"},
            "status": {"const": "generated"},
            "artifact_format": {
              "enum": ["cyclonedx-json", "cyclonedx-xml", "spdx-json", "spdx-tag-value"]
            },
            "artifact": {"$ref": "#/$defs/artifact"},
            "source_run_id": {"type": "null"},
            "not_applicable_reason": {"type": "null"}
          }
        },
        {
          "properties": {
            "applicability": {"const": "applicable"},
            "status": {"const": "reused"},
            "artifact_format": {
              "enum": ["cyclonedx-json", "cyclonedx-xml", "spdx-json", "spdx-tag-value"]
            },
            "artifact": {"$ref": "#/$defs/artifact"},
            "source_run_id": {"$ref": "#/$defs/runId"},
            "not_applicable_reason": {"type": "null"}
          }
        },
        {
          "properties": {
            "applicability": {"const": "applicable"},
            "status": {"const": "failed"},
            "artifact_format": {"type": "null"},
            "artifact": {"type": "null"},
            "source_run_id": {"type": "null"},
            "not_applicable_reason": {"type": "null"}
          }
        },
        {
          "properties": {
            "applicability": {"const": "applicable"},
            "status": {"const": "failed"},
            "artifact_format": {
              "enum": ["cyclonedx-json", "cyclonedx-xml", "spdx-json", "spdx-tag-value"]
            },
            "artifact": {"$ref": "#/$defs/artifact"},
            "source_run_id": {"type": "null"},
            "not_applicable_reason": {"type": "null"}
          }
        }
      ]
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key_id", "algorithm", "value", "signed_bundle_sha256"],
      "properties": {
        "key_id": {
          "type": "string",
          "pattern": "^(?:key|kms|sigstore):[a-z][a-z0-9]*(?:[._/-][a-z0-9]+)*$"
        },
        "algorithm": {
          "enum": ["ed25519", "ecdsa-p256-sha256", "rsa-pss-sha256"]
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{16,4096}$"
        },
        "signed_bundle_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
